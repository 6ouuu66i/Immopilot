# Supabase - never commit real values
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Optional Google Maps key used by src/lib/maps.ts
VITE_GOOGLE_MAPS_PLATFORM_KEY=
