export default "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\n:root {\n  --forest: #1E5A3A;\n  --forest-soft: #CFE1D2;\n  --forest-tint: #ECF1E8;\n  --sand: #F4EFE5;\n  --sand-deep: #E3DED2;\n  --bone: #FBF9F4;\n  --ink: #1D1F1E;\n  --stone: #6B6F6D;\n  --stone-light: #8E8B83;\n  --moss: #7FA68E;\n  --rose: #C8553D;\n  --amber: #C8983D;\n  --blue: #4A7AA5;\n}\n\n/* ── INTERFACES BASE ── */\n.agenda-page {\n  display: flex;\n  flex-direction: column;\n  padding: 18px 22px 40px;\n  min-width: 0;\n  flex: 1;\n  height: 100%;\n  overflow-y: auto;\n  \n  background-color: #FBF9F4 !important; /* Premium warm paper sheet background */\n  background-image: \n    /* Soft red margin vertical line typical of high-quality notebooks */\n    linear-gradient(90deg, transparent 55px, rgba(200, 85, 61, 0.24) 55px, rgba(200, 85, 61, 0.24) 57px, transparent 57px),\n    /* Delicate forest-green grid lines to emphasize the sketched vibe */\n    linear-gradient(rgba(30, 90, 58, 0.08) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(30, 90, 58, 0.08) 1px, transparent 1px) !important;\n  background-size: 100% 100%, 20px 20px, 20px 20px !important;\n}\n\n.agenda-header {\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n  margin-bottom: 24px;\n}\n\n.agenda-header-top {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 14px;\n  width: 100%;\n}\n\n.agenda-title {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.agenda-title h1 {\n  font-family: 'Lora', Georgia, serif;\n  font-size: 24px;\n  font-weight: 700;\n  letter-spacing: -0.015em;\n  margin: 0;\n  color: var(--ink);\n}\n\n.agenda-title h1::before {\n  content: '';\n  display: inline-block;\n  width: 4px;\n  height: 18px;\n  background: var(--forest);\n  margin-right: 10px;\n  vertical-align: -2px;\n  border-radius: 99px;\n}\n\n.agenda-subtitle {\n  font-size: 13px;\n  color: var(--stone);\n  margin-left: 14px;\n}\n\n/* ── KPI DASHBOARD (SOBRE & MATCHING BIENS/DASHBOARD EXACT) ── */\n.kpi-dashboard {\n  display: flex;\n  align-items: center;\n  flex: 1 1 auto;\n  min-width: 0;\n  background: #FFFFFF;\n  border: 1.5px solid var(--stone);\n  border-radius: 255px 12px 240px 12px/12px 240px 12px 255px;\n  box-shadow: 2.2px 2.5px 0px var(--sand-deep);\n  padding: 12px 20px;\n  margin-bottom: 24px;\n}\n\n.kpi-item {\n  display: flex;\n  flex-direction: column;\n  flex: 1;\n  min-width: 0;\n}\n\n.kpi-item:last-child {\n  flex: 1.1;\n}\n\n.kpi-divider {\n  width: 1.5px;\n  height: 42px;\n  border-left: 1.5px dashed var(--sand-deep);\n  margin: 0 20px;\n}\n\n.kpi-title {\n  font-size: 11.5px;\n  color: var(--stone);\n  font-weight: 500;\n  margin-bottom: 6px;\n  font-family: 'JetBrains Mono', monospace;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n}\n\n.kpi-value {\n  font-size: 22px;\n  font-weight: 700;\n  color: var(--ink);\n  line-height: 1;\n  letter-spacing: -0.01em;\n}\n\n.kpi-trend {\n  display: flex;\n  align-items: center;\n  font-size: 11px;\n  font-weight: 500;\n  color: var(--stone-light);\n  margin-top: 5px;\n  gap: 4px;\n}\n\n.trend-urgent {\n  color: var(--rose);\n  font-weight: 600;\n}\n\n.trend-good {\n  color: var(--forest);\n  font-weight: 600;\n}\n\n/* ── AGENDA MAIN GRID ── */\n.agenda-grid {\n  display: grid;\n  grid-template-columns: minmax(0, 1.6fr) minmax(360px, 1fr);\n  gap: 22px;\n  align-items: start;\n}\n\n@media(max-width: 1024px) {\n  .agenda-grid {\n    grid-template-columns: 1fr;\n  }\n}\n\n/* ── ACTIONS BAR & FILTERS ── */\n.filter-card {\n  background: #FFFFFF;\n  border: 1.5px solid var(--stone);\n  border-radius: 12px;\n  box-shadow: 2px 2px 0px var(--sand-deep);\n  padding: 14px 18px;\n  margin-bottom: 18px;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.filter-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 12px;\n}\n\n.time-tabs {\n  display: inline-flex;\n  background: var(--bone);\n  border: 1.5px solid var(--stone);\n  border-radius: 180px 15px 150px 15px/15px 150px 15px 180px !important;\n  padding: 3px;\n  gap: 3px;\n}\n\n.time-tabs button {\n  background: transparent;\n  border: none;\n  padding: 6px 14px;\n  font: inherit;\n  font-size: 11.5px;\n  font-weight: 500;\n  color: var(--stone);\n  cursor: pointer;\n  border-radius: 99px;\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  transition: all 160ms ease;\n}\n\n.time-tabs button.active {\n  background: var(--forest);\n  color: #FFFFFF;\n  box-shadow: 1px 1.5px 0px rgba(0,0,0,0.15);\n  font-weight: 600;\n}\n\n.search-input-wrap {\n  position: relative;\n  width: 100%;\n  max-width: 240px;\n}\n\n.search-input {\n  width: 100%;\n  height: 32px;\n  padding: 0 12px 0 32px;\n  border: 1.5px solid var(--stone);\n  border-radius: 250px 15px 230px 15px/15px 230px 15px 250px;\n  font: inherit;\n  font-size: 12px;\n  outline: none;\n  background: #FFFFFF url('data:image/svg+xml;utf8,<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"%236B6F6D\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"/></svg>') 10px center no-repeat;\n  transition: all 140ms;\n}\n\n.search-input:focus {\n  border-color: var(--forest);\n  box-shadow: 1.5px 1.5px 0 var(--forest);\n}\n\n.type-filters {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n\n.type-pill {\n  background: var(--bone);\n  border: 1.2px solid var(--stone-light);\n  border-radius: 120px 20px 100px 20px/20px 100px 20px 120px !important;\n  padding: 4px 11px;\n  font-size: 11.5px;\n  font-weight: 500;\n  color: var(--stone);\n  cursor: pointer;\n  transition: all 150ms;\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.type-pill:hover {\n  border-color: var(--ink);\n  color: var(--ink);\n}\n\n.type-pill.active {\n  background: #FFFFFF;\n  color: var(--ink);\n  border-color: var(--forest);\n  box-shadow: 2px 2px 0px var(--forest);\n  font-weight: 600;\n}\n\n.type-pill.active[data-type=\"deal\"] { border-color: var(--blue); box-shadow: 2px 2px 0px var(--blue); }\n.type-pill.active[data-type=\"bien\"] { border-color: var(--forest); box-shadow: 2px 2px 0px var(--forest); }\n.type-pill.active[data-type=\"contact\"] { border-color: var(--amber); box-shadow: 2px 2px 0px var(--amber); }\n.type-pill.active[data-type=\"perso\"] { border-color: var(--stone); box-shadow: 2px 2px 0px var(--stone); }\n\n/* ── TASK LIST ── */\n.tasks-container {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.task-group-title {\n  font-family: 'JetBrains Mono', monospace;\n  font-size: 11px;\n  font-weight: 600;\n  text-transform: uppercase;\n  color: var(--stone);\n  letter-spacing: 0.05em;\n  margin: 14px 0 4px 4px;\n}\n\n.task-card {\n  background: #FFFFFF;\n  border: 1.5px solid var(--stone);\n  border-radius: 12px 255px 12px 240px/10px 12px 10px 12px;\n  box-shadow: 2.2px 2.2px 0px var(--sand-deep);\n  padding: 14px 16px;\n  display: flex;\n  gap: 14px;\n  align-items: flex-start;\n  transition: all 180ms ease;\n  position: relative;\n  cursor: pointer;\n}\n\n.task-card:hover {\n  transform: translateY(-1.5px) rotate(-0.1deg);\n  border-color: var(--forest);\n  box-shadow: 3.5px 4px 0px var(--forest-soft);\n}\n\n.task-card.selected-active {\n  border-color: var(--forest);\n  box-shadow: 4px 4.5px 0px var(--forest);\n  background: var(--forest-tint);\n}\n\n.task-checkbox-wrapper {\n  padding-top: 2px;\n}\n\n.task-checkbox {\n  appearance: none;\n  width: 18px;\n  height: 18px;\n  border: 1.5px solid var(--stone);\n  border-radius: 4px;\n  background: #FFFFFF;\n  cursor: pointer;\n  display: grid;\n  place-items: center;\n  transition: all 120ms;\n}\n\n.task-checkbox:checked {\n  background: var(--forest);\n  border-color: var(--forest);\n}\n\n.task-checkbox:checked::after {\n  content: '';\n  width: 9px;\n  height: 5px;\n  border-left: 2px solid #FFFFFF;\n  border-bottom: 2px solid #FFFFFF;\n  transform: rotate(-45deg) translate(1px, -1px);\n}\n\n.task-content {\n  flex: 1;\n  min-width: 0;\n}\n\n.task-header-row {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 10px;\n}\n\n.task-title {\n  font-size: 13.5px;\n  font-weight: 600;\n  color: var(--ink);\n  line-height: 1.35;\n  margin-bottom: 6px;\n  transition: all 140ms;\n}\n\n.task-card.completed .task-title {\n  text-decoration: line-through;\n  color: var(--stone-light);\n}\n\n.task-badge-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  flex-wrap: wrap;\n  margin-top: 6px;\n}\n\n/* Entity labels */\n.badge-rel {\n  font-size: 10.5px;\n  font-weight: 500;\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  color: var(--stone);\n  background: var(--bone);\n  border: 1px solid var(--sand-deep);\n  padding: 1px 7px;\n  border-radius: 4px;\n}\n\n.badge-rel svg {\n  stroke-width: 2px;\n}\n\n.badge-rel span {\n  font-weight: 600;\n  color: var(--ink);\n}\n\n/* Priority tags */\n.priority-tag {\n  font-family: 'JetBrains Mono', monospace;\n  font-size: 9.5px;\n  font-weight: 600;\n  text-transform: uppercase;\n  padding: 1px 6px;\n  border-radius: 3px;\n}\n\n.priority-tag.urgent {\n  background: #FFF0ED;\n  color: var(--rose);\n  border: 1px solid rgba(200, 85, 61, 0.25);\n}\n\n.priority-tag.normal {\n  background: #FFF9ED;\n  color: var(--amber);\n  border: 1px solid rgba(200, 152, 61, 0.25);\n}\n\n.priority-tag.faible {\n  background: #EDF3FC;\n  color: var(--blue);\n  border: 1px solid rgba(74, 122, 165, 0.25);\n}\n\n.time-tag {\n  font-size: 11px;\n  color: var(--stone);\n  font-weight: 500;\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n}\n\n.time-tag.overdue {\n  color: var(--rose);\n  font-weight: 700;\n}\n\n.time-tag.today {\n  color: var(--forest);\n  font-weight: 600;\n}\n\n/* ── CALENDAR & QUICK FORM COLUMN (RIGHT) ── */\n.aside-column {\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n}\n\n.calendar-card {\n  background: #FFFFFF;\n  border: 1.5px solid var(--stone);\n  border-radius: 12px;\n  box-shadow: 2.2px 2.5px 0px var(--sand-deep);\n  padding: 18px;\n}\n\n.cal-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 12px;\n  padding: 0 4px;\n}\n\n.cal-month-title {\n  font-family: 'Lora', Georgia, serif;\n  font-size: 15px;\n  font-weight: 700;\n  color: var(--ink);\n}\n\n.cal-arrows {\n  display: flex;\n  gap: 4px;\n}\n\n.cal-arrow-btn {\n  width: 28px;\n  height: 28px;\n  border: 1.2px solid var(--stone);\n  border-radius: 6px;\n  background: #FFFFFF;\n  cursor: pointer;\n  display: grid;\n  place-items: center;\n  color: var(--ink);\n  transition: all 120ms;\n}\n\n.cal-arrow-btn:hover {\n  background: var(--bone);\n  border-color: var(--forest);\n}\n\n.cal-weekdays {\n  display: grid;\n  grid-template-columns: repeat(7, 1fr);\n  text-align: center;\n  font-family: 'JetBrains Mono', monospace;\n  font-size: 10px;\n  text-transform: uppercase;\n  color: var(--stone-light);\n  margin-bottom: 8px;\n  font-weight: 600;\n}\n\n.cal-grid {\n  display: grid;\n  grid-template-columns: repeat(7, 1fr);\n  gap: 6px;\n}\n\n.cal-day {\n  aspect-ratio: 1;\n  background: #FFFFFF;\n  border: 1px solid var(--sand);\n  border-radius: 8px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  font-size: 12px;\n  color: var(--ink);\n  cursor: pointer;\n  position: relative;\n  transition: all 130ms ease;\n  padding: 4px;\n}\n\n.cal-day:hover {\n  background: var(--bone);\n  border-color: var(--sand-deep);\n  transform: translateY(-1px);\n  box-shadow: 1.5px 2px 0px var(--sand-deep);\n}\n\n.cal-day.muted {\n  color: var(--stone-light);\n  opacity: 0.35;\n  background: var(--bone);\n}\n\n/* Day number helper element inside */\n.cal-day-num {\n  font-family: 'JetBrains Mono', monospace;\n  font-size: 11px;\n  font-weight: 600;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 22px;\n  height: 22px;\n  border-radius: 999px;\n  color: var(--stone);\n  transition: all 120ms;\n}\n\n.cal-day.active {\n  z-index: 2;\n  border-color: var(--forest);\n  box-shadow: 2px 2px 0px var(--forest-soft);\n}\n\n/* Circled active day effect for numeric label */\n.cal-day.active .cal-day-num {\n  background: var(--forest);\n  color: #FFFFFF;\n  font-weight: 700;\n}\n\n/* Dots container */\n.cal-day-dots {\n  display: flex;\n  justify-content: center;\n  gap: 3px;\n  margin-top: 4px;\n  height: 6px;\n  width: 100%;\n}\n\n.cal-dot {\n  width: 5px;\n  height: 5px;\n  border-radius: 999px;\n  display: inline-block;\n}\n\n.cal-dot.deal { background: var(--blue); }\n.cal-dot.bien { background: var(--forest); }\n.cal-dot.contact { background: var(--amber); }\n.cal-dot.perso { background: var(--stone); }\n.cal-dot.completed { opacity: 0.45; }\n\n/* ── CALENDAR TOOLTIP ── */\n.cal-tooltip {\n  position: absolute;\n  bottom: calc(100% + 8px);\n  left: 50%;\n  transform: translateX(-50%) translateY(4px);\n  background: #FFFFFF;\n  border: 1.5px solid var(--stone);\n  border-radius: 10px;\n  box-shadow: 2.5px 3px 0px var(--sand-deep);\n  padding: 10px 12px;\n  width: 230px;\n  max-width: 280px;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  z-index: 100;\n  opacity: 0;\n  visibility: hidden;\n  pointer-events: none;\n  transition: opacity 120ms ease, transform 120ms ease, visibility 120ms;\n}\n\n/* Little speech-bubble indicator arrow */\n.cal-tooltip::after {\n  content: '';\n  position: absolute;\n  top: 100%;\n  left: 50%;\n  transform: translateX(-50%);\n  border-width: 6px;\n  border-style: solid;\n  border-color: var(--stone) transparent transparent transparent;\n}\n\n/* On hover, reveal the tooltip cleanly */\n.cal-day:hover {\n  z-index: 10;\n}\n\n.cal-day:hover .cal-tooltip {\n  opacity: 1;\n  visibility: visible;\n  transform: translateX(-50%) translateY(0);\n}\n\n.tooltip-title {\n  font-family: 'JetBrains Mono', monospace;\n  font-size: 9.5px;\n  text-transform: uppercase;\n  color: var(--stone-light);\n  border-bottom: 1px dotted var(--sand-deep);\n  padding-bottom: 4px;\n  margin-bottom: 2px;\n  font-weight: 600;\n  text-align: left;\n}\n\n.tooltip-tasks {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n}\n\n.tooltip-task-item {\n  display: flex;\n  align-items: flex-start;\n  gap: 6px;\n  font-size: 10.5px;\n  line-height: 1.25;\n}\n\n.tooltip-task-dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 999px;\n  margin-top: 4px;\n  flex-shrink: 0;\n}\n\n.tooltip-task-dot.deal { background: var(--blue); }\n.tooltip-task-dot.bien { background: var(--forest); }\n.tooltip-task-dot.contact { background: var(--amber); }\n.tooltip-task-dot.perso { background: var(--stone); }\n\n.tooltip-task-text {\n  flex: 1;\n  color: var(--ink);\n  white-space: normal;\n  word-break: break-word;\n  text-align: left;\n}\n\n.tooltip-task-item.completed .tooltip-task-text {\n  text-decoration: line-through;\n  color: var(--stone-light);\n  opacity: 0.6;\n}\n\n.tooltip-task-time {\n  font-family: 'JetBrains Mono', monospace;\n  font-size: 9px;\n  color: var(--stone-light);\n  flex-shrink: 0;\n}\n\n/* ── QUICK ADD FORM ── */\n.form-card {\n  background: #FFFFFF;\n  border: 1.5px solid var(--stone);\n  border-radius: 12px;\n  box-shadow: 2.2px 2.5px 0px var(--sand-deep);\n  padding: 16px 18px;\n}\n\n.form-title {\n  font-family: 'Lora', Georgia, serif;\n  font-size: 15px;\n  font-weight: 700;\n  color: var(--ink);\n  margin-bottom: 12px;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.form-title svg {\n  color: var(--forest);\n}\n\n.form-row {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n  margin-bottom: 12px;\n}\n\n.form-label {\n  font-family: 'JetBrains Mono', monospace;\n  font-size: 10px;\n  text-transform: uppercase;\n  font-weight: 600;\n  color: var(--stone);\n  letter-spacing: 0.03em;\n}\n\n.form-input, .form-select {\n  height: 34px;\n  padding: 0 10px;\n  border: 1.5px solid var(--stone);\n  border-radius: 6px;\n  font: inherit;\n  font-size: 12.5px;\n  outline: none;\n  background: #FFFFFF;\n  color: var(--ink);\n  transition: all 140ms;\n}\n\n.form-input:focus, .form-select:focus {\n  border-color: var(--forest);\n  box-shadow: 1px 1.5px 0 var(--forest);\n}\n\n.form-radio-group {\n  display: flex;\n  gap: 6px;\n}\n\n.form-radio-btn {\n  flex: 1;\n  text-align: center;\n}\n\n.form-radio-btn input {\n  display: none;\n}\n\n.form-radio-label {\n  display: block;\n  padding: 6px 0;\n  border: 1.5px solid var(--stone);\n  border-radius: 6px;\n  font-size: 11px;\n  font-weight: 600;\n  cursor: pointer;\n  background: #FFFFFF;\n  transition: all 140ms;\n}\n\n.form-radio-btn input:checked + .form-radio-label {\n  background: var(--forest-tint);\n  border-color: var(--forest);\n  color: var(--forest);\n  box-shadow: 1px 1.5px 0 var(--forest);\n}\n\n.btn-submit {\n  width: 100%;\n  height: 38px;\n  border: 1.5px solid var(--stone);\n  border-radius: 120px 20px 100px 20px/20px 100px 20px 120px !important;\n  box-shadow: 1.5px 1.5px 0px var(--stone);\n  background: var(--forest);\n  color: #FFFFFF;\n  font-weight: 600;\n  font-size: 12.5px;\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  transition: all 140ms;\n  margin-top: 6px;\n}\n\n.btn-submit:hover {\n  background: #174A2F;\n  box-shadow: 2px 2px 0px var(--forest);\n}\n\n/* ── ACTION DETAIL SIDEBAR (DRAWER SENS PREVIEW EN MODE MOCK) ── */\n.detail-overlay {\n  position: fixed;\n  top: 0; left: 0; right: 0; bottom: 0;\n  background: rgba(29,31,30,0.4);\n  z-index: 1000;\n  display: none;\n  align-items: center;\n  justify-content: center;\n  padding: 20px;\n}\n\n.detail-drawer {\n  background: #FFFFFF;\n  border: 1.8px solid var(--stone);\n  border-radius: 16px;\n  width: 100%;\n  max-width: 480px;\n  box-shadow: 4px 5px 0px var(--stone);\n  padding: 24px;\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n\n.detail-close {\n  position: absolute;\n  top: 16px; right: 16px;\n  background: transparent;\n  border: none;\n  width: 26px; height: 26px;\n  border-radius: 6px;\n  cursor: pointer;\n  display: grid;\n  place-items: center;\n  color: var(--stone);\n  transition: all 120ms;\n}\n\n.detail-close:hover {\n  background: var(--bone);\n  color: var(--ink);\n}\n\n.detail-header {\n  border-bottom: 1.5px dashed var(--sand-deep);\n  padding-bottom: 14px;\n}\n\n.detail-category {\n  font-family: 'JetBrains Mono', monospace;\n  font-size: 10.5px;\n  text-transform: uppercase;\n  color: var(--stone);\n  font-weight: 600;\n  margin-bottom: 6px;\n}\n\n.detail-title {\n  font-family: 'Lora', Georgia, serif;\n  font-size: 18px;\n  font-weight: 700;\n  color: var(--ink);\n  line-height: 1.35;\n}\n\n.detail-info-grid {\n  display: grid;\n  grid-template-columns: 100px 1fr;\n  row-gap: 12px;\n  font-size: 12.5px;\n}\n\n.dig-label {\n  font-family: 'JetBrains Mono', monospace;\n  font-size: 10.5px;\n  color: var(--stone-light);\n  text-transform: uppercase;\n  align-self: center;\n}\n\n.dig-val {\n  color: var(--ink);\n  font-weight: 500;\n}\n\n.detail-entity-preview {\n  background: var(--bone);\n  border: 1.5px solid var(--stone);\n  border-radius: 8px;\n  padding: 12px;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.dep-img {\n  width: 50px;\n  height: 50px;\n  border-radius: 6px;\n  overflow: hidden;\n  background: var(--sand-deep);\n  border: 1px solid var(--stone);\n}\n\n.dep-img img {\n  width: 100%; height: 100%; object-fit: cover;\n}\n\n.dep-meta {\n  flex: 1;\n  min-width: 0;\n}\n\n.dep-title {\n  font-size: 12px;\n  font-weight: 600;\n  color: var(--ink);\n}\n\n.dep-sub {\n  font-size: 11px;\n  color: var(--stone);\n}\n\n.drawer-actions {\n  display: grid;\n  grid-template-columns: 1fr 120px;\n  gap: 10px;\n  margin-top: 10px;\n}\n\n.btn-open-fiche {\n  height: 38px;\n  background: var(--forest);\n  color: #FFFFFF;\n  border: 1.5px solid var(--forest);\n  border-radius: 8px;\n  font-weight: 600;\n  font-size: 12px;\n  cursor: pointer;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  transition: all 140ms;\n}\n\n.btn-open-fiche:hover {\n  background: #174A2F;\n}\n\n.btn-delete-task {\n  height: 38px;\n  background: #FFFFFF;\n  color: var(--rose);\n  border: 1.5px solid var(--rose);\n  border-radius: 8px;\n  font-weight: 600;\n  font-size: 12px;\n  cursor: pointer;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  transition: all 140ms;\n}\n\n.btn-delete-task:hover {\n  background: #FFF5F2;\n}\n\n/* Empty task list state design matching beautiful clipboard sketch */\n.empty-tasks-box {\n  background: #FFFFFF;\n  border: 1.5px dashed var(--stone);\n  border-radius: 12px;\n  padding: 40px 20px;\n  text-align: center;\n}\n</style>\n</head>\n<body>\n\n<div class=\"agenda-page\">\n  <!-- HEADER -->\n  <header class=\"agenda-header\">\n    <div class=\"agenda-header-top\">\n      <div class=\"agenda-title\">\n        <h1>Agenda de l'Agent</h1>\n        <div class=\"agenda-subtitle\">Cockpit opérationnel : gérez vos tâches, rendez-vous et relances commerciales.</div>\n      </div>\n    </div>\n  </header>\n\n  <!-- KPI DASHBOARD (SOBRE & MATCHING) -->\n  <div class=\"kpi-dashboard\">\n    <div class=\"kpi-item\">\n      <div class=\"kpi-title\">Actions aujourd'hui</div>\n      <div class=\"kpi-value\" id=\"kpi-today\">0</div>\n      <div class=\"kpi-trend\">\n        <span class=\"trend-urgent\" id=\"kpi-today-urgent\">0 urgentes</span>\n      </div>\n    </div>\n    <div class=\"kpi-divider\"></div>\n    <div class=\"kpi-item\">\n      <div class=\"kpi-title\">Actions terminées</div>\n      <div class=\"kpi-value\" id=\"kpi-done\">0</div>\n      <div class=\"kpi-trend\">\n        <span class=\"trend-good\" id=\"kpi-completion-label\">0% de complétion</span>\n      </div>\n    </div>\n    <div class=\"kpi-divider\"></div>\n    <div class=\"kpi-item\">\n      <div class=\"kpi-title\">En retard (Overdue)</div>\n      <div class=\"kpi-value\" id=\"kpi-overdue\" style=\"color: var(--rose);\">0</div>\n      <div class=\"kpi-trend\" style=\"color: var(--rose);\">\n        <span id=\"kpi-overdue-caption\">Attention requise</span>\n      </div>\n    </div>\n    <div class=\"kpi-divider\"></div>\n    <div class=\"kpi-item\">\n      <div class=\"kpi-title\">Focus Relances</div>\n      <div class=\"kpi-value\" id=\"kpi-linked\">0</div>\n      <div class=\"kpi-trend\">\n        <span>Tâches liées à des fiches</span>\n      </div>\n    </div>\n  </div>\n\n  <!-- MAIN AGENDAL FRAMEWORK -->\n  <div class=\"agenda-grid\">\n    \n    <!-- LEFT COLUMN: TASK BOARD -->\n    <div class=\"main-column\">\n      \n      <!-- CONTROLS -->\n      <div class=\"filter-card\">\n        <div class=\"filter-row\">\n          <div class=\"time-tabs\" id=\"time-tabs\">\n            <button class=\"active\" data-range=\"today\">Aujourd'hui</button>\n            <button data-range=\"week\">Cette semaine</button>\n            <button data-range=\"month\">Ce mois-ci</button>\n            <button data-range=\"all\">Toutes</button>\n          </div>\n          \n          <div class=\"search-input-wrap\">\n            <input type=\"text\" class=\"search-input\" id=\"search-tasks\" placeholder=\"Rechercher une action...\">\n          </div>\n        </div>\n        \n        <div class=\"type-filters\" id=\"type-filters\">\n          <button class=\"type-pill active\" data-type=\"all\">Toutes</button>\n          <button class=\"type-pill\" data-type=\"deal\" style=\"--col: var(--blue);\">📂 Deals</button>\n          <button class=\"type-pill\" data-type=\"bien\" style=\"--col: var(--forest);\">🏡 Biens</button>\n          <button class=\"type-pill\" data-type=\"contact\" style=\"--col: var(--amber);\">👤 Contacts</button>\n          <button class=\"type-pill\" data-type=\"perso\" style=\"--col: var(--stone);\">📝 Personnelles</button>\n        </div>\n      </div>\n\n      <!-- TASK LIST DYNAMIC CONTAINER -->\n      <div id=\"tasks-list-root\"></div>\n    </div>\n\n    <!-- RIGHT COLUMN: CALENDAR & FORM -->\n    <div class=\"aside-column\">\n      \n      <!-- MONTHLY CALENDAR CARD -->\n      <div class=\"calendar-card\">\n        <div class=\"cal-header\">\n          <span class=\"cal-month-title\">Mai 2026</span>\n          <div class=\"cal-arrows\">\n            <button class=\"cal-arrow-btn\" onclick=\"alert('Mois précédent : Simulation limitée au mois de Mai 2026')\">\n              <svg width=\"11\" height=\"11\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><polyline points=\"15 18 9 12 15 6\"/></svg>\n            </button>\n            <button class=\"cal-arrow-btn\" onclick=\"alert('Mois suivant : Simulation limitée au mois de Mai 2026')\">\n              <svg width=\"11\" height=\"11\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><polyline points=\"9 18 15 12 9 6\"/></svg>\n            </button>\n          </div>\n        </div>\n        \n        <div class=\"cal-weekdays\">\n          <div>Lu</div><div>Ma</div><div>Me</div><div>Je</div><div>Ve</div><div>Sa</div><div>Di</div>\n        </div>\n        \n        <div class=\"cal-grid\" id=\"calendar-grid-root\">\n          <!-- Calendar Days generated dynamically -->\n        </div>\n      </div>\n\n      <!-- TASK PLANNIFICATION CARD -->\n      <div class=\"form-card\">\n        <div class=\"form-title\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"/><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"/></svg>\n          Planifier une Action\n        </div>\n        \n        <form id=\"action-creation-form\" onsubmit=\"event.preventDefault(); addNewTask();\">\n          <div class=\"form-row\">\n            <span class=\"form-label\">Titre de l'action / relance</span>\n            <input type=\"text\" class=\"form-input\" id=\"task-title-input\" placeholder=\"Ex: Envoyer proposition d'achat...\" required>\n          </div>\n          \n          <div class=\"form-row\">\n            <span class=\"form-label\">Associer à une entité</span>\n            <select class=\"form-select\" id=\"task-assoc-input\">\n              <option value=\"perso\">📝 Action personnelle (aucune)</option>\n              <option value=\"deal-penthouse\">📂 Deal : Penthouse vue parc (Uccle)</option>\n              <option value=\"deal-triplex\">📂 Deal : Triplex art-déco (Ixelles)</option>\n              <option value=\"bien-lasne\">🏡 Bien : Villa basse énergie (FSBO - Lasne)</option>\n              <option value=\"bien-maitre\">🏡 Bien : Maison de maître (Saint-Gilles)</option>\n              <option value=\"contact-dupont\">👤 Contact : Jean Dupont</option>\n            </select>\n          </div>\n\n          <div class=\"form-row\" style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px;\">\n            <div>\n              <span class=\"form-label\">Échéance (Jour)</span>\n              <select class=\"form-select\" id=\"task-day-input\">\n                <option value=\"23\">Aujourd'hui (23 Mai)</option>\n                <option value=\"24\">Demain (24 Mai)</option>\n                <option value=\"25\">Lundi 25 Mai</option>\n                <option value=\"28\">Jeudi 28 Mai</option>\n              </select>\n            </div>\n            <div>\n              <span class=\"form-label\">Heure</span>\n              <input type=\"text\" class=\"form-input\" id=\"task-time-input\" placeholder=\"Ex: 14:30\" value=\"10:00\">\n            </div>\n          </div>\n\n          <div class=\"form-row\">\n            <span class=\"form-label\">Priorité</span>\n            <div class=\"form-radio-group\">\n              <div class=\"form-radio-btn\">\n                <input type=\"radio\" name=\"priority\" id=\"prio-low\" value=\"faible\">\n                <label for=\"prio-low\" class=\"form-radio-label\">Faible</label>\n              </div>\n              <div class=\"form-radio-btn\">\n                <input type=\"radio\" name=\"priority\" id=\"prio-normal\" value=\"normal\" checked>\n                <label for=\"prio-normal\" class=\"form-radio-label\">Normal</label>\n              </div>\n              <div class=\"form-radio-btn\">\n                <input type=\"radio\" name=\"priority\" id=\"prio-urgent\" value=\"urgent\">\n                <label for=\"prio-urgent\" class=\"form-radio-label\">Urgent</label>\n              </div>\n            </div>\n          </div>\n\n          <button type=\"submit\" class=\"btn-submit\">\n            <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"/><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"/></svg>\n            Planifier l'action\n          </button>\n        </form>\n      </div>\n\n    </div>\n\n  </div>\n</div>\n\n<!-- ACTION DRAWER/MODAL DETAIL -->\n<div class=\"detail-overlay\" id=\"detail-overlay\" onclick=\"closeDrawer()\">\n  <div class=\"detail-drawer\" onclick=\"event.stopPropagation()\">\n    <button class=\"detail-close\" onclick=\"closeDrawer()\">\n      <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"/><line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"/></svg>\n    </button>\n    \n    <div class=\"detail-header\">\n      <div id=\"detail-category\" class=\"detail-category\">📂 Catégorie</div>\n      <div id=\"detail-title\" class=\"detail-title\">Rappeler le vendeur pour un mandat exclusif</div>\n    </div>\n    \n    <div class=\"detail-info-grid\">\n      <div class=\"dig-label\">Priorité :</div>\n      <div class=\"dig-val\" id=\"detail-priority\">-</div>\n      \n      <div class=\"dig-label\">Date :</div>\n      <div class=\"dig-val\" id=\"detail-date\">-</div>\n      \n      <div class=\"dig-label\">Statut :</div>\n      <div class=\"dig-val\" id=\"detail-status\">-</div>\n    </div>\n\n    <!-- PREVIEW BOX -->\n    <div id=\"detail-entity-preview\" class=\"detail-entity-preview\" style=\"display: none;\">\n      <div class=\"dep-img\" id=\"detail-preview-img-wrap\">\n        <img id=\"detail-preview-img\" src=\"\" alt=\"Element\">\n      </div>\n      <div class=\"dep-meta\">\n        <div id=\"detail-preview-title\" class=\"dep-title\">Villa de luxe basse énergie</div>\n        <div id=\"detail-preview-desc\" class=\"dep-sub\">Lasne, Belgique</div>\n      </div>\n    </div>\n    \n    <div class=\"drawer-actions\">\n      <button class=\"btn-open-fiche\" onclick=\"goToLink()\">\n        <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/><polyline points=\"15 3 21 3 21 9\"/><line x1=\"10\" y1=\"14\" x2=\"21\" y2=\"3\"/></svg>\n        Ouvrir la fiche liée\n      </button>\n      <button class=\"btn-delete-task\" onclick=\"deleteCurrentTask()\">\n        Supprimer\n      </button>\n    </div>\n  </div>\n</div>\n\n<!-- INTERACTIVE SCRIPT -->\n<script>\n(function() {\n  // Preinitialized tasks list in localStorage or defaults\n  var DEFAULT_TASKS = [\n    {\n      id: \"task-1\",\n      title: \"Rappeler le vendeur pour fixer le prix définitif\",\n      type: \"deal\",\n      entityKey: \"deal-penthouse\",\n      entityName: \"Penthouse vue de parc (Uccle)\",\n      entityDesc: \"Lucas Martin • Budget 1.250.000 €\",\n      priority: \"urgent\",\n      day: 23,\n      time: \"10:30\",\n      completed: false,\n      photoSeed: 2\n    },\n    {\n      id: \"task-2\",\n      title: \"Contacter propriétaire FSBO sur Immoweb\",\n      type: \"bien\",\n      entityKey: \"bien-maitre\",\n      entityName: \"Maison de maître (Saint-Gilles)\",\n      entityDesc: \"Prospection FSBO • À vendre 1.080.000 €\",\n      priority: \"urgent\",\n      day: 23,\n      time: \"14:00\",\n      completed: false,\n      photoSeed: 1\n    },\n    {\n      id: \"task-3\",\n      title: \"Vérifier les diagnostics PEB & dossier amiante\",\n      type: \"bien\",\n      entityKey: \"bien-lasne\",\n      entityName: \"La Villa basse énergie (Lasne)\",\n      entityDesc: \"Julie Bernard • En attente de documents\",\n      priority: \"normal\",\n      day: 21, // Overdue task\n      time: \"09:00\",\n      completed: false,\n      photoSeed: 4\n    },\n    {\n      id: \"task-4\",\n      title: \"Préparer l'Avis de Valeur / ACM comparative\",\n      type: \"deal\",\n      entityKey: \"deal-triplex\",\n      entityName: \"Triplex art-déco (Ixelles)\",\n      entityDesc: \"Adam Dubois • Estimation souhaitée\",\n      priority: \"normal\",\n      day: 24,\n      time: \"11:15\",\n      completed: false,\n      photoSeed: 3\n    },\n    {\n      id: \"task-5\",\n      title: \"Envoyer le mandat d'exclusivité par email\",\n      type: \"contact\",\n      entityKey: \"contact-dupont\",\n      entityName: \"Jean Dupont (Acheteur qualifié)\",\n      entityDesc: \"Coordonnées qualifiées • Relance régulière\",\n      priority: \"faible\",\n      day: 23,\n      time: \"16:45\",\n      completed: true,\n      photoSeed: 0\n    },\n    {\n      id: \"task-6\",\n      title: \"Rédaction de l'annonce immobilière finale\",\n      type: \"perso\",\n      entityKey: \"perso\",\n      entityName: \"Tâche personnelle\",\n      entityDesc: \"Aucun lien de bien\",\n      priority: \"faible\",\n      day: 28,\n      time: \"14:00\",\n      completed: false,\n      photoSeed: -1\n    }\n  ];\n\n  var PHOTOS = [\n    'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=100&q=80',\n    'https://images.unsplash.com/photo-1600566753086-00f18fe6ede1?w=100&q=80',\n    'https://images.unsplash.com/photo-1600573472550-8090b5e0745e?w=100&q=80',\n    'https://images.unsplash.com/photo-1505691938895-1758d7feb511?w=100&q=80',\n    'https://images.unsplash.com/photo-1568605114967-8130f3a36994?w=100&q=80',\n  ];\n\n  var tasks = [];\n  var activeRange = \"today\";\n  var activeType = \"all\";\n  var searchQuery = \"\";\n  var selectedDay = 23; // Today is 23 (May 2026)\n  var activeDetailTaskId = null;\n\n  function loadTasks() {\n    var stored = localStorage.getItem(\"immopilot_agenda_tasks_v1\");\n    if (stored) {\n      try {\n        tasks = JSON.parse(stored);\n      } catch (e) {\n        tasks = DEFAULT_TASKS;\n      }\n    } else {\n      tasks = DEFAULT_TASKS;\n      saveTasks();\n    }\n  }\n\n  function saveTasks() {\n    localStorage.setItem(\"immopilot_agenda_tasks_v1\", JSON.stringify(tasks));\n    window.dispatchEvent(new Event('ip-state-changed'));\n  }\n\n  window.addNewTask = function() {\n    var title = document.getElementById(\"task-title-input\").value;\n    var assoc = document.getElementById(\"task-assoc-input\").value;\n    var day = parseInt(document.getElementById(\"task-day-input\").value, 10);\n    var time = document.getElementById(\"task-time-input\").value || \"10:00\";\n    \n    var prio = \"normal\";\n    if (document.getElementById(\"prio-low\").checked) prio = \"faible\";\n    else if (document.getElementById(\"prio-urgent\").checked) prio = \"urgent\";\n\n    // Set entity descriptions according to options\n    var entityName = \"Tâche personnelle\";\n    var entityDesc = \"Aucune fiche liée\";\n    var type = \"perso\";\n    var photoSeed = -1;\n\n    if (assoc === \"deal-penthouse\") {\n      type = \"deal\";\n      entityName = \"Penthouse vue de parc (Uccle)\";\n      entityDesc = \"Deal actif • Lucas Martin\";\n      photoSeed = 2;\n    } else if (assoc === \"deal-triplex\") {\n      type = \"deal\";\n      entityName = \"Triplex art-déco (Ixelles)\";\n      entityDesc = \"Deal actif • Adam Dubois\";\n      photoSeed = 3;\n    } else if (assoc === \"bien-lasne\") {\n      type = \"bien\";\n      entityName = \"La Villa basse énergie (Lasne)\";\n      entityDesc = \"Bien Mandaté • Julie Bernard\";\n      photoSeed = 4;\n    } else if (assoc === \"bien-maitre\") {\n      type = \"bien\";\n      entityName = \"Maison de maître (Saint-Gilles)\";\n      entityDesc = \"Bien libre • FSBO\";\n      photoSeed = 1;\n    } else if (assoc === \"contact-dupont\") {\n      type = \"contact\";\n      entityName = \"Jean Dupont\";\n      entityDesc = \"Client Acquéreur\";\n      photoSeed = 0;\n    }\n\n    var newTask = {\n      id: \"task-\" + Date.now(),\n      title: title,\n      type: type,\n      entityKey: assoc,\n      entityName: entityName,\n      entityDesc: entityDesc,\n      priority: prio,\n      day: day,\n      time: time,\n      completed: false,\n      photoSeed: photoSeed\n    };\n\n    tasks.push(newTask);\n    saveTasks();\n    \n    // Reset form\n    document.getElementById(\"task-title-input\").value = \"\";\n    document.getElementById(\"task-assoc-input\").value = \"perso\";\n    document.getElementById(\"prio-normal\").checked = true;\n\n    // Refresh views & calendar dots\n    render();\n  };\n\n  window.deleteCurrentTask = function() {\n    if (activeDetailTaskId) {\n      tasks = tasks.filter(function(t) { return t.id !== activeDetailTaskId; });\n      saveTasks();\n      closeDrawer();\n      render();\n    }\n  };\n\n  window.toggleTaskCompletion = function(taskId, event) {\n    if (event) event.stopPropagation();\n    var task = tasks.find(function(t) { return t.id === taskId; });\n    if (task) {\n      task.completed = !task.completed;\n      saveTasks();\n      render();\n    }\n  };\n\n  window.openTaskDetails = function(taskId) {\n    var task = tasks.find(function(t) { return t.id === taskId; });\n    if (!task) return;\n\n    activeDetailTaskId = taskId;\n    \n    // Set text elements inside the drawer\n    document.getElementById(\"detail-title\").textContent = task.title;\n    \n    var iconCode = \"📝\";\n    if (task.type === \"deal\") iconCode = \"📂\";\n    if (task.type === \"bien\") iconCode = \"🏡\";\n    if (task.type === \"contact\") iconCode = \"👤\";\n\n    document.getElementById(\"detail-category\").textContent = iconCode + \" Catégorie : \" + task.type.toUpperCase();\n    \n    var prioLabel = \"Normal\";\n    if (task.priority === \"urgent\") prioLabel = \"🔴 Urgent\";\n    if (task.priority === \"faible\") prioLabel = \"🔵 Faible\";\n    \n    document.getElementById(\"detail-priority\").innerHTML = '<span class=\"priority-tag ' + task.priority + '\">' + prioLabel + '</span>';\n    document.getElementById(\"detail-date\").textContent = \"Mai \" + task.day + \", 2026 à \" + task.time;\n    document.getElementById(\"detail-status\").innerHTML = task.completed ? '<span style=\"color: var(--forest); font-weight: 700;\">Terminé</span>' : '<span style=\"color: var(--amber); font-weight: 700;\">En cours</span>';\n\n    // Preview area\n    var preview = document.getElementById(\"detail-entity-preview\");\n    if (task.photoSeed >= 0) {\n      preview.style.display = \"flex\";\n      document.getElementById(\"detail-preview-img\").src = PHOTOS[task.photoSeed];\n      document.getElementById(\"detail-preview-title\").textContent = task.entityName;\n      document.getElementById(\"detail-preview-desc\").textContent = task.entityDesc;\n    } else {\n      preview.style.display = \"none\";\n    }\n\n    document.getElementById(\"detail-overlay\").style.display = \"flex\";\n  };\n\n  window.closeDrawer = function() {\n    document.getElementById(\"detail-overlay\").style.display = \"none\";\n    activeDetailTaskId = null;\n  };\n\n  window.goToLink = function() {\n    if (!activeDetailTaskId) return;\n    var task = tasks.find(function(t) { return t.id === activeDetailTaskId; });\n    if (task) {\n      closeDrawer();\n      if (task.type === \"deal\") {\n        window.location.hash = \"#pipeline\";\n      } else if (task.type === \"bien\") {\n        window.location.hash = \"#biens\";\n      } else if (task.type === \"contact\") {\n        window.location.hash = \"#contacts\";\n      }\n    }\n  };\n\n  // Switch Active Calendar view date\n  window.selectCalDay = function(day) {\n    selectedDay = day;\n    activeRange = \"all\"; // Change search focus to look up specific day \n    \n    // update calendar styles\n    var elDayBtns = document.querySelectorAll(\".cal-day\");\n    elDayBtns.forEach(function(btn) {\n      if (parseInt(btn.dataset.day, 10) === day) {\n        btn.classList.add(\"active\");\n      } else {\n        btn.classList.remove(\"active\");\n      }\n    });\n\n    // Reset active filters to reflect the focused day\n    var tabs = document.querySelectorAll(\"#time-tabs button\");\n    tabs.forEach(function(t) { t.classList.remove(\"active\"); });\n    \n    renderTaskList();\n  };\n\n  function updateDashboardKPIs() {\n    var todayTasks = tasks.filter(function(t) { return t.day === 23; });\n    var todayUrgent = todayTasks.filter(function(t) { return t.priority === \"urgent\" && !t.completed; });\n    var allOverdue = tasks.filter(function(t) { return t.day < 23 && !t.completed; });\n    var allCompleted = tasks.filter(function(t) { return t.completed; });\n    var linkedCount = tasks.filter(function(t) { return t.type !== \"perso\"; });\n\n    // Populate Values\n    document.getElementById(\"kpi-today\").textContent = todayTasks.length;\n    document.getElementById(\"kpi-today-urgent\").textContent = todayUrgent.length + \" non faites\";\n    document.getElementById(\"kpi-done\").textContent = allCompleted.length;\n    \n    var rate = tasks.length > 0 ? Math.round((allCompleted.length / tasks.length) * 100) : 0;\n    document.getElementById(\"kpi-completion-label\").textContent = rate + \"% de taux de complétion\";\n    \n    document.getElementById(\"kpi-overdue\").textContent = allOverdue.length;\n    document.getElementById(\"kpi-linked\").textContent = linkedCount.length;\n  }\n\n  function renderTaskList() {\n    var listRoot = document.getElementById(\"tasks-list-root\");\n    listRoot.innerHTML = \"\";\n\n    // Filter logic\n    var filtered = tasks.filter(function(task) {\n      // 1. Filter by categories: deal, bien, contact, perso\n      if (activeType !== \"all\" && task.type !== activeType) return false;\n\n      // 2. Filter by search text query\n      if (searchQuery) {\n        var query = searchQuery.toLowerCase();\n        var matchesTitle = task.title.toLowerCase().indexOf(query) !== -1;\n        var matchesEntity = task.entityName.toLowerCase().indexOf(query) !== -1;\n        return matchesTitle || matchesEntity;\n      }\n\n      // 3. Filter by Time Range\n      if (activeRange === \"today\") {\n        // Show today (day 23) + overdue (day < 23 and not completed)\n        return (task.day === 23) || (task.day < 23 && !task.completed);\n      } else if (activeRange === \"week\") {\n        // Show tasks for days 18 to 26\n        return task.day >= 18 && task.day <= 26;\n      } else if (activeRange === \"month\") {\n        // Show all\n        return true;\n      } else {\n        // Custom selection on Calendar Day\n        if (selectedDay) {\n          return task.day === selectedDay;\n        }\n      }\n      return true;\n    });\n\n    // Separating into \"En cours\" (includes overdue) and \"Terminées\"\n    var ongoingTasks = filtered.filter(function(t) { return !t.completed; });\n    var completedTasks = filtered.filter(function(t) { return t.completed; });\n\n    // Handle empty state\n    if (filtered.length === 0) {\n      var emptyBox = document.createElement(\"div\");\n      emptyBox.className = \"empty-tasks-box\";\n      emptyBox.innerHTML = `\n        <svg width=\"60\" height=\"60\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--stone-light)\" stroke-width=\"1.5\" style=\"margin: 0 auto 12px; display: block;\">\n          <circle cx=\"12\" cy=\"12\" r=\"10\" />\n          <polyline points=\"12 6 12 12 16 14\" />\n        </svg>\n        <div style=\"font-weight: 700; color: var(--ink); font-size: 14px; margin-bottom: 4px;\">Aucune tâche programmée</div>\n        <div style=\"font-size: 11.5px; color: var(--stone);\">Ajustez vos filtres ou planifiez une nouvelle action.</div>\n      `;\n      listRoot.appendChild(emptyBox);\n      return;\n    }\n\n    // Sort order: Overdue first, then urgent, then standard order\n    var sortTasks = function(a, b) {\n      // overdue high\n      var aOverdue = a.day < 23 && !a.completed;\n      var bOverdue = b.day < 23 && !b.completed;\n      if (aOverdue && !bOverdue) return -1;\n      if (!aOverdue && bOverdue) return 1;\n\n      // urgent next\n      if (a.priority === \"urgent\" && b.priority !== \"urgent\") return -1;\n      if (a.priority !== \"urgent\" && b.priority === \"urgent\") return 1;\n\n      return a.day - b.day;\n    };\n\n    ongoingTasks.sort(sortTasks);\n\n    // Create container for active actions\n    if (ongoingTasks.length > 0) {\n      var ongoingTitle = document.createElement(\"div\");\n      ongoingTitle.className = \"task-group-title\";\n      ongoingTitle.textContent = \"Actions à mener (\" + ongoingTasks.length + \")\";\n      listRoot.appendChild(ongoingTitle);\n\n      ongoingTasks.forEach(function(task) {\n        listRoot.appendChild(createTaskCard(task));\n      });\n    }\n\n    // Create container for completed actions\n    if (completedTasks.length > 0) {\n      var completedTitle = document.createElement(\"div\");\n      completedTitle.className = \"task-group-title\";\n      completedTitle.textContent = \"Actions terminées (\" + completedTasks.length + \")\";\n      listRoot.appendChild(completedTitle);\n\n      completedTasks.forEach(function(task) {\n        listRoot.appendChild(createTaskCard(task));\n      });\n    }\n  }\n\n  function createTaskCard(task) {\n    var card = document.createElement(\"div\");\n    card.className = \"task-card\" + (task.completed ? \" completed\" : \"\");\n    if (task.id === activeDetailTaskId) {\n      card.classList.add(\"selected-active\");\n    }\n\n    // Generate date caption\n    var dateCaption = \"\";\n    var dateClass = \"\";\n    if (task.day === 23) {\n      dateCaption = \"Aujourd'hui à \" + task.time;\n      dateClass = \"today\";\n    } else if (task.day < 23) {\n      dateCaption = \"RETARD (le \" + task.day + \" Mai)\";\n      dateClass = \"overdue\";\n    } else if (task.day === 24) {\n      dateCaption = \"Demain à \" + task.time;\n    } else {\n      dateCaption = \"Le \" + task.day + \" Mai à \" + task.time;\n    }\n\n    // Entity icons\n    var iconSvg = \"\";\n    if (task.type === \"deal\") {\n      iconSvg = '<svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"2\" y=\"7\" width=\"20\" height=\"14\" rx=\"2\" ry=\"2\"></rect><path d=\"M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16\"></path></svg>';\n    } else if (task.type === \"bien\") {\n      iconSvg = '<svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"></path><polyline points=\"9 22 9 12 15 12 15 22\"></polyline></svg>';\n    } else if (task.type === \"contact\") {\n      iconSvg = '<svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\"></path><circle cx=\"12\" cy=\"7\" r=\"4\"></circle></svg>';\n    }\n\n    card.innerHTML = `\n      <div class=\"task-checkbox-wrapper\">\n        <input type=\"checkbox\" class=\"task-checkbox\" ${task.completed ? \"checked\" : \"\"} onclick=\"toggleTaskCompletion('${task.id}', event)\">\n      </div>\n      <div class=\"task-content\">\n        <div class=\"task-header-row\">\n          <div class=\"task-title\">${task.title}</div>\n          <span class=\"time-tag ${task.completed ? '' : dateClass}\">${dateCaption}</span>\n        </div>\n        \n        <div class=\"task-badge-row\">\n          <span class=\"priority-tag ${task.priority}\">${task.priority}</span>\n          ${task.type !== 'perso' ? `\n            <span class=\"badge-rel\">\n              ${iconSvg} \n              <span>${task.entityName}</span>\n            </span>\n          ` : '<span class=\"badge-rel\">📝 Action perso</span>'}\n        </div>\n      </div>\n    `;\n\n    card.addEventListener(\"click\", function() {\n      openTaskDetails(task.id);\n    });\n\n    return card;\n  }\n\n  function renderCalendar() {\n    var calRoot = document.getElementById(\"calendar-grid-root\");\n    calRoot.innerHTML = \"\";\n\n    // Month layout (Simulated for May 2026 starting on Friday. Day 1 is index 4 if Monday = 0)\n    // We add 4 blank days (27, 28, 29, 30 of April) or just draw offset numbers muted\n    var daysCount = 31;\n    var startOffset = 4; // Friday\n\n    // Add prefix muted days\n    for (var i = 27; i <= 30; i++) {\n      var d = document.createElement(\"div\");\n      d.className = \"cal-day muted\";\n      var numSpan = document.createElement(\"span\");\n      numSpan.className = \"cal-day-num\";\n      numSpan.textContent = i;\n      d.appendChild(numSpan);\n      calRoot.appendChild(d);\n    }\n\n    // Add May days\n    for (var day = 1; day <= 31; day++) {\n      var dayBtn = document.createElement(\"div\");\n      dayBtn.className = \"cal-day\";\n      dayBtn.dataset.day = day;\n\n      var numSpan = document.createElement(\"span\");\n      numSpan.className = \"cal-day-num\";\n      numSpan.textContent = day;\n      dayBtn.appendChild(numSpan);\n\n      if (day === selectedDay) {\n        dayBtn.classList.add(\"active\");\n      }\n\n      // Check for tasks on this day and add dots + hover tooltip\n      var dayTasks = tasks.filter(function(t) { return t.day === day; });\n      if (dayTasks.length > 0) {\n        // 1. Dot indicator list (under the day number)\n        var dotsContainer = document.createElement(\"div\");\n        dotsContainer.className = \"cal-day-dots\";\n        \n        // Render up to 3 dots in the cell row\n        dayTasks.slice(0, 3).forEach(function(t) {\n          var dot = document.createElement(\"span\");\n          dot.className = \"cal-dot \" + t.type + (t.completed ? \" completed\" : \"\");\n          dotsContainer.appendChild(dot);\n        });\n        dayBtn.appendChild(dotsContainer);\n\n        // 2. Beautiful speech-bubble tooltip with full lists\n        var tooltip = document.createElement(\"div\");\n        tooltip.className = \"cal-tooltip\";\n        \n        var tooltipTitle = document.createElement(\"div\");\n        tooltipTitle.className = \"tooltip-title\";\n        tooltipTitle.textContent = dayTasks.length + \" action\" + (dayTasks.length > 1 ? \"s\" : \"\") + \" le \" + day + \" Mai\";\n        tooltip.appendChild(tooltipTitle);\n        \n        var listContainer = document.createElement(\"div\");\n        listContainer.className = \"tooltip-tasks\";\n        \n        dayTasks.forEach(function(t) {\n          var item = document.createElement(\"div\");\n          item.className = \"tooltip-task-item\" + (t.completed ? \" completed\" : \"\");\n          \n          var dot = document.createElement(\"span\");\n          dot.className = \"tooltip-task-dot \" + t.type;\n          \n          var textSpan = document.createElement(\"span\");\n          textSpan.className = \"tooltip-task-text\";\n          textSpan.textContent = t.title;\n          \n          var timeSpan = document.createElement(\"span\");\n          timeSpan.className = \"tooltip-task-time\";\n          timeSpan.textContent = t.time;\n          \n          item.appendChild(dot);\n          item.appendChild(textSpan);\n          item.appendChild(timeSpan);\n          \n          listContainer.appendChild(item);\n        });\n        \n        tooltip.appendChild(listContainer);\n        dayBtn.appendChild(tooltip);\n      }\n\n      // Closure binding\n      (function(currentDay) {\n        dayBtn.addEventListener(\"click\", function() {\n          selectCalDay(currentDay);\n        });\n      })(day);\n\n      calRoot.appendChild(dayBtn);\n    }\n  }\n\n  function setupFilters() {\n    // Range switcher\n    var tabs = document.querySelectorAll(\"#time-tabs button\");\n    tabs.forEach(function(btn) {\n      btn.addEventListener(\"click\", function() {\n        tabs.forEach(function(t) { t.classList.remove(\"active\"); });\n        btn.classList.add(\"active\");\n        activeRange = btn.dataset.range;\n        selectedDay = null; // Unfocus calendar day highlights\n        \n        // Remove active calendar markings\n        document.querySelectorAll(\".cal-day\").forEach(function(c) {\n          c.classList.remove(\"active\");\n        });\n\n        renderTaskList();\n      });\n    });\n\n    // Search input\n    var search = document.getElementById(\"search-tasks\");\n    search.addEventListener(\"input\", function() {\n      searchQuery = search.value;\n      renderTaskList();\n    });\n\n    // Type pills\n    var pills = document.querySelectorAll(\"#type-filters button\");\n    pills.forEach(function(p) {\n      p.addEventListener(\"click\", function() {\n        pills.forEach(function(p1) { p1.classList.remove(\"active\"); });\n        p.classList.add(\"active\");\n        activeType = p.dataset.type;\n        renderTaskList();\n      });\n    });\n  }\n\n  function render() {\n    updateDashboardKPIs();\n    renderTaskList();\n    renderCalendar();\n  }\n\n  // Initial loader\n  loadTasks();\n  setupFilters();\n  render();\n\n})();\n</script>\n\n</body>\n</html>\n"
