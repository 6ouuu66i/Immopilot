export default "<div class=\"agenda-page\">\n  <style>\n    .settings-container {\n      margin-right: 22px;\n      display: grid;\n      grid-template-columns: 1.5fr 1fr;\n      gap: 24px;\n    }\n    .settings-card {\n      background: #FFFDF7;\n      border: 1.5px solid var(--stone);\n      border-radius: 4px;\n      padding: 20px;\n      box-shadow: 2.2px 2.5px 0px rgba(107, 111, 109, 0.15);\n      margin-bottom: 24px;\n    }\n    .form-group-retro {\n      display: flex;\n      flex-direction: column;\n      gap: 6px;\n      margin-bottom: 16px;\n    }\n    .form-group-retro label {\n      font-family: 'JetBrains Mono', monospace;\n      font-size: 11px;\n      font-weight: 600;\n      text-transform: uppercase;\n      color: var(--stone);\n    }\n    .form-control-retro {\n      padding: 8px 12px;\n      font-size: 13.5px;\n      border: 1.5px solid var(--stone);\n      border-radius: 4px;\n      background: #FFFDF7;\n      outline: none;\n      transition: all 120ms;\n    }\n    .form-control-retro:focus {\n      border-color: var(--forest);\n      box-shadow: 1.5px 1.5px 0px var(--forest);\n    }\n    .agent-switcher {\n      display: flex;\n      flex-direction: column;\n      gap: 12px;\n    }\n    .agent-option {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      border: 1.5px solid var(--stone);\n      border-radius: 4px;\n      padding: 10px 14px;\n      background: #FFFDF7;\n      cursor: pointer;\n      transition: all 150ms;\n    }\n    .agent-option:hover {\n      background: var(--forest-tint);\n    }\n    .agent-option.selected {\n      border-color: var(--forest);\n      background: var(--forest-tint);\n      box-shadow: 2px 2px 0px var(--forest);\n    }\n    .sync-btn {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      margin-top: 8px;\n    }\n  </style>\n\n  <!-- Title section -->\n  <div class=\"agenda-header\" style=\"margin-bottom:20px;\">\n    <div class=\"agenda-header-top\">\n      <div class=\"agenda-title\">\n        <h1>Paramètres d'ImmoPilot</h1>\n        <div class=\"agenda-subtitle\">Configuration des préférences d'agence, du profil simulé actif, et intégrations</div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"settings-container\">\n    <!-- LEFT: System preferences -->\n    <div>\n      <div class=\"settings-card\">\n        <h3 style=\"font-family:'Lora',serif; font-size:16px; font-weight:700; color:var(--ink); margin-bottom:14px;\">🎛️ Sélecteur de profil actif (Simulateur de rôles)</h3>\n        <p style=\"font-size:12.5px; color:var(--stone); margin-bottom:16px;\">Sélectionnez l'utilisateur simulé pour naviguer entre les niveaux d'autorisation CRM d'ImmoPilot :</p>\n        \n        <div class=\"agent-switcher\" id=\"settings-agent-switcher-list\">\n          <!-- Populated by JS -->\n        </div>\n      </div>\n\n      <div class=\"settings-card\">\n        <h3 style=\"font-family:'Lora',serif; font-size:16px; font-weight:700; color:var(--ink); margin-bottom:14px;\">🏢 Configuration de l'Agence</h3>\n        <div class=\"form-group-retro\">\n          <label>Nom de la structure Real-Estate</label>\n          <input type=\"text\" class=\"form-control-retro\" id=\"settings-agency-name\" value=\"Agence Plus Immobilier SRL\">\n        </div>\n        <div class=\"form-group-retro\">\n          <label>Taux de Commission standard (%)</label>\n          <input type=\"number\" class=\"form-control-retro\" id=\"settings-agency-fee\" value=\"3.0\" step=\"0.5\">\n        </div>\n        <button class=\"tab-btn active\" onclick=\"alert('Configuration d\\'agence enregistrée !')\" style=\"height:34px;\">Sauvegarder les préférences</button>\n      </div>\n    </div>\n\n    <!-- RIGHT: Integrations and Sync status -->\n    <div>\n      <div class=\"settings-card\">\n        <h3 style=\"font-family:'Lora',serif; font-size:16px; font-weight:700; color:var(--ink); margin-bottom:12px;\">📅 Synchronisation Calendrier externe</h3>\n        <p style=\"font-size:12.5px; color:var(--stone); margin-bottom:16px;\">Permettez la synchronisation instantanée bidirectionnelle de votre Agenda ImmoPilot avec vos outils d'équipe personnels :</p>\n        \n        <div style=\"display:flex; flex-direction:column; gap:12px;\">\n          <div style=\"padding:10px; border:1px solid var(--sand-deep); border-radius:4px; display:flex; justify-content:space-between; align-items:center;\">\n            <div style=\"display:flex; align-items:center; gap:8px;\">\n              <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" style=\"color:var(--forest)\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 6v6l4 2\"/></svg>\n              <span style=\"font-size:12.5px; font-weight:600;\">Google Calendar</span>\n            </div>\n            <span class=\"status-badge\" id=\"gcal-status\" style=\"background:#FBDADA; color:var(--rose); border:1px solid var(--rose); cursor:pointer;\" onclick=\"toggleSync('gcal')\">Déconnecté</span>\n          </div>\n\n          <div style=\"padding:10px; border:1px solid var(--sand-deep); border-radius:4px; display:flex; justify-content:space-between; align-items:center;\">\n            <div style=\"display:flex; align-items:center; gap:8px;\">\n              <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" style=\"color:var(--forest)\"><polyline points=\"22 12 18 12 15 21 9 3 6 12 2 12\"/></svg>\n              <span style=\"font-size:12.5px; font-weight:600;\">Microsoft Outlook</span>\n            </div>\n            <span class=\"status-badge\" id=\"outlook-status\" style=\"background:#FBDADA; color:var(--rose); border:1px solid var(--rose); cursor:pointer;\" onclick=\"toggleSync('outlook')\">Déconnecté</span>\n          </div>\n        </div>\n        <p style=\"font-size:11px; color:var(--stone); margin-top:12px; line-height:1.3;\">Note : En environnement de développement local, les appels OAuth seront simulés par des jetons applicatifs sécurisés temporaires.</p>\n      </div>\n\n      <div class=\"settings-card\">\n        <h3 style=\"font-family:'Lora',serif; font-size:16px; font-weight:700; color:var(--ink); margin-bottom:10px;\">🧪 État de Persistance (MVP)</h3>\n        <p style=\"font-size:12.5px; color:var(--stone); margin-bottom:12px;\">Toutes les actions CRM et modifications d'états de ce visualiseur interactif sont stockées au sein de la session locale sécurisée de votre navigateur Web.</p>\n        \n        <button class=\"action-btn-sm\" style=\"width:100%; border-color:var(--rose); color:var(--rose); background:#FFF8F7;\" onclick=\"clearStateAndHardReset()\">Réinitialiser complètement la Base de données</button>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\n(function() {\n  const store = window.ImmoPilotStore;\n  if (!store) return;\n\n  function renderSwitcher() {\n    const listContainer = document.getElementById('settings-agent-switcher-list');\n    if (!listContainer) return;\n\n    const agents = store.getAgents();\n    const current = store.getCurrentAgent();\n\n    listContainer.innerHTML = agents.map(a => {\n      const isSelected = a.id === current.id;\n      return `\n        <div class=\"agent-option ${isSelected ? 'selected' : ''}\" onclick=\"selectSystemAgent('${a.id}')\">\n          <div style=\"display:flex; align-items:center; gap:10px;\">\n            <div class=\"agent-avatar\" style=\"background-image:url(${a.avatar}); width:28px; height:28px;\"></div>\n            <div>\n              <strong style=\"font-size:13px; color:var(--ink);\">${a.name}</strong>\n              <div style=\"font-size:10.5px; color:var(--stone); text-transform:uppercase; font-family:monospace;\">${a.role === 'admin' ? 'Administrateur' : 'Conseiller Immobilier'}</div>\n            </div>\n          </div>\n          <div>\n            ${isSelected \n              ? `<span style=\"font-size:11px; font-weight:700; color:var(--forest); font-family:monospace;\">ACTIF ✔</span>`\n              : `<span style=\"font-size:11px; color:var(--stone-light); font-family:monospace;\">Sélectionner</span>`\n            }\n          </div>\n        </div>\n      `;\n    }).join('');\n  }\n\n  // Set system agent\n  window.selectSystemAgent = function(agentId) {\n    store.setCurrentAgent(agentId);\n    renderSwitcher();\n    \n    // Auto sync layout profiles\n    if (window.syncSidebarProfile) {\n      window.syncSidebarProfile();\n    }\n    \n    // Emit notification toast\n    const activeObj = store.getCurrentAgent();\n    const t = document.createElement('div');\n    t.style.cssText = \"position:fixed; bottom:20px; right:20px; background:var(--forest); color:#FFFDF7; padding:12px 20px; border-radius:4px; font-family:'JetBrains Mono',monospace; font-size:12.5px; box-shadow:3px 3px 0 var(--ink); z-index:9999;\";\n    t.textContent = `CRM : Profil actif commuté vers [${activeObj.name.toUpperCase()}].`;\n    document.body.appendChild(t);\n    setTimeout(() => t.remove(), 2500);\n  };\n\n  // Toggle dynamic calendar integrations\n  window.toggleSync = function(service) {\n    const el = document.getElementById(`${service}-status`);\n    if (!el) return;\n\n    const isConnected = el.textContent === 'Connecté';\n    if (isConnected) {\n      el.textContent = 'Déconnecté';\n      el.style.cssText = \"background:#FBDADA; color:var(--rose); border:1px solid var(--rose); cursor:pointer;\";\n    } else {\n      el.textContent = 'Connecté';\n      el.style.cssText = \"background:#EAF5ED; color:var(--forest); border:1px solid var(--forest); cursor:pointer;\";\n    }\n  };\n\n  // Database Reset\n  window.clearStateAndHardReset = function() {\n    if (confirm('Voulez-vous vraiment écraser l\\'état applicatif local ? Toutes vos modifications et nouveaux deals simulés seront définitivement perdus.')) {\n      localStorage.clear();\n      window.location.reload();\n    }\n  };\n\n  // Initial render\n  renderSwitcher();\n})();\n</script>\n"
