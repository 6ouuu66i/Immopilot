export default "<div class=\"agenda-page\">\n  <style>\n    .agenda-page {\n      display: flex;\n      flex-direction: column;\n      padding: 24px 28px 48px;\n      min-width: 0;\n      flex: 1;\n      height: 100%;\n      overflow-y: auto;\n      \n      background-color: #FBF9F4 !important; /* Premium warm paper sheet background */\n      background-image: \n        /* Soft red margin vertical line typical of high-quality notebooks */\n        linear-gradient(90deg, transparent 55px, rgba(200, 85, 61, 0.24) 55px, rgba(200, 85, 61, 0.24) 57px, transparent 57px),\n        /* Delicate forest-green grid lines to emphasize the sketched vibe */\n        linear-gradient(rgba(30, 90, 58, 0.08) 1px, transparent 1px),\n        linear-gradient(90deg, rgba(30, 90, 58, 0.08) 1px, transparent 1px) !important;\n      background-size: 100% 100%, 20px 20px, 20px 20px !important;\n    }\n\n    /* Page Header */\n    .admin-header {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 16px;\n      margin-bottom: 28px;\n      flex-wrap: wrap;\n    }\n\n    .admin-title-area {\n      display: flex;\n      flex-direction: column;\n      gap: 4px;\n    }\n\n    .admin-title-area h1 {\n      font-family: 'Lora', Georgia, serif;\n      font-size: 28px;\n      font-weight: 800;\n      letter-spacing: -0.02em;\n      margin: 0;\n      color: var(--ink);\n      display: flex;\n      align-items: center;\n    }\n\n    .admin-title-area h1::before {\n      content: '';\n      display: inline-block;\n      width: 4px;\n      height: 22px;\n      background: var(--forest);\n      margin-right: 12px;\n      border-radius: 99px;\n    }\n\n    .admin-subtitle {\n      font-size: 13px;\n      color: var(--stone);\n      margin-left: 16px;\n      display: flex;\n      align-items: center;\n      gap: 6px;\n    }\n\n    .admin-subtitle-select {\n      background: none;\n      border: none;\n      font-family: inherit;\n      font-size: 13.5px;\n      font-weight: 700;\n      color: var(--forest);\n      text-decoration: underline;\n      cursor: pointer;\n      padding: 0;\n      outline: none;\n    }\n\n    .header-actions {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n    }\n\n    /* KPI Grid - Row of 6 cards */\n    .kpi-grid-6 {\n      display: grid;\n      grid-template-columns: repeat(6, 1fr);\n      gap: 16px;\n      margin-bottom: 32px;\n    }\n\n    @media (max-width: 1400px) {\n      .kpi-grid-6 {\n        grid-template-columns: repeat(3, 1fr);\n      }\n    }\n\n    @media (max-width: 768px) {\n      .kpi-grid-6 {\n        grid-template-columns: repeat(2, 1fr);\n      }\n    }\n\n    .kpi-card-postit {\n      background: #FFFFFF;\n      border: 1.5px solid var(--stone);\n      border-radius: 8px;\n      padding: 16px 18px;\n      box-shadow: 2px 2px 0px var(--sand-deep);\n      position: relative;\n      display: flex;\n      gap: 12px;\n      align-items: center;\n      transition: transform 120ms ease, box-shadow 120ms ease, border-color 120ms;\n    }\n\n    .kpi-card-postit:hover {\n      transform: translateY(-2.5px) rotate(-0.5deg);\n      box-shadow: 4px 4px 0px var(--forest-soft);\n      border-color: var(--forest);\n    }\n\n    /* Rotation variation to make it look non-robotic and sketched */\n    .kpi-card-postit:nth-child(even) {\n       transform: rotate(0.6deg);\n    }\n    .kpi-card-postit:nth-child(odd) {\n       transform: rotate(-0.4deg);\n    }\n    .kpi-card-postit:nth-child(3n) {\n       transform: rotate(0.8deg);\n    }\n\n    .kpi-card-postit::before {\n      content: '';\n      position: absolute;\n      top: -8px;\n      left: 35%;\n      width: 30%;\n      height: 14px;\n      background: rgba(223, 221, 195, 0.45);\n      transform: rotate(-1deg);\n      border-left: 1px dashed rgba(29, 31, 30, 0.08);\n      border-right: 1px dashed rgba(29, 31, 30, 0.08);\n    }\n\n    .kpi-circle-icon {\n      width: 40px;\n      height: 40px;\n      border-radius: 180px 15px 150px 15px/15px 150px 15px 180px;\n      border: 1.5px solid var(--stone);\n      background: var(--sand);\n      color: var(--ink);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      flex-shrink: 0;\n      box-shadow: 1px 1.5px 0px rgba(0,0,0,0.05);\n    }\n\n    .kpi-text-info {\n      display: flex;\n      flex-direction: column;\n      flex: 1;\n      min-width: 0;\n    }\n\n    .kpi-text-info h4 {\n      margin: 0;\n      font-size: 11px;\n      font-family: 'JetBrains Mono', monospace;\n      color: var(--stone);\n      text-transform: uppercase;\n      letter-spacing: 0.02em;\n    }\n\n    .kpi-val-number {\n      font-family: 'Lora', Georgia, serif;\n      font-size: 24px;\n      font-weight: 850;\n      color: var(--ink);\n      line-height: 1.15;\n      margin: 2px 0 1px;\n    }\n\n    .kpi-sub-trend {\n      font-size: 11px;\n      color: var(--forest);\n      font-weight: 700;\n      font-family: 'JetBrains Mono', monospace;\n      display: flex;\n      align-items: center;\n      gap: 3px;\n    }\n\n    .kpi-sub-trend.silent {\n      color: var(--stone-light);\n      font-weight: 500;\n    }\n\n    /* MIDDLE CONTENT GRID */\n    .admin-main-grid {\n      display: grid;\n      grid-template-columns: 1.62fr 1.38fr;\n      gap: 28px;\n      margin-bottom: 32px;\n    }\n\n    @media (max-width: 1100px) {\n      .admin-main-grid {\n        grid-template-columns: 1fr;\n        gap: 24px;\n      }\n    }\n\n    /* Standard Card containers */\n    .admin-board {\n      background: #FFFFFF;\n      border: 1.5px solid var(--stone);\n      border-radius: 12px;\n      padding: 24px;\n      box-shadow: 2.5px 2.5px 0px var(--sand-deep);\n      position: relative;\n    }\n\n    .admin-board-title-row {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      margin-bottom: 20px;\n      gap: 12px;\n      flex-wrap: wrap;\n    }\n\n    .admin-board-title-row h3 {\n      font-family: 'Lora', Georgia, serif;\n      font-size: 17px;\n      font-weight: 800;\n      color: var(--ink);\n      margin: 0;\n      display: flex;\n      align-items: center;\n      gap: 8px;\n    }\n\n    /* Tables Style */\n    .custom-table-container {\n      width: 100%;\n      overflow-x: auto;\n    }\n\n    .custom-table {\n      width: 100%;\n      border-collapse: collapse;\n      text-align: left;\n    }\n\n    .custom-table th {\n      font-family: 'JetBrains Mono', monospace;\n      font-size: 10.5px;\n      font-weight: 750;\n      color: var(--stone);\n      text-transform: uppercase;\n      padding: 10px 12px;\n      border-bottom: 1.8px solid var(--stone);\n    }\n\n    .custom-table td {\n      padding: 14px 12px;\n      border-bottom: 1px dashed var(--sand-deep);\n      font-size: 12.5px;\n      color: var(--ink);\n      vertical-align: middle;\n    }\n\n    .custom-table tr:last-child td {\n      border-bottom: none;\n    }\n\n    /* Top Performer Badge */\n    .badge-top-performer {\n      background: #EBF7EE;\n      color: var(--forest);\n      border: 1px solid var(--forest);\n      font-family: 'JetBrains Mono', monospace;\n      font-size: 9px;\n      font-weight: 700;\n      padding: 1px 6px;\n      border-radius: 4px;\n      display: inline-block;\n      margin-top: 2px;\n    }\n\n    .delayed-tasks-box {\n      background: #FCECE9;\n      color: #C0553D;\n      border: 1.3px solid #C0553D;\n      font-family: 'JetBrains Mono', monospace;\n      font-weight: 800;\n      font-size: 11px;\n      width: 22px;\n      height: 22px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      border-radius: 4px;\n      margin: 0 auto;\n    }\n\n    /* Tabs Filter for logs and requests */\n    .badge-tab-list {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      background: var(--sand-light, #FAF7F2);\n      border: 1.2px solid var(--stone);\n      padding: 3.5px;\n      border-radius: 30px;\n    }\n\n    .badge-tab-item {\n      padding: 4px 12px;\n      font-size: 11px;\n      font-family: 'JetBrains Mono', monospace;\n      font-weight: 700;\n      border-radius: 20px;\n      cursor: pointer;\n      color: var(--stone);\n      background: none;\n      border: none;\n      transition: all 120ms;\n    }\n\n    .badge-tab-item.active {\n      background: var(--forest);\n      color: #FFFDF7 !important;\n    }\n\n    .badge-tab-counter {\n      font-size: 9px;\n      opacity: 0.85;\n      margin-left: 2px;\n    }\n\n    /* Transfer Thumbnail */\n    .transfer-house-pic {\n      width: 38px;\n      height: 38px;\n      border-radius: 6px;\n      border: 1.3px solid var(--stone);\n      object-fit: cover;\n      box-shadow: 1px 1px 0px rgba(0,0,0,0.06);\n    }\n\n    /* Bottom Row Structure of 3 Config columns */\n    .admin-bottom-grid-3 {\n      display: grid;\n      grid-template-columns: 1.45fr 0.95fr 1.1fr;\n      gap: 24px;\n    }\n\n    @media (max-width: 1200px) {\n      .admin-bottom-grid-3 {\n        grid-template-columns: 1fr;\n      }\n    }\n\n    /* Interlocking workflow stages list */\n    .pipeline-stages-container {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 8.5px;\n      margin: 14px 0 16px;\n    }\n\n    .pipeline-card-stage {\n      flex: 1;\n      min-width: 78px;\n      background: #FFFFFF;\n      border: 1.5px solid var(--stone);\n      border-radius: 6px;\n      padding: 10px 6px;\n      text-align: center;\n      box-shadow: 1.5px 1.5px 0px var(--sand-deep);\n      position: relative;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      gap: 5px;\n      transition: transform 120ms;\n    }\n\n    .pipeline-card-stage:hover {\n      transform: translateY(-2px);\n      border-color: var(--forest);\n    }\n\n    .pipeline-number {\n      position: absolute;\n      top: 3px;\n      left: 4.5px;\n      font-family: 'JetBrains Mono', monospace;\n      font-size: 9px;\n      color: var(--stone-light);\n    }\n\n    .pipeline-icon-box {\n      width: 24px;\n      height: 24px;\n      background: var(--sand);\n      border-radius: 50%;\n      border: 1.1px solid var(--stone);\n      color: var(--ink);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 11px;\n    }\n\n    .pipeline-stage-title {\n      font-size: 10.5px;\n      font-weight: 750;\n      color: var(--ink);\n      white-space: nowrap;\n      text-overflow: ellipsis;\n      overflow: hidden;\n      width: 100%;\n    }\n\n    /* Styled Toggle switches */\n    .automation-item-row {\n      background: #FFFDF9;\n      border: 1.5px solid var(--stone);\n      border-radius: 8px;\n      padding: 12px 14px;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 12px;\n      margin-bottom: 10px;\n    }\n\n    .automation-info h4 {\n      margin: 0 0 3px 0;\n      font-family: 'Lora', Georgia, serif;\n      font-size: 12.5px;\n      font-weight: 750;\n      color: var(--ink);\n    }\n\n    .automation-info p {\n      margin: 0;\n      font-size: 10.5px;\n      color: var(--stone);\n      line-height: 1.35;\n    }\n\n    /* Retro inputs with units */\n    .retro-input-wrapper {\n      margin-bottom: 14px;\n    }\n\n    .retro-input-wrapper label {\n      display: block;\n      font-size: 11.5px;\n      font-family: 'JetBrains Mono', monospace;\n      font-weight: 750;\n      color: var(--stone);\n      margin-bottom: 5px;\n      text-transform: uppercase;\n    }\n\n    .retro-input-unit {\n      position: relative;\n      display: flex;\n      align-items: center;\n    }\n\n    .retro-input-unit input {\n      width: 100%;\n      font-family: 'JetBrains Mono', monospace;\n      font-size: 13px;\n      font-weight: 700;\n      padding: 9px 40px 9px 12px;\n      border: 1.5px solid var(--stone);\n      border-radius: 8px;\n      background: #FFFFFF;\n      outline: none;\n      color: var(--ink);\n      transition: all 120ms;\n    }\n\n    .retro-input-unit input:focus {\n      border-color: var(--forest);\n      box-shadow: 2px 2px 0px var(--forest-soft);\n    }\n\n    .retro-input-unit span {\n      position: absolute;\n      right: 14px;\n      font-family: 'JetBrains Mono', monospace;\n      font-size: 12px;\n      font-weight: 750;\n      color: var(--stone);\n      pointer-events: none;\n    }\n\n    /* Checkboxes */\n    .checkbox-container-custom {\n      display: flex;\n      align-items: flex-start;\n      gap: 10px;\n      margin: 16px 0 20px;\n      cursor: pointer;\n    }\n\n    .checkbox-container-custom input {\n      margin-top: 3px;\n      cursor: pointer;\n    }\n\n    .checkbox-container-custom span {\n      font-size: 11.5px;\n      color: var(--stone);\n      line-height: 1.4;\n    }\n\n    /* Statuses for Sync Sources */\n    .pill-status {\n      font-family: 'JetBrains Mono', monospace;\n      font-size: 9.5px;\n      font-weight: 800;\n      padding: 2.5px 10px;\n      border-radius: 99px;\n      display: inline-flex;\n      align-items: center;\n      gap: 4px;\n      text-transform: uppercase;\n    }\n\n    .pill-status.synced {\n      background: #EBF7EE;\n      color: var(--forest);\n      border: 1px solid var(--forest);\n    }\n\n    .pill-status.warning {\n      background: #FFF9E6;\n      color: #C67A13;\n      border: 1px solid #C67A13;\n    }\n\n    .pill-status.error {\n      background: #FCECE9;\n      color: #C0553D;\n      border: 1px solid #C0553D;\n    }\n\n    /* Brand Logo Circles */\n    .brand-circle-avatar {\n      width: 28px;\n      height: 28px;\n      border-radius: 50%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-weight: 850;\n      font-size: 11px;\n      color: #FFFFFF;\n      border: 1.2px solid var(--stone);\n      box-shadow: 1px 1px 0px rgba(0,0,0,0.04);\n      flex-shrink: 0;\n    }\n\n    /* Toggles custom design */\n    .switch-retro {\n      position: relative;\n      display: inline-block;\n      width: 44px;\n      height: 22px;\n      flex-shrink: 0;\n    }\n\n    .switch-retro input {\n      opacity: 0;\n      width: 0;\n      height: 0;\n    }\n\n    .slider-retro {\n      position: absolute;\n      cursor: pointer;\n      top: 0; left: 0; right: 0; bottom: 0;\n      background-color: var(--sand-deep);\n      border: 1.5px solid var(--stone);\n      transition: .2s;\n      border-radius: 20px;\n    }\n\n    .slider-retro:before {\n      position: absolute;\n      content: \"\";\n      height: 14px;\n      width: 14px;\n      left: 3px;\n      bottom: 2.5px;\n      background-color: #FFFFFF;\n      border: 1.2px solid var(--stone);\n      transition: .2s;\n      border-radius: 50%;\n    }\n\n    input:checked + .slider-retro {\n      background-color: var(--forest);\n    }\n\n    input:checked + .slider-retro:before {\n      transform: translateX(21px);\n    }\n\n    /* Sticky/Postit decorative headers or footers */\n    .footer-handwritten-link {\n      font-size: 12.5px;\n      color: var(--forest);\n      text-decoration: underline;\n      cursor: pointer;\n      font-family: 'JetBrains Mono', monospace;\n      font-weight: 700;\n      display: inline-flex;\n      align-items: center;\n      gap: 4px;\n      margin-top: 14px;\n      transition: color 100ms;\n    }\n\n    .footer-handwritten-link:hover {\n      color: var(--ink);\n    }\n\n    /* Action buttons thick board */\n    .thick-btn-action {\n      background: var(--forest);\n      color: #FFFDF7 !important;\n      border: 2px solid var(--ink);\n      font-family: 'JetBrains Mono', monospace;\n      font-weight: 700;\n      font-size: 12.5px;\n      padding: 10px 18px;\n      border-radius: 180px 15px 150px 15px/15px 150px 15px 180px;\n      cursor: pointer;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: 8px;\n      transition: all 120ms;\n      box-shadow: 2px 2px 0px var(--ink);\n      width: 100%;\n    }\n\n    .thick-btn-action:hover {\n      background: rgba(30, 90, 58, 0.95);\n      box-shadow: 3.5px 3.5px 0px var(--ink);\n      transform: translate(-0.5px, -0.5px);\n    }\n\n    .thick-btn-action:active {\n      transform: translate(0.5px, 0.5px);\n      box-shadow: 0.5px 0.5px 0px var(--ink);\n    }\n\n    /* Overrides and UI indicators */\n    .top-performer-tr-bg {\n      background-color: #FAFAF7;\n    }\n\n    .dot-menu-icon {\n      outline: none;\n      background: none;\n      border: none;\n      cursor: pointer;\n      color: var(--stone);\n      font-size: 18px;\n      line-height: 1;\n      padding: 4px 8px;\n      border-radius: 4px;\n    }\n\n    .dot-menu-icon:hover {\n      background: var(--sand);\n      color: var(--ink);\n    }\n\n    .admin-restricted-box {\n      background: #FFFFFF;\n      border: 2px dashed #C0553D;\n      border-radius: 12px;\n      padding: 45px 32px;\n      text-align: center;\n      max-width: 610px;\n      margin: 40px auto;\n      box-shadow: 2.2px 2.2px 0px rgba(107, 111, 109, 0.08);\n    }\n  </style>\n\n  <!-- Header Area -->\n  <div class=\"admin-header\">\n    <div class=\"admin-title-area\">\n      <h1>Administration</h1>\n      <div class=\"admin-subtitle\">\n        Vue d'ensemble de l'agence • <select class=\"admin-subtitle-select\" onchange=\"alert('Changement de vue vers : ' + this.value)\"><option value=\"plus\">SaaS ImmoPilot (Global)</option><option value=\"brabant\">Succursale Brabant-Wallon</option></select>\n      </div>\n    </div>\n    <div class=\"header-actions\">\n      <!-- Exporter le rapport Button -->\n      <button class=\"tab-btn\" style=\"display: inline-flex; align-items: center; gap: 8px;\" onclick=\"triggerReportExport()\">\n        <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"></path>\n          <polyline points=\"7 10 12 15 17 10\"></polyline>\n          <line x1=\"12\" y1=\"15\" x2=\"12\" y2=\"3\"></line>\n        </svg>\n        Exporter le rapport\n      </button>\n\n      <!-- Badge displaying current authorization role -->\n      <span class=\"status-badge\" id=\"admin-main-role-indicator\">Chargement...</span>\n    </div>\n  </div>\n\n  <!-- Dynamic view wrapper -->\n  <div id=\"admin-interactive-view\">\n     <!-- Filled dynamically depending on administrative privileges -->\n  </div>\n</div>\n\n<script>\n(function() {\n  const store = window.ImmoPilotStore;\n  if (!store) return;\n\n  // Track state locally\n  let selectedTransferTab = 'tous'; \n  let selectedAgentKPI = 'global';\n\n  // Local state for portal sync sources to simulate real-time API integrations\n  let portalSyncStates = {\n    'Immoweb': { status: 'synced', text: '✔ Sync', lastTime: '09:42', count: 28734, color: '#2B3A8C', initials: 'iw' },\n    'Zimmo': { status: 'synced', text: '✔ Sync', lastTime: '09:40', count: 19872, color: 'var(--forest)', initials: 'zi' },\n    'Immovlan': { status: 'synced', text: '✔ Sync', lastTime: '09:39', count: 12104, color: '#8F55C9', initials: 'im' },\n    '2ememain': { status: 'warning', text: '⚠ Alerte', lastTime: '08:10', count: 6120, color: '#C67A13', initials: '2e' },\n    'Biddit': { status: 'error', text: '✖ Erreur', lastTime: 'Hier', count: 418, color: '#C0553D', initials: 'bi' }\n  };\n\n  function renderAdminView() {\n    const mainView = document.getElementById('admin-interactive-view');\n    const roleIndicator = document.getElementById('admin-main-role-indicator');\n    if (!mainView) return;\n\n    const currentAgent = store.getCurrentAgent();\n    const isAdmin = currentAgent.role === 'admin';\n\n    // 1. Update Role Indicator style\n    if (roleIndicator) {\n      roleIndicator.textContent = isAdmin ? 'Portail Administrateur Garanti' : 'Vue Restreinte — Admin uniquement';\n      roleIndicator.className = isAdmin ? 'status-badge status-payable' : 'status-badge status-brouillon';\n    }\n\n    // 2. Restricted View for non-admin profiles\n    if (!isAdmin) {\n      mainView.innerHTML = `\n        <div class=\"admin-restricted-box\">\n          <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#C0553D\" stroke-width=\"2\" style=\"margin: 0 auto 16px;\">\n            <rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\" ry=\"2\"/>\n            <path d=\"M7 11V7a5 5 0 0 1 10 0v4\"/>\n          </svg>\n          <h2 style=\"font-family:'Lora',serif; font-size:19px; font-weight:800; margin-bottom:10px; color:var(--ink);\">Accès Administratif Protégé</h2>\n          <p style=\"font-size:13px; color:var(--stone); margin-bottom:20px; line-height:1.55;\">\n            Thomas Martin, vous êtes actuellement authentifié en tant que <b>Conseiller de terrain</b>. Les tableaux de synthèses de l'agence, l'audit-log d'activité et la configuration des automatisations exigent un profil d'administrateur.\n          </p>\n          <button class=\"thick-btn-action\" style=\"max-width:320px; margin: 0 auto;\" onclick=\"forceSwitchToAdminSarah()\">\n            Basculer sur le profil de Sarah (Admin)\n          </button>\n        </div>\n      `;\n      return;\n    }\n\n    // Load elements from global store database\n    const properties = store.getProperties();\n    const deals = store.getDeals();\n    const commissions = store.getCommissions();\n    const transfers = store.getTransfers();\n\n    // Sum calculation for KPI Cards dynamically filtered by agent\n    let kpiCA = 3845000;\n    let kpiComs = 142350;\n    let kpiBiensActifs = 38;\n    let kpiVentesConclues = 22;\n    let subTrendCA = \"+ 520 000 € ce mois\";\n    let subTrendComs = \"+ 18 420 € ce mois\";\n    let subTrendBiensActifs = \"+ 6 ce mois\";\n    let subTrendVentesConclues = \"+ 4 ce mois\";\n    let activeAgentName = \"Global Agence\";\n\n    if (selectedAgentKPI === 'lucas') {\n      kpiCA = 1850000;\n      kpiComs = 42850;\n      kpiBiensActifs = 15;\n      kpiVentesConclues = 8;\n      subTrendCA = \"Lucas - Top Vendeur de l'agence\";\n      subTrendComs = \"Lucas - 42.850 € cumulés\";\n      subTrendBiensActifs = \"Lucas - Bruxelles & Brabant\";\n      subTrendVentesConclues = \"Lucas - 8 ventes bouclées\";\n      activeAgentName = \"Lucas Martin\";\n    } else if (selectedAgentKPI === 'sarah') {\n      kpiCA = 1310000;\n      kpiComs = 31240;\n      kpiBiensActifs = 12;\n      kpiVentesConclues = 6;\n      subTrendCA = \"Sarah - Volume d'agence\";\n      subTrendComs = \"Sarah - 31.240 € ouverts\";\n      subTrendBiensActifs = \"Sarah - Uccle & Ixelles\";\n      subTrendVentesConclues = \"Sarah - 6 ventes d'excellence\";\n      activeAgentName = \"Sarah Vermeulen\";\n    } else if (selectedAgentKPI === 'adam') {\n      kpiCA = 850000;\n      kpiComs = 18760;\n      kpiBiensActifs = 9;\n      kpiVentesConclues = 4;\n      subTrendCA = \"Adam - Liège & périphérie\";\n      subTrendComs = \"Adam - 18.760 € cumulés\";\n      subTrendBiensActifs = \"Adam - 9 mandats actifs\";\n      subTrendVentesConclues = \"Adam - 4 deals signés\";\n      activeAgentName = \"Adam Dubois\";\n    } else if (selectedAgentKPI === 'nora') {\n      kpiCA = 720000;\n      kpiComs = 24310;\n      kpiBiensActifs = 8;\n      kpiVentesConclues = 3;\n      subTrendCA = \"Nora - Namur & environs\";\n      subTrendComs = \"Nora - 24.310 € de commissions\";\n      subTrendBiensActifs = \"Nora - 1 tâche de retard\";\n      subTrendVentesConclues = \"Nora - 3 signatures\";\n      activeAgentName = \"Nora Peeters\";\n    } else if (selectedAgentKPI === 'thomas') {\n      kpiCA = 640000;\n      kpiComs = 15200;\n      kpiBiensActifs = 6;\n      kpiVentesConclues = 2;\n      subTrendCA = \"Thomas - Wavre & Brabant\";\n      subTrendComs = \"Thomas - 15.200 € commission\";\n      subTrendBiensActifs = \"Thomas - 0 tâche de retard 🎉\";\n      subTrendVentesConclues = \"Thomas - 2 ventes\";\n      activeAgentName = \"Thomas Martin\";\