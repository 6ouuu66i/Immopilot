n:center; font-weight:800;\">26 <span style=\"display:block; font-size:9.5px; color:var(--forest); font-family:monospace;\">+2</span></td>\n                  <td style=\"text-align:center; font-weight:800;\">22 % <span style=\"display:block; font-size:9.5px; color:var(--forest); font-family:monospace;\">+4%</span></td>\n                  <td style=\"text-align:center; font-weight:800;\">7 <span style=\"display:block; font-size:9.5px; color:var(--forest); font-family:monospace;\">+1</span></td>\n                  <td style=\"text-align:right; font-weight:800;\">24 310 € <span style=\"display:block; font-size:9.5px; color:var(--forest); font-family:monospace;\">+4 210€</span></td>\n                  <td style=\"text-align:center;\"><div class=\"delayed-tasks-box\" style=\"background:#EBF7EE; border-color:var(--forest); color:var(--forest);\">1</div></td>\n                  <td><button class=\"dot-menu-icon\" onclick=\"event.stopPropagation(); triggerAgentAction('Nora Peeters')\">⋮</button></td>\n                </tr>\n\n                <!-- Row 5: Thomas Martin -->\n                <tr onclick=\"selectAgentKPI('thomas')\" class=\"${selectedAgentKPI === 'thomas' ? 'top-performer-tr-bg' : ''}\" style=\"cursor: pointer; transition: background 150ms; outline: ${selectedAgentKPI === 'thomas' ? '2px solid var(--forest)' : 'none'};\">\n                  <td>\n                    <div style=\"display:flex; align-items:center; gap:10px;\">\n                      <img src=\"https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=80&q=80\" style=\"width:30px; height:30px; border-radius:10px 150px 10px 150px; border:1px solid var(--stone);\" />\n                      <div>\n                        <strong style=\"font-family:'Lora',serif; font-size:13px; color: ${selectedAgentKPI === 'thomas' ? 'var(--forest)' : 'var(--ink)'};\">Thomas Martin</strong><br>\n                        <span style=\"font-size:10px; color:var(--stone-light);\">Conseiller de terrain (Vous)</span>\n                      </div>\n                    </div>\n                  </td>\n                  <td style=\"color:var(--stone-light); font-size:11.5px;\">Wavre Centre</td>\n                  <td style=\"text-align:center; font-weight:800;\">18 <span style=\"display:block; font-size:9.5px; color:var(--forest); font-family:monospace;\">+2</span></td>\n                  <td style=\"text-align:center; font-weight:800;\">21 % <span style=\"display:block; font-size:9.5px; color:var(--forest); font-family:monospace;\">+1%</span></td>\n                  <td style=\"text-align:center; font-weight:800;\">5 <span style=\"display:block; font-size:9.5px; color:var(--forest); font-family:monospace;\">+1</span></td>\n                  <td style=\"text-align:right; font-weight:800;\">15 200 € <span style=\"display:block; font-size:9.5px; color:var(--forest); font-family:monospace;\">+2 100€</span></td>\n                  <td style=\"text-align:center;\"><div class=\"delayed-tasks-box\" style=\"background:#EBF7EE; border-color:var(--forest); color:var(--forest);\">0</div></td>\n                  <td><button class=\"dot-menu-icon\" onclick=\"event.stopPropagation(); triggerAgentAction('Thomas Martin')\">⋮</button></td>\n                </tr>\n              </tbody>\n            </table>\n          </div>\n          <div style=\"text-align:center; padding-top:10px; border-top: 1px dashed var(--sand-deep);\">\n            <span style=\"font-family:'Lora',serif; font-size:11.5px; color:var(--stone-light);\">Astuce : Cliquez sur une ligne de tableau d'un agent pour isoler sa performance ses KPIs ci-dessus.</span>\n          </div>\n        </div>\n\n        <!-- COLUMN 2: Validation des transferts de Leads -->\n        <div class=\"admin-board\" id=\"transfer-logs-board-card\">\n          <div class=\"admin-board-title-row\">\n            <div>\n              <h3>\n                <svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                  <polyline points=\"16 3 21 8 16 13\"></polyline>\n                  <line x1=\"21\" y1=\"8\" x2=\"9\" y2=\"8\"></line>\n                  <polyline points=\"8 21 3 16 8 11\"></polyline>\n                  <line x1=\"3\" y1=\"16\" x2=\"15\" y2=\"16\"></line>\n                </svg>\n                Validation des transferts de Leads\n              </h3>\n            </div>\n            <div>\n              <!-- Tabbed Badge group -->\n              <div class=\"badge-tab-list\">\n                <button class=\"badge-tab-item active\" id=\"tab-tr-tous\" onclick=\"setTransferTab('tous')\">Tous <span class=\"badge-tab-counter\" id=\"cnt-tr-all\">0</span></button>\n                <button class=\"badge-tab-item\" id=\"tab-tr-en_attente\" onclick=\"setTransferTab('en_attente')\">Attentes <span class=\"badge-tab-counter\" id=\"cnt-tr-pending\">0</span></button>\n                <button class=\"badge-tab-item\" id=\"tab-tr-accepte\" onclick=\"setTransferTab('accepte')\">Validés <span class=\"badge-tab-counter\" id=\"cnt-tr-accepted\">0</span></button>\n                <button class=\"badge-tab-item\" id=\"tab-tr-refuse\" onclick=\"setTransferTab('refuse')\">Rejetés <span class=\"badge-tab-counter\" id=\"cnt-tr-rejected\">0</span></button>\n              </div>\n            </div>\n          </div>\n\n          <!-- Header layout row -->\n          <div style=\"max-height:300px; overflow-y:auto; padding-right:2px;\">\n            <table class=\"custom-table\" style=\"font-size:12px;\">\n              <thead>\n                <tr>\n                  <th>Bien / Deal</th>\n                  <th>De</th>\n                  <th>Vers</th>\n                  <th>Raison d'attribution</th>\n                  <th>Statut</th>\n                  <th>Demande le</th>\n                  <th style=\"width: 70px;\">Action</th>\n                </tr>\n              </thead>\n              <tbody id=\"transfer-requests-table-body\">\n                <!-- Filled dynamically by custom JS logic -->\n              </tbody>\n            </table>\n          </div>\n          <div style=\"text-align:center; margin-top:14px; border-top: 1px dashed var(--sand-deep); padding-top: 8px;\">\n            <span class=\"footer-handwritten-link\" onclick=\"window.location.hash='#notifications'\">Ouvrir l'intégralité du centre de notifications d'agence →</span>\n          </div>\n        </div>\n\n      </div>\n\n      <!-- BOTTOM ROW OF 3 CONFIGURATION MODULES -->\n      <div class=\"admin-bottom-grid-3\">\n        <!-- BOTTOM PANEL 1: Configuration pipeline (Éditeur d'étapes de pipeline) -->\n        <div class=\"admin-board\" style=\"display:flex; flex-direction:column; justify-content:space-between;\">\n          <div>\n            <h3 class=\"panel-title\" style=\"font-family:'Lora',serif; font-size:16px; font-weight:800; color:var(--ink); display:flex; align-items:center; gap:8px;\">\n              <svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                <polygon points=\"5 3 19 12 5 21 5 3\"></polygon>\n              </svg>\n              Éditeur d'étapes de pipeline\n            </h3>\n            <div class=\"panel-subtitle\" style=\"font-size:11.5px; color:var(--stone); margin-bottom:12px;\">Planifiez et ordonnez les phases de vente Kanban. Survolez pour réordonner ou renommer.</div>\n\n            <!-- The dynamic horizontal workflow cards -->\n            <div class=\"pipeline-stages-container\" style=\"display:grid; grid-template-columns:repeat(4, 1fr); gap:8px; margin-bottom:12px; max-height: 200px; overflow-y: auto; padding: 4px;\">\n              ${stagesHtml}\n            </div>\n          </div>\n\n          <!-- Small control bar to append a stage -->\n          <div style=\"border-top: 1px dashed var(--sand-deep); padding-top:10px; margin-top:8px;\">\n            <label style=\"display:block; font-family:'JetBrains Mono',monospace; font-size:10px; font-weight:750; color:var(--stone); margin-bottom:4px;\">AJOUTER UNE ÉTAPE AU PIPELINE :</label>\n            <div style=\"display:flex; gap:6px;\">\n              <input type=\"text\" id=\"new-stage-title-input\" placeholder=\"Ex : Signature de Compromis...\" class=\"select-retro\" style=\"flex:1; padding:6px 10px; font-size:11.5px; background:#FFFFFF; border:1px solid var(--stone); border-radius:4px;\" />\n              <button class=\"thick-btn-action\" onclick=\"addNewPipelineStage()\" style=\"width:auto; padding: 6px 12px; font-size:11px; font-family:'JetBrains Mono',monospace; border-radius:6px; box-shadow: 1px 1px 0 var(--ink);\">Ajouter</button>\n            </div>\n            <div style=\"display:flex; justify-content:flex-end; margin-top:6px;\">\n              <button onclick=\"resetPipelineStagesToDefault()\" style=\"background:none; border:none; text-decoration:underline; font-family:'JetBrains Mono'; font-size:9px; color:var(--stone-light); cursor:pointer;\">Réinitialiser par défaut</button>\n            </div>\n          </div>\n        </div>\n\n        <!-- BOTTOM PANEL 2: Configuration commissions (Curseurs commission) -->\n        <div class=\"admin-board\" style=\"display:flex; flex-direction:column; justify-content:space-between;\">\n          <div>\n            <h3 class=\"panel-title\" style=\"font-family:'Lora',serif; font-size:16px; font-weight:800; color:var(--ink); display:flex; align-items:center; gap:8px;\">\n              <svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                <line x1=\"12\" y1=\"1\" x2=\"12\" y2=\"23\"></line>\n                <path d=\"M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6\"></path>\n              </svg>\n              Configuration commissions\n            </h3>\n            <div class=\"panel-subtitle\" style=\"font-size:11.5px; color:var(--stone); margin-bottom:14px;\">Ajustez avec les curseurs ci-dessous les commissions courantes.</div>\n\n            <!-- Sliders -->\n            <div class=\"retro-input-wrapper\" style=\"margin-bottom:16px;\">\n              <div style=\"display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;\">\n                <label style=\"margin:0;\">Pourcentage par défaut :</label>\n                <span style=\"font-family:'JetBrains Mono',monospace; font-weight:800; color:var(--forest); font-size:13.5px;\"><span id=\"cfg-commission-pct-val\">3.00</span> %</span>\n              </div>\n              <input type=\"range\" id=\"cfg-commission-pct\" min=\"1.0\" max=\"10.0\" step=\"0.1\" value=\"3.0\" oninput=\"document.getElementById('cfg-commission-pct-val').textContent = parseFloat(this.value).toFixed(2)\" style=\"width:100%; height:8px; background:var(--sand-deep); outline:none; border-radius:4px; accent-color:var(--forest); cursor:pointer;\" />\n            </div>\n\n            <div class=\"retro-input-wrapper\" style=\"margin-bottom:16px;\">\n              <div style=\"display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;\">\n                <label style=\"margin:0;\">Frais fixes d'agence :</label>\n                <span style=\"font-family:'JetBrains Mono',monospace; font-weight:800; color:var(--forest); font-size:13.5px;\"><span id=\"cfg-commission-fixes-val\">1250</span> €</span>\n              </div>\n              <input type=\"range\" id=\"cfg-commission-fixes\" min=\"0\" max=\"5000\" step=\"250\" value=\"1250\" oninput=\"document.getElementById('cfg-commission-fixes-val').textContent = this.value\" style=\"width:100%; height:8px; background:var(--sand-deep); outline:none; border-radius:4px; accent-color:var(--forest); cursor:pointer;\" />\n            </div>\n\n            <div class=\"retro-input-wrapper\" style=\"margin-bottom:12px;\">\n              <label>TVA applicable aux dossiers</label>\n              <select id=\"cfg-commission-tva\" class=\"select-retro\" style=\"width:100%; background:#FFFFFF; padding:6px 10px; border:1px solid var(--stone); border-radius:4px;\">\n                <option value=\"21\" selected>21 % (Taux plein belge)</option>\n                <option value=\"6\">6 % (Frais réduits)</option>\n                <option value=\"0\">0 % (Exonération d'agence)</option>\n              </select>\n            </div>\n\n            <label class=\"checkbox-container-custom\" style=\"display:flex; align-items:center; gap:8px; margin: 0 0 8px 0;\">\n              <input type=\"checkbox\" id=\"cfg-apply-new\" checked style=\"cursor:pointer;\" />\n              <span style=\"font-size:11px; color:var(--stone-light);\">Mettre à jour automatiquement les dossiers en cours</span>\n            </label>\n          </div>\n\n          <!-- Button -->\n          <div style=\"margin-top:12px;\">\n            <button class=\"thick-btn-action\" onclick=\"saveComsSettings()\" style=\"padding: 8px 16px; border-radius:8px; font-size:11.5px; box-shadow: 2px 2px 0 var(--ink);\">\n              Enregistrer les paramètres\n            </button>\n          </div>\n        </div>\n\n        <!-- BOTTOM PANEL 3: Statut de synchronisation des sources -->\n        <div class=\"admin-board\" style=\"display:flex; flex-direction:column; justify-content:space-between;\">\n          <div>\n            <h3 class=\"panel-title\" style=\"font-family:'Lora',serif; font-size:16px; font-weight:800; color:var(--ink); display:flex; align-items:center; gap:8px;\">\n              <svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">\n                <polyline points=\"23 4 23 10 17 10\"></polyline>\n                <polyline points=\"1 20 1 14 7 14\"></polyline>\n                <path d=\"M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15\"></path>\n              </svg>\n              Synchronisation des sources\n            </h3>\n            <div class=\"panel-subtitle\" style=\"font-size:11.5px; color:var(--stone); margin-bottom:12px;\">État des connexions automatiques sur les portails belges.</div>\n\n            <!-- Interlocking Sync List -->\n            <div style=\"display:flex; flex-direction:column; gap:8px;\">\n               ${portalsHtml}\n            </div>\n          </div>\n\n          <div style=\"text-align:center; margin-top:12px; border-top:1px dashed var(--sand-deep); padding-top:6px;\">\n            <span class=\"footer-handwritten-link\" onclick=\"forceSyncAllPortals()\" style=\"font-size:11px;\">🔄 Lancer une resynchronisation générale</span>\n          </div>\n        </div>\n      </div>\n    `;\n\n    // Fetch and display active lists in logs transfer\n    renderTransfersGrid();\n  }\n\n  // Interactivity to filter and manage transfers list\n  window.setTransferTab = function(status) {\n    selectedTransferTab = status;\n    \n    // Update active UI classes of tabs\n    const buttons = ['tous', 'en_attente', 'accepte', 'refuse'];\n    buttons.forEach(btnKey => {\n      const el = document.getElementById('tab-tr-' + btnKey);\n      if (el) {\n        if (btnKey === status) el.classList.add('active');\n        else el.classList.remove('active');\n      }\n    });\n\n    renderTransfersGrid();\n  };\n\n  function renderTransfersGrid() {\n    const tableBody = document.getElementById('transfer-requests-table-body');\n    if (!tableBody) return;\n\n    const transfers = store.getTransfers();\n    const agents = store.getAgents();\n    const properties = store.getProperties();\n\n    // High fidelity counter values in tabs from both store and screenshot defaults\n    const pendingTrans = transfers.filter(x => x.status === 'en_attente');\n    const acceptedTrans = transfers.filter(x => x.status === 'accepté');\n    const rejectedTrans = transfers.filter(x => x.status === 'refusé');\n\n    const totalCounter = 16 + transfers.length; \n    \n    // Safety check on elements existence before updating text\n    const allEl = document.getElementById('cnt-tr-al