export default "<div class=\"agenda-page\">\n  <!-- CSS Styles local to Notifications & Transfers -->\n  <style>\n    .agenda-page {\n      display: flex;\n      flex-direction: column;\n      padding: 18px 22px 40px;\n      min-width: 0;\n      flex: 1;\n      height: 100%;\n      overflow-y: auto;\n      \n      background-color: #FBF9F4 !important; /* Premium warm paper sheet background */\n      background-image: \n        /* Soft red margin vertical line typical of high-quality notebooks */\n        linear-gradient(90deg, transparent 55px, rgba(200, 85, 61, 0.24) 55px, rgba(200, 85, 61, 0.24) 57px, transparent 57px),\n        /* Delicate forest-green grid lines to emphasize the sketched vibe */\n        linear-gradient(rgba(30, 90, 58, 0.08) 1px, transparent 1px),\n        linear-gradient(90deg, rgba(30, 90, 58, 0.08) 1px, transparent 1px) !important;\n      background-size: 100% 100%, 20px 20px, 20px 20px !important;\n    }\n\n    .agenda-header {\n      display: flex;\n      flex-direction: column;\n      gap: 14px;\n      margin-bottom: 28px;\n    }\n\n    .agenda-header-top {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 14px;\n      width: 100%;\n      flex-wrap: wrap;\n    }\n\n    .agenda-title {\n      display: flex;\n      flex-direction: column;\n      gap: 5px;\n    }\n\n    .agenda-title h1 {\n      font-family: 'Lora', Georgia, serif;\n      font-size: 24px;\n      font-weight: 750;\n      letter-spacing: -0.015em;\n      margin: 0;\n      color: var(--ink);\n    }\n\n    .agenda-title h1::before {\n      content: '';\n      display: inline-block;\n      width: 4px;\n      height: 18px;\n      background: var(--forest);\n      margin-right: 10px;\n      vertical-align: -2px;\n      border-radius: 99px;\n    }\n\n    .agenda-subtitle {\n      font-size: 13px;\n      color: var(--stone);\n      margin-left: 14px;\n      line-height: 1.4;\n    }\n\n    .tab-btn {\n      padding: 7px 16px;\n      font-size: 11.5px;\n      font-weight: 700;\n      font-family: 'JetBrains Mono', monospace;\n      border: 1.5px solid var(--stone);\n      border-radius: 180px 15px 150px 15px/15px 150px 15px 180px;\n      background: #FFFDF7;\n      cursor: pointer;\n      color: var(--stone);\n      transition: all 120ms;\n      box-shadow: 1.5px 1.5px 0px var(--stone);\n    }\n\n    .tab-btn:hover {\n      background: var(--forest);\n      color: #FFFDF7;\n      border-color: var(--forest);\n      box-shadow: 2px 2px 0px var(--ink);\n      transform: translate(-0.5px, -0.5px);\n    }\n\n    .notifs-container {\n      margin-right: 22px;\n      display: grid;\n      grid-template-columns: 1.8fr 1.2fr;\n      gap: 28px;\n      align-items: start;\n    }\n\n    @media (max-width: 900px) {\n      .notifs-container {\n        grid-template-columns: 1fr;\n        gap: 24px;\n      }\n    }\n\n    .notifs-list {\n      display: flex;\n      flex-direction: column;\n      gap: 14px;\n    }\n\n    /* Sketch custom Card block */\n    .notif-card {\n      background: #FFFFFF;\n      border: 1.5px solid var(--stone);\n      border-radius: 10px;\n      padding: 16px 20px;\n      box-shadow: 2.2px 2.2px 0px var(--sand-deep);\n      display: flex;\n      gap: 16px;\n      align-items: flex-start;\n      transition: border-color 155ms ease, box-shadow 155ms ease, transform 120ms ease;\n      position: relative;\n      cursor: pointer;\n    }\n\n    .notif-card:hover {\n      border-color: var(--forest);\n      box-shadow: 3.5px 3.5px 0px var(--forest-soft);\n      transform: translateY(-1.5px);\n    }\n\n    .notif-card.unread {\n      border-left: 5px solid var(--forest);\n      background: #F4FAF6; /* Soft premium green indicator context */\n    }\n\n    .notif-unread-dot {\n      width: 8px;\n      height: 8px;\n      background: #C0553D; /* warm rose-red ink */\n      border-radius: 50%;\n      position: absolute;\n      top: 18px;\n      right: 18px;\n      border: 1.2px solid var(--ink);\n    }\n\n    .notif-icon-box {\n      width: 36px;\n      height: 36px;\n      border-radius: 180px 15px 150px 15px/15px 150px 15px 180px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      background: var(--sand);\n      border: 1.5px solid var(--stone);\n      flex-shrink: 0;\n      font-size: 15px;\n      color: var(--forest);\n      box-shadow: 1px 1px 0px rgba(0,0,0,0.06);\n    }\n\n    .notif-content {\n      flex: 1;\n      padding-right: 12px;\n    }\n\n    .notif-content h4 {\n      margin: 0 0 5px 0;\n      font-family: 'Lora', Georgia, serif;\n      font-size: 14px;\n      font-weight: 700;\n      color: var(--ink);\n    }\n\n    .notif-content p {\n      margin: 0;\n      font-size: 12.5px;\n      color: var(--stone);\n      line-height: 1.55;\n    }\n\n    .notif-meta {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      margin-top: 10px;\n      border-top: 1px dashed var(--sand-deep);\n      padding-top: 8px;\n    }\n\n    .notif-time {\n      font-family: 'JetBrains Mono', monospace;\n      font-size: 10.5px;\n      color: var(--stone-light);\n    }\n\n    .notif-link {\n      font-size: 11.5px;\n      color: var(--forest);\n      text-decoration: underline;\n      cursor: pointer;\n      font-family: 'JetBrains Mono', monospace;\n      font-weight: 600;\n    }\n    .notif-link:hover {\n      color: var(--indigo, #2B3A8C);\n    }\n\n    /* Side panel transfers */\n    .transfer-box {\n      background: #FFFFFF;\n      border: 1.5px solid var(--stone);\n      border-radius: 12px;\n      padding: 18px 20px;\n      box-shadow: 2.2px 2.5px 0px var(--sand-deep);\n      margin-bottom: 20px;\n      transition: border-color 150ms ease, box-shadow 150ms ease, transform 120ms ease;\n    }\n\n    .transfer-box:hover {\n      border-color: var(--forest);\n      box-shadow: 3.5px 4px 0px var(--forest-soft);\n      transform: translateY(-1px);\n    }\n\n    .transfer-box h4 {\n      font-family: 'Lora', Georgia, serif;\n      font-size: 14px;\n      font-weight: 700;\n      margin: 0 0 6px 0;\n      color: var(--ink);\n    }\n\n    .transfer-action-row {\n      display: flex;\n      gap: 10px;\n      margin-top: 14px;\n    }\n\n    .btn-accept {\n      background: var(--forest);\n      color: #FFFDF7;\n      border: 1.5px solid var(--stone);\n      border-radius: 180px 12px 150px 12px/12px 150px 12px 180px;\n      padding: 6px 14px;\n      font-size: 11.5px;\n      font-family: 'JetBrains Mono', monospace;\n      cursor: pointer;\n      font-weight: 700;\n      transition: all 120ms ease;\n      box-shadow: 1px 1.5px 0px var(--stone);\n    }\n\n    .btn-accept:hover {\n      background: rgba(30, 90, 58, 0.95);\n      border-color: var(--forest);\n      box-shadow: 2px 2.5px 0px var(--ink);\n      transform: translate(-0.5px, -0.5px);\n    }\n\n    .btn-accept:active {\n      transform: translate(0.5px, 0.5px);\n      box-shadow: 0.5px 0.5px 0px var(--ink);\n    }\n\n    .btn-refuse {\n      background: #FFFDF7;\n      color: #C0553D; /* warm reddish rose */\n      border: 1.5px solid var(--stone);\n      border-radius: 180px 12px 150px 12px/12px 150px 12px 180px;\n      padding: 6px 14px;\n      font-size: 11.5px;\n      font-family: 'JetBrains Mono', monospace;\n      cursor: pointer;\n      font-weight: 700;\n      transition: all 120ms ease;\n      box-shadow: 1px 1.5px 0px var(--stone);\n    }\n\n    .btn-refuse:hover {\n      background: #FDF4F2;\n      color: #C0553D;\n      box-shadow: 2px 2.5px 0px var(--ink);\n      transform: translate(-0.5px, -0.5px);\n    }\n\n    .btn-refuse:active {\n      transform: translate(0.5px, 0.5px);\n      box-shadow: 0.5px 0.5px 0px var(--ink);\n    }\n\n    .section-title {\n      font-family: 'Lora', Georgia, serif;\n      font-size: 16px;\n      font-weight: 750;\n      color: var(--ink);\n      margin-bottom: 16px;\n      display: flex;\n      align-items: center;\n      gap: 8px;\n    }\n  </style>\n\n  <!-- Title section -->\n  <div class=\"agenda-header\">\n    <div class=\"agenda-header-top\">\n      <div class=\"agenda-title\">\n        <h1>Notifications & Successions</h1>\n        <div class=\"agenda-subtitle\">Boîtes d'alertes instantanées et validation des successions de mandats immobiliers</div>\n      </div>\n      <div>\n        <button class=\"tab-btn\" onclick=\"triggerMarkAllRead()\">Tout marquer comme lu</button>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"notifs-container\">\n    <!-- LEFT: System Notifications -->\n    <div>\n      <h3 class=\"section-title\">📯 Dernières alertes & activités</h3>\n      <div class=\"notifs-list\" id=\"notifications-list-wrapper\">\n        <!-- Load items dynamically -->\n      </div>\n    </div>\n\n    <!-- RIGHT: Direct Interactive Transfers manager -->\n    <div>\n      <h3 class=\"section-title\">🤝 Décisions Transferts de Dossier</h3>\n      <p style=\"font-size:12.5px; color:var(--stone); margin-bottom:16px; line-height:1.55;\">\n        Lorsqu'un conseiller de l'agence demande la reprise ou le transfert d'un bien en négociation active, la décision est soumise en suspense. Tranchez la demande à l'aide des actions ci-dessous :\n      </p>\n      \n      <div class=\"transfers-decisions-list\" id=\"transfers-decisions-wrapper\">\n        <!-- Actionable transfer requests -->\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\n(function() {\n  const store = window.ImmoPilotStore;\n  if (!store) return;\n\n  function renderAlerts() {\n    const listWrapper = document.getElementById('notifications-list-wrapper');\n    const decisionsWrapper = document.getElementById('transfers-decisions-wrapper');\n    if (!listWrapper || !decisionsWrapper) return;\n\n    const notifs = store.getNotifications();\n    const transfers = store.getTransfers();\n    const currentAgent = store.getCurrentAgent();\n\n    // 1. Render Notifications list\n    if (notifs.length === 0) {\n      listWrapper.innerHTML = `\n        <div class=\"notif-card\" style=\"justify-content:center; color:var(--stone); padding: 32px 20px; border-style: dashed;\">\n          Aucune notification pour le moment.\n        </div>\n      `;\n    } else {\n      listWrapper.innerHTML = notifs.map(n => {\n        // Simple visual icon mappings\n        let iconMarkup = '<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9\"/><path d=\"M13.73 21a2 2 0 0 1-3.46 0\"/></svg>';\n        if (n.type === 'transfer_accepted') iconMarkup = '✔️';\n        else if (n.type === 'transfer_refused') iconMarkup = '❌';\n        else if (n.type === 'commission_ready') iconMarkup = '💰';\n        else if (n.type === 'task_due') iconMarkup = '📅';\n\n        return `\n          <div class=\"notif-card ${n.read ? '' : 'unread'}\" onclick=\"markAsRead('${n.id}')\">\n            ${n.read ? '' : '<div class=\"notif-unread-dot\"></div>'}\n            <div class=\"notif-icon-box\">${iconMarkup}</div>\n            <div class=\"notif-content\">\n              <h4>${n.title}</h4>\n              <p>${n.text}</p>\n              <div class=\"notif-meta\">\n                <span class=\"notif-time\">${n.date}</span>\n                <a class=\"notif-link\" href=\"${n.actionLink}\" onclick=\"event.stopPropagation()\">Ouvrir l'onglet lié &rsaquo;</a>\n              </div>\n            </div>\n          </div>\n        `;\n      }).join('');\n    }\n\n    // 2. Render transfers selector decision helper\n    const pendingTransfers = transfers.filter(t => t.status === 'en_attente');\n    \n    if (pendingTransfers.length === 0) {\n      decisionsWrapper.innerHTML = `\n        <div class=\"transfer-box\" style=\"text-align:center; color:var(--stone); border-style:dashed; padding: 32px 20px; background: transparent;\">\n          Aucune demande de transfert en suspens pour le moment.\n        </div>\n      `;\n    } else {\n      decisionsWrapper.innerHTML = pendingTransfers.map(t => {\n        const prop = store.getProperty(t.propertyId);\n        const sender = store.getAgents().find(a => a.id === t.toAgentId)?.name || 'Un conseiller';\n        const owner = store.getAgents().find(a => a.id === t.fromAgentId)?.name || 'Ancien conseiller';\n\n        return `\n          <div class=\"transfer-box\">\n            <h4>${prop ? prop.title : 'Bien anonyme'}</h4>\n            <div style=\"font-size:11.5px; color:var(--stone); margin-bottom:10px; line-height: 1.5;\">\n              Demandeur : <strong style=\"color:var(--ink);\">${sender}</strong><br>\n              Propriétaire actuel : <strong style=\"color:var(--ink);\">${owner}</strong>\n            </div>\n            \n            <p style=\"font-size:11.5px; margin-bottom:14px; font-style:italic; border-left:2px solid var(--forest); padding-left:8px; color:var(--stone); line-height: 1.4;\">\n              « Souhaite reprendre la négociation active pour finaliser au plus vite. »\n            </p>\n            \n            <div class=\"transfer-action-row\">\n              <button class=\"btn-accept\" onclick=\"executeDecision('${t.id}', 'accepté')\">Accepter</button>\n              <button class=\"btn-refuse\" onclick=\"executeDecision('${t.id}', 'refusé')\">Refuser</button>\n            </div>\n          </div>\n        `;\n      }).join('');\n    }\n  }\n\n  // Action methods\n  window.markAsRead = function(id) {\n    store.markNotificationRead(id);\n    renderAlerts();\n  };\n\n  window.triggerMarkAllRead = function() {\n    store.markAllNotificationsRead();\n    renderAlerts();\n    \n    // Custom styled validation toast\n    const t = document.createElement('div');\n    t.style.cssText = \"position:fixed; bottom:24px; right:24px; background:#FFFFFF; color:var(--ink); border:2px solid var(--ink); padding:14px 22px; border-radius:180px 15px 150px 15px/15px 150px 15px 180px; font-family:'JetBrains Mono',monospace; font-size:12px; font-weight:700; box-shadow:4px 4px 0 var(--forest); z-index:9999;\";\n    t.textContent = `ALERTES : Toutes les notifications ont été marquées comme lues.`;\n    document.body.appendChild(t);\n    setTimeout(() => { t.remove(); }, 3000);\n  };\n\n  window.executeDecision = function(requestId, status) {\n    store.handleTransferRequest(requestId, status);\n    renderAlerts();\n\n    // Spawn tiny success validation toast\n    const t = document.createElement('div');\n    t.style.cssText = \"position:fixed; bottom:24px; right:24px; background:#FFFFFF; color:var(--ink); border:2px solid var(--ink); padding:14px 22px; border-radius:180px 15px 150px 15px/15px 150px 15px 180px; font-family:'JetBrains Mono',monospace; font-size:12px; font-weight:700; box-shadow:4px 4px 0 var(--forest); z-index:9999;\";\n    t.textContent = `TRANSFERT : Demande résolue avec le statut [${status.toUpperCase()}].`;\n    document.body.appendChild(t);\n    setTimeout(() => { t.remove(); }, 3000);\n  };\n\n  // Run immediately\n  renderAlerts();\n\n  // Listen for state changes\n  window.addEventListener('ip-state-changed', renderAlerts);\n  window.addEventListener('ip-agent-changed', renderAlerts);\n})();\n</script>\n"
//# sourceMappingURL=data:application/json;base64,