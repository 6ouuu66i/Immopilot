x;\n  border-radius: 999px;\n  background: var(--bone);\n  border: 1px solid var(--sand-deep);\n  display: grid; place-items: center;\n  font-size: 10px; font-weight: 700;\n  color: var(--stone);\n  flex-shrink: 0;\n}\n.mc-vendor-name { font-size: 11.5px; font-weight: 700; color: var(--ink); text-align: left; text-overflow: ellipsis; overflow: hidden; white-space: nowrap; }\n.mc-vendor-contact { display: flex; flex-direction: column; gap: 2px; font-size: 10px; color: var(--stone); }\n.mc-vendor-contact span {\n  display: flex; align-items: center; gap: 5px;\n  text-overflow: ellipsis; overflow: hidden; white-space: nowrap;\n}\n.mc-vendor-contact svg { color: var(--stone-light); flex-shrink: 0; }\n\n/* Mc Bien */\n.mc-bien-row { display: grid; grid-template-columns: 30px minmax(0, 1fr); gap: 8px; align-items: flex-start; }\n.mc-bien-icon {\n  width: 30px; height: 30px;\n  border-radius: 999px;\n  background: var(--forest-soft);\n  display: grid; place-items: center;\n  color: var(--forest);\n}\n.mc-bien-title { font-size: 11.5px; font-weight: 700; color: var(--ink); text-align: left; }\n.mc-bien-loc {\n  font-size: 10px; color: var(--stone); text-align: left;\n}\n.mc-bien-specs { font-size: 9.5px; color: var(--stone-light); text-align: left; }\n.mc-bien-link {\n  display: inline-flex; align-items: center; justify-content: center; gap: 4px;\n  margin-top: 8px; padding-top: 6px;\n  border-top: 1px solid var(--sand);\n  font-size: 10.5px; font-weight: 600;\n  color: var(--forest);\n  cursor: pointer;\n  background: none; border-left: 0; border-right: 0; border-bottom: 0;\n  transition: color 140ms;\n}\n.mc-bien-link:hover { color: var(--ink); }\n\n/* Tâches liées */\n.task-list { display: flex; flex-direction: column; gap: 6px; }\n.task-row {\n  display: grid;\n  grid-template-columns: 13px minmax(0, 1fr);\n  column-gap: 8px;\n  align-items: start;\n}\n.task-check {\n  width: 13px; height: 13px;\n  border: 1.5px solid var(--sand-deep);\n  border-radius: 3px;\n  background: #FFFFFF;\n  cursor: pointer;\n  flex-shrink: 0;\n  position: relative;\n  transition: all 140ms;\n  margin-top: 1.5px;\n}\n.task-check.checked {\n  background: var(--forest);\n  border-color: var(--forest);\n}\n.task-check.checked::after {\n  content: '';\n  position: absolute;\n  left: 3px; top: 0px;\n  width: 4px; height: 7px;\n  border-right: 1.5px solid #FFFFFF;\n  border-bottom: 1.5px solid #FFFFFF;\n  transform: rotate(45deg);\n}\n.task-name {\n  font-size: 11px; color: var(--ink); font-weight: 500;\n  line-height: 1.25;\n  text-align: left;\n}\n.task-row.done .task-name { text-decoration: line-through; color: var(--stone-light); }\n.task-meta {\n  grid-column: 2;\n  display: flex; align-items: center; gap: 6px;\n  margin-top: 2px;\n}\n.task-date {\n  font-size: 9px; color: var(--stone-light);\n  font-family: 'JetBrains Mono', monospace;\n}\n.prio-chip {\n  font-size: 9px; font-weight: 700;\n  padding: 1px 5px;\n  border-radius: 999px;\n  white-space: nowrap;\n}\n.prio-chip.haute { background: #FDF2F2; color: #C8553D; }\n.prio-chip.moy { background: #FFFDF5; color: #8A6C20; }\n.prio-chip.basse { background: var(--bone); color: var(--stone-light); }\n\n.add-task-link {\n  margin-top: 6px;\n  padding-top: 6px;\n  border-top: 1px solid var(--sand);\n  font-size: 10.5px;\n  font-weight: 600;\n  color: var(--forest);\n  background: none; border-left: 0; border-right: 0; border-bottom: 0;\n  cursor: pointer;\n  display: inline-flex; align-items: center; justify-content: center; gap: 4px;\n  width: 100%;\n}\n.add-task-link:hover { color: var(--ink); }\n.task-empty {\n  text-align: center;\n  padding: 10px 4px;\n  color: var(--stone-light);\n  font-size: 11px;\n  border: 1px dashed var(--sand-deep);\n  border-radius: 4px;\n}\n\n/* Notes */\n.notes-input-row { display: flex; gap: 4px; }\n.notes-input {\n  flex: 1;\n  height: 28px;\n  border: 1px solid var(--sand-deep);\n  border-radius: 5px;\n  padding: 0 8px;\n  font-size: 11px;\n  color: var(--ink);\n  background: var(--bone);\n  outline: none;\n}\n.notes-input:focus {\n  border-color: var(--forest);\n  background: #FFFFFF;\n}\n.notes-list { display: flex; flex-direction: column; gap: 8px; }\n.note-item {\n  display: grid; grid-template-columns: 22px 1fr; gap: 6px;\n  padding-bottom: 6px;\n  border-bottom: 1px solid var(--bone);\n}\n.note-item:last-child { border-bottom: none; }\n.note-avatar {\n  width: 22px; height: 22px;\n  border-radius: 999px;\n  background: var(--sand);\n  display: grid; place-items: center;\n  font-size: 9px; font-weight: 700;\n  color: var(--stone);\n  flex-shrink: 0;\n}\n.note-header { display: flex; align-items: center; justify-content: space-between; gap: 4px; margin-bottom: 2px; }\n.note-author { font-size: 10.5px; font-weight: 600; color: var(--ink); }\n.note-date { font-size: 9px; color: var(--stone-light); font-family: 'JetBrains Mono', monospace; }\n.note-text { font-size: 10.5px; color: var(--ink); line-height: 1.35; text-align: left; }\n\n/* Commission */\n.commission-row {\n  display: flex; align-items: center; justify-content: space-between;\n  gap: 6px;\n  padding: 4px 0;\n  font-size: 11px;\n  border-bottom: 1px solid var(--bone);\n}\n.commission-row:last-of-type { border-bottom: none; }\n.commission-row .ck { color: var(--stone); }\n.commission-row .cv { color: var(--ink); font-weight: 500; }\n.commission-row .cv.amount { font-size: 12px; font-weight: 700; color: var(--forest); }\n.commission-status {\n  display: inline-flex; align-items: center;\n  padding: 2px 7px;\n  border-radius: 999px;\n  font-size: 10px; font-weight: 600;\n  background: var(--forest-soft);\n  color: var(--forest);\n}\n.btn-commission {\n  margin-top: 6px;\n  width: 100%;\n  height: 28px;\n  background: #FFFFFF;\n  color: var(--forest);\n  border: 1px solid var(--sand-deep);\n  border-radius: 5px;\n  font-size: 11px;\n  font-weight: 600;\n  cursor: pointer;\n  display: inline-flex; align-items: center; justify-content: center; gap: 4px;\n  transition: all 140ms;\n}\n.btn-commission:hover { background: var(--bone); border-color: var(--stone-light); }\n\n/* Activités */\n.activity-list { display: flex; flex-direction: column; gap: 8px; }\n.activity-row {\n  display: grid;\n  grid-template-columns: 8px minmax(0, 1fr);\n  column-gap: 8px;\n  align-items: start;\n}\n.activity-dot {\n  width: 8px; height: 8px;\n  border-radius: 999px;\n  background: var(--forest);\n  margin-top: 3px;\n  box-shadow: 0 0 0 2px rgba(30,90,58,0.10);\n}\n.activity-dot.pending {\n  background: #FFFFFF;\n  border: 1.5px solid var(--sand-deep);\n  box-shadow: none;\n  cursor: pointer;\n}\n.activity-row.pending .activity-title { color: var(--stone); font-weight: 500; }\n.activity-title { font-size: 11px; color: var(--ink); font-weight: 600; text-align: left; }\n.activity-meta {\n  display: flex; align-items: center; justify-content: space-between;\n  gap: 4px;\n}\n.activity-author { font-size: 10px; color: var(--stone); text-align: left; }\n.activity-date { font-size: 9px; color: var(--stone-light); font-family: 'JetBrains Mono', monospace; white-space: nowrap; }\n\n/* Actions */\n.fiche-actions {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 8px;\n  padding: 12px 16px 16px;\n  border-top: 1px solid var(--sand-deep);\n  background: #FFFFFF;\n  margin-top: auto;\n}\n.fiche-actions .btn {\n  display: inline-flex; align-items: center; justify-content: center;\n  gap: 6px;\n  height: 36px;\n  border-radius: 6px;\n  font-size: 12px; font-weight: 600;\n  cursor: pointer;\n  border: 1px solid transparent;\n  transition: all 140ms;\n}\n.fiche-actions .btn-secondary {\n  background: #FFFFFF;\n  color: var(--ink);\n  border-color: var(--sand-deep);\n}\n.fiche-actions .btn-secondary:hover { border-color: var(--stone-light); background: var(--bone); }\n.fiche-actions .btn-primary {\n  background: var(--forest);\n  color: #FFFFFF;\n  transition: background 140ms;\n}\n.fiche-actions .btn-primary:hover { background: #174A2F; }\n\n/* Dropdown menu for stages */\n.stage-menu {\n  position: absolute;\n  bottom: calc(100% + 6px);\n  right: 0;\n  background: #FFFFFF;\n  border: 1px solid var(--sand-deep);\n  border-radius: 8px;\n  box-shadow: 0 4px 14px rgba(29,31,30,0.12);\n  padding: 4px;\n  display: none;\n  flex-direction: column;\n  min-width: 160px;\n  z-index: 200;\n}\n.stage-menu.open { display: flex; }\n.stage-menu button {\n  text-align: left;\n  background: transparent;\n  border: 0;\n  padding: 6px 8px;\n  border-radius: 5px;\n  font-size: 11.5px;\n  font-weight: 500;\n  color: var(--ink);\n  cursor: pointer;\n  display: flex; align-items: center; gap: 6px;\n}\n.stage-menu button:hover { background: var(--bone); }\n.stage-menu button .dot {\n  width: 6px; height: 6px; border-radius: 999px; background: var(--sand-deep); flex-shrink: 0;\n}\n.stage-menu button.is-current .dot { background: var(--forest); }\n.stage-menu button.is-current { font-weight: 700; color: var(--forest); }\n\n@keyframes card-in {\n  from { opacity: 0; transform: translateY(8px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n.kanban-board.initial-load .deal-card {\n  animation: card-in 420ms cubic-bezier(0.32, 0.72, 0, 1) both;\n}\n@keyframes col-in {\n  from { opacity: 0; transform: translateY(6px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n.kanban-board.initial-load .column { animation: col-in 380ms cubic-bezier(0.32, 0.72, 0, 1) both; }\n.kanban-board.initial-load .column:nth-child(1) { animation-delay: 30ms; }\n.kanban-board.initial-load .column:nth-child(2) { animation-delay: 60ms; }\n.kanban-board.initial-load .column:nth-child(3) { animation-delay: 90ms; }\n.kanban-board.initial-load .column:nth-child(4) { animation-delay: 120ms; }\n.kanban-board.initial-load .column:nth-child(5) { animation-delay: 150ms; }\n.kanban-board.initial-load .column:nth-child(6) { animation-delay: 180ms; }\n.kanban-board.initial-load .column:nth-child(7) { animation-delay: 210ms; }\n.kanban-board.initial-load .column:nth-child(8) { animation-delay: 240ms; }\n\n@keyframes drag-wiggle {\n  0%, 100% { transform: rotate(-1deg); }\n  50% { transform: rotate(1deg); }\n}\n.drag-ghost {\n  position: fixed;\n  pointer-events: none;\n  z-index: 9999;\n  box-shadow: 0 14px 30px -8px rgba(29,31,30,0.35), 0 6px 14px -4px rgba(30,90,58,0.15);\n  border-color: var(--forest) !important;\n  animation: drag-wiggle 380ms ease-in-out infinite;\n  transform-origin: center;\n  cursor: grabbing;\n}\n.drag-ghost::before { display: none !important; }\n.drag-ghost .deal-card-img img,\n.drag-ghost .dc-img img { animation: none !important; transform: none !important; }\n</style>\n</head>\n<body>\n\n<div class=\"app\" id=\"app\">\n  <!-- KANBAN PAGE -->\n  <main class=\"kanban-page\">\n    <header class=\"kanban-header\">\n      <div class=\"kanban-header-top\">\n        <div class=\"kanban-title\">\n          <h1>Pipeline deals</h1>\n        </div>\n      </div>\n      <div class=\"kanban-header-row\">\n        <div class=\"kpi-dashboard\">\n          <div class=\"kpi-item\">\n            <div class=\"kpi-title\">Deals actifs</div>\n            <div class=\"kpi-value\" id=\"kpi-active\">0</div>\n            <div class=\"kpi-trend\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:11px;height:11px;\"><line x1=\"12\" y1=\"19\" x2=\"12\" y2=\"5\"/><polyline points=\"5 12 12 5 19 12\"/></svg>\n              <span id=\"kpi-active-trend\">0</span> ce mois\n            </div>\n          </div>\n          <div class=\"kpi-divider\"></div>\n          <div class=\"kpi-item\">\n            <div class=\"kpi-title\">Mandats signés</div>\n            <div class=\"kpi-value\" id=\"kpi-mandat\">0</div>\n            <div class=\"kpi-trend\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:11px;height:11px;\"><line x1=\"12\" y1=\"19\" x2=\"12\" y2=\"5\"/><polyline points=\"5 12 12 5 19 12\"/></svg>\n              <span id=\"kpi-mandat-trend\">0</span> ce mois\n            </div>\n          </div>\n          <div class=\"kpi-divider\"></div>\n          <div class=\"kpi-item\">\n            <div class=\"kpi-title\">Biens vendus</div>\n            <div class=\"kpi-value\" id=\"kpi-vendu\">0</div>\n            <div class=\"kpi-trend\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:11px;height:11px;\"><line x1=\"12\" y1=\"19\" x2=\"12\" y2=\"5\"/><polyline points=\"5 12 12 5 19 12\"/></svg>\n              <span id=\"kpi-vendu-trend\">0</span> ce mois\n            </div>\n          </div>\n          <div class=\"kpi-divider\"></div>\n          <div class=\"kpi-item\">\n            <div class=\"kpi-title\">Commission ouverte</div>\n            <div class=\"kpi-value-inline\">\n              <div class=\"kpi-value\" id=\"kpi-commission\">€ 0</div>\n              <div class=\"kpi-trend\">\n                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:11px;height:11px;\"><line x1=\"12\" y1=\"19\" x2=\"12\" y2=\"5\"/><polyline points=\"5 12 12 5 19 12\"/></svg>\n                12%\n              </div>\n            </div>\n          </div>\n        </div>\n        <div class=\"kanban-actions\">\n          <div class=\"view-toggle\" id=\"view-toggle\">\n            <button class=\"active\" data-view=\"kanban\" onclick=\"setView('kanban')\">\n              <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"18\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"18\" rx=\"1\"/></svg>\n              Kanban\n            </button>\n            <button data-view=\"list\" onclick=\"setView('list')\">\n              <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><line x1=\"8\" y1=\"6\" x2=\"21\" y2=\"6\"/><line x1=\"8\" y1=\"12\" x2=\"21\" y2=\"12\"/><line x1=\"8\" y1=\"18\" x2=\"21\" y2=\"18\"/><line x1=\"3\" y1=\"6\" x2=\"3.01\" y2=\"6\"/><line x1=\"3\" y1=\"12\" x2=\"3.01\" y2=\"12\"/><line x1=\"3\" y1=\"18\" x2=\"3.01\" y2=\"18\"/></svg>\n              Liste\n            </button>\n          </div>\n          <button class=\"kanban-btn\" onclick=\"toggleFiche()\">\n            <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><line x1=\"9\" y1=\"3\" x2=\"9\" y2=\"21\"/></svg>\n            <span id=\"toggle-label\">Ouvrir mini fiche</span>\n          </button>\n          <button class=\"kanban-btn\">\n            <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><line x1=\"4\" y1=\"6\" x2=\"20\" y2=\"6\"/><line x1=\"7\" y1=\"12\" x2=\"17\" y2=\"12\"/><line x1=\"10\" y1=\"18\" x2=\"14\" y2=\"18\"/></svg>\n            Filtres\n          </button>\n          <button class=\"kanban-btn primary\">\n            <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"><line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"/><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"/></svg>\n            Nouveau deal\n          </button>\n        </div>\n      </div>\n    </header>\n\n    <div class=\"kanban-board\" id=\"board\"></div>\n    <div class=\"list-view initial-load\" id=\"list-view\" style=\"display:none\"></div>\n  </main>\n\n  <!-- FICHE PANEL (interactive detail view) -->\n  <aside class=\"fiche-panel\">\n    <div class=\"fiche-panel-mock\">\n      Sélectionnez un deal (en cliquant dessus) pour charger sa mini-fiche ici.<br><br>\n      <em>Démo interactive complète d'ImmoPilot</em>\n    </div>\n  </aside>\n</div>\n\n<script>\n// Global drag manager for autoscroll and ghost positioning\nvar DragMgr = {\n  active: false, scrollEl: null, axis: 'x',\n  lastX: 0, lastY: 0, rafId: null,\n  offX: 0, offY: 0, ghost: null, _onDragOver: null,\n  start(scrollEl, axis, e, sourceEl) {\n    this.active = true;\n    this.scrollEl = scrollEl;\n    this.axis = axis;\n    this.lastX = e.clientX;\n    this.lastY = e.clientY;\n    const rect = sourceEl.getBoundingClientRect();\n    this.offX = e.clientX - rect.left;\n    this.offY = e.clientY - rect.top;\n    const ghost = sourceEl.cloneNode(true);\n    ghost.classList.remove('dragging');\n    ghost.classList.add('drag-ghost');\n    if (sourceEl.classList.contains('list-row')) ghost.classList.add('list-row');\n    if (sourceEl.classList.contains('deal-card')) ghost.classList.add('deal-card');\n    ghost.style.cssText = 'position:fixed !important;left:' + (e.clientX - this.offX) + 'px;top:' + (e.clientY - this.offY) + 'px;width:' + rect.width + 'px;height:' + rect.height + 'px;margin:0;z-index:99999;pointer-events:none;visibility:visible;opacity:1;animation:drag-wiggle 380ms ease-in-out infinite;transform-origin:center;';\n    ghost.id = '__drag_ghost';\n    document.body.appendChild(ghost);\n    this.ghost = ghost;\n    this._onDragOver = (ev) => {\n      if (!this.active) return;\n      if (ev.clientX === 0 && ev.clientY === 0) return;\n      ev.preventDefault();\n      this.lastX = ev.clientX;\n      this.lastY = ev.clientY;\n      if (this.ghost) {\n        this.ghost.style.setProperty('left', (ev.clientX - this.offX) + 'px', 'important');\n        this.ghost.style.setProperty('top', (ev.clientY - this.offY) + 'px', 'important');\n      }\n    };\n    document.addEventListener('dragover', this._onDragOver);\n    this.rafId = requestAnimationFrame(() => this.loop());\n  },\n  loop() {\n    if (!this.active || !this.scrollEl) { this.rafId = null; return; }\n    const rect = this.scrollEl.getBoundingClientRect();\n    const edge = 100;\n    const maxSpeed = 22;\n    if (this.axis === 'x' || this.axis === 'both') {\n      let sx = 0;\n      if (this.lastX < rect.left + edge) {\n        const r = (rect.left + edge - this.lastX) / edge;\n        sx = -Math.pow(Math.min(1, Math.max(0, r)), 2) * maxSpeed;\n      } else if (this.lastX > rect.right - edge) {\n        const r = (this.lastX - (rect.right - edge)) / edge;\n        sx = Math.pow(Math.min(1, Math.max(0, r)), 2) * maxSpeed;\n      }\n      if (Math.abs(sx) > 0.1) this.scrollEl.scrollLeft += sx;\n    }\n    if (this.axis === 'y' || this.axis === 'both') {\n      let sy = 0;\n      if (this.lastY < rect.top + edge) {\n        const r = (rect.top + edge - this.lastY) / edge;\n        sy = -Math.pow(Math.min(1, Math.max(0, r)), 2) * maxSpeed * 0.8;\n      } else if (this.lastY > rect.bottom - edge) {\n        const r = (this.lastY - (rect.bottom - edge)) / edge;\n        sy = Math.pow(Math.min(1, Math.max(0, r)), 2) * maxSpeed * 0.8;\n      }\n      if (Math.abs(sy) > 0.1) this.scrollEl.scrollTop += sy;\n    }\n    this.rafId = requestAnimationFrame(() => this.loop());\n  },\n  end() {\n    this.active = false;\n    if (this.rafId) { cancelAnimationFrame(this.rafId); this.rafId = null; }\n    if (this._onDragOver) document.removeEventListener('dragover', this._onDragOver);\n    this._onDragOver = null;\n    if (this.ghost) { this.ghost.remove(); this.ghost = null; }\n    this.scrollEl = null;\n  }\n};\n\nvar PHOTOS = [\n  'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=600&q=85',\n  'https://images.unsplash.com/photo-1600566753086-00f18fe6ede1?w=600&q=85',\n  'https://images.unsplash.com/photo-1600573472550-8090b5e0745e?w=600&q=85',\n  'https://images.unsplash.com/photo-1505691938895-1758d7feb511?w=600&q=85',\n  'https://images.unsplash.com/photo-1568605114967-8130f3a36994?w=600&q=85',\n];\nvar AVATARS = [\n  'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=64&q=80',\n  'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=64&q=80',\n  'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=64&q=80',\n];\n\nvar STAGES = (window.ImmoPilotStore && window.ImmoPilotStore.getPipelineStages)\n  ? window.ImmoPilotStore.getPipelineStages()\n  : [\n      { id: 'nouveau', name: 'Nouveau' },\n      { id: 'qualifie', name: 'Qualifié' },\n      { id: 'contact', name: 'Contact' },\n      { id: 'visite', name: 'Visite' },\n      { id: 'proposition', name: 'Proposition' },\n      { id: 'mandat', name: 'Mandat signé' },\n      { id: 'vendu', name: 'Bien vendu' },\n      { id: 'perdu', name: 'Perdu' },\n    ];\n\nfunction mapStageToId(stageName) {\n  if (!stageName) return 'nouveau';\n  const norm = stageName.trim().toLowerCase();\n  if (norm.includes('nouveau')) return 'nouveau';\n  if (norm.includes('qualif')) return 'qualifie';\n  if (norm.includes('contact')) return 'contact';\n  if (norm.includes('visite')) return 'visite';\n  if (norm.includes('propos')) return 'proposition';\n  if (norm.includes('mandat')) return 'mandat';\n  if (norm.includes('vend') || norm.includes('vendu')) return 'vendu';\n  if (norm.includes('perd') || norm.includes('perdu')) return 'perdu';\n  return 'nouveau';\n}\n\nfunction mapIdToStage(stageId) {\n  const found = STAGES.find(s => s.id === stageId);\n  return found ? found.name : 'Nouveau';\n}\n\nvar DEALS = [];\nfunction loadDealsFromStore() {\n  const store = window.ImmoPilotStore;\n  if (!store) return;\n  \n  DEALS = store.getDeals().map(d => {\n    const prop = store.getProperty(d.propertyId);\n    const agent = store.getAgents().find(a => a.id === d.agentId);\n    \n    const formattedPrice = prop ? (new Intl.NumberFormat('fr-BE').format(prop.price) + ' €') : 'N/A';\n    const formattedCommission = new Intl.NumberFormat('fr-BE').format(d.estimatedCommission) + ' €';\n    \n    return {\n      id: d.id,\n      stage: mapStageToId(d.stage),\n      title: prop ? prop.title : d.title || 'Deal sans bien',\n      city: prop ? prop.city : 'Inconnue',\n      price: formattedPrice,\n      commission: formattedCommission,\n      score: prop ? prop.score : 70,\n      photo: prop ? (prop.id % PHOTOS.length) : 0,\n      owner: agent ? (agent.id === 'thomas' ? 0 : 1) : 0,\n      ownerName: agent ? agent.name : d.ownerName || 'Inconnu'\n    };\n  });\n}\nloadDealsFromStore();\n\nvar draggedDealId = null;\n\nfunction getSketchScoreHtml(score) {\n  let scoreClass = 'score-excellent';\n  if (score < 60) {\n    scoreClass = 'score-critical';\n  } else if (score < 80) {\n    scoreClass = 'score-moderate';\n  }\n  \n  const cappedScore = Math.min(100, Math.max(0, score));\n  const offset = Math.round(180 - (180 * (cappedScore / 100)));\n  \n  return `\n    <svg viewBox=\"0 0 100 100\" class=\"sketch-double-score ${scoreClass}\">\n      <path d=\"M 50,11 C 71,9 87,25 89,49 C 91,73 75,89 50,87 C 25,85 9,69 11,49 C 13,29 29,13 50,11 Z\" class=\"sketch-bg-fill\" />\n      <path d=\"M 50,11 C 71,9 87,25 89,49 C 91,73 75,89 50,87 C 25,85 9,69 11,49 C 13,29 29,13 50,11 Z\" class=\"sketch-circle-back-1\" />\n      <path d=\"M 51,9 C 73,12 89,29 86,52 C 83,75 66,90 43,88 C 21,86 7,67 10,41 C 13,15 29,5 51,9 Z\" class=\"sketch-circle-back-2\" />\n      <path class=\"sketch-progress-ribbon\" d=\"M 22,70 C 13,50 17,29 37,18 C 57,7 78,13 86,33 C 94,53 85,74 65,83\" stroke-dasharray=\"180\" stroke-dashoffset=\"${offset}\" />\n      <text x=\"50\" y=\"52\" class=\"sketch-text-score\" style=\"font-size: 32px;\">${score}</text>\n    </svg>\n  `;\n}\n\nfunction renderBoard(animate = false) {\n  loadDealsFromStore();\n  const board = document.getElementById('board');\n  board.classList.toggle('initial-load', animate);\n  board.innerHTML = '';\n  for (const stage of STAGES) {\n    const stageDeals = DEALS.filter(d => d.stage === stage.id);\n    const total = stageDeals.reduce((sum, d) => sum + parseInt(d.commission.replace(/\\D/g, ''), 10), 0);\n    const col = document.createElement('div');\n    col.className = 'column';\n    col.dataset.stage = stage.id;\n    col.addEventListener('dragover', e => { e.preventDefault(); col.classList.add('drag-over'); });\n    col.addEventListener('dragleave', () => col.classList.remove('drag-over'));\n    col.addEventListener('drop', e => {\n      e.preventDefault();\n      col.classList.remove('drag-over');\n      const id = parseInt(e.dataTransfer.getData('text/plain'), 10);\n      const deal = DEALS.find(d => d.id === id);\n      if (deal && deal.stage !== stage.id) {\n        const store = window.ImmoPilotStore;\n        if (store) {\n          const displayStageName = STAGES.find(s => s.id === stage.id)?.name || 'Nouveau';\n          store.updateDealStage(id, displayStageName);\n        }\n        deal.stage = stage.id;\n        renderBoard(false);\n        updateStats();\n      }\n    });\n    col.innerHTML = `\n      <div class=\"column-head\">\n        <div class=\"column-head-row\">\n          <span class=\"column-name\">${stage.name}</span>\n          <span class=\"column-count\">${stageDeals.length}</span>\n        </div>\n        <div class=\"column-total\">${total > 0 ? `<strong>${total.toLocaleString('fr-BE')} €</strong> commission` : '—'}</div>\n      </div>\n      <div class=\"column-body\"></div>\n      <button class=\"column-add\" onclick=\"window.addNewDealPrompt('${stage.id}')\">\n        <svg width=\"11\" height=\"11\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"><line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"/><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"/></svg>\n        Ajouter un deal\n      </button>\n    `;\n    const body = col.querySelector('.column-body');\n    if (stageDeals.length === 0) {\n      body.innerHTML = `\n        <div class=\"column-empty\" style=\"display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 28px 12px; gap: 8px; border: 1px dashed var(--sand-deep); background: rgba(255,255,255,0.45