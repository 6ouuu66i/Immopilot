one;\n  overflow-y: auto;\n  position: relative;\n  box-shadow: -4px 0 24px rgba(29,31,30,0.06);\n}\n.app.with-fiche .fiche-panel { display: block; }\n\n.fiche-panel-mock {\n  text-align: center;\n  color: var(--stone-light);\n  font-size: 13px;\n  padding: 80px 20px;\n  border: 1px dashed var(--sand-deep);\n  border-radius: 4px;\n  font-style: italic;\n  margin: 20px;\n}\n\n/* Fiche In Anim */\n@keyframes fiche-in {\n  from { opacity: 0; transform: translateY(8px) scale(0.985); }\n  to { opacity: 1; transform: translateY(0) scale(1); }\n}\n\n/* Fiche Head */\n.fiche-head {\n  padding: 16px 18px 12px;\n  display: flex; align-items: center; justify-content: space-between;\n  gap: 12px;\n  border-bottom: 1px solid var(--sand-deep);\n}\n.fiche-head-left {\n  display: flex; align-items: center; gap: 10px;\n}\n.deal-ref {\n  font-family: 'JetBrains Mono', monospace;\n  font-size: 13px; font-weight: 700;\n  color: var(--ink);\n  letter-spacing: -0.01em;\n}\n.deal-status {\n  display: inline-flex; align-items: center; gap: 5px;\n  padding: 2.5px 8px;\n  border-radius: 999px;\n  font-size: 10.5px; font-weight: 600;\n}\n.deal-status.actif {\n  background: var(--forest-soft);\n  color: var(--forest);\n  position: relative;\n  padding-left: 20px;\n}\n.deal-status.actif::after {\n  content: '';\n  position: absolute;\n  left: 7px; top: 50%;\n  width: 6px; height: 6px;\n  border-radius: 999px;\n  background: var(--forest);\n  transform: translateY(-50%);\n  animation: pulse-dot-fiche 2.2s ease-in-out infinite;\n}\n@keyframes pulse-dot-fiche {\n  0%, 100% { box-shadow: 0 0 0 0 rgba(30,90,58,0.30); }\n  60% { box-shadow: 0 0 0 5px rgba(30,90,58,0); }\n}\n.deal-status.inact {\n  background: var(--sand);\n  color: var(--stone);\n  position: relative;\n  padding-left: 18px;\n}\n.deal-status.inact::before {\n  content: '';\n  position: absolute;\n  left: 7px; top: 52%;\n  width: 5px; height: 5px;\n  border-radius: 999px;\n  background: var(--stone);\n  transform: translateY(-50%);\n}\n\n.fiche-close {\n  background: none; border: none; cursor: pointer;\n  width: 30px; height: 30px;\n  display: grid; place-items: center;\n  color: var(--stone);\n  border-radius: 6px;\n  flex-shrink: 0;\n  transition: background 140ms, color 140ms;\n}\n.fiche-close:hover { background: var(--bone); color: var(--ink); }\n\n/* Fiche Hero Wrap */\n.hero-wrap {\n  position: relative;\n  padding: 12px 16px 0;\n}\n.hero {\n  position: relative;\n  width: 100%;\n  height: 160px;\n  background: var(--sand);\n  overflow: hidden;\n  border-radius: 8px;\n}\n.hero img {\n  width: 100%; height: 100%; object-fit: cover; display: block;\n  transition: transform 800ms cubic-bezier(0.32, 0.72, 0, 1);\n}\n.hero:hover img { transform: scale(1.03); }\n\n/* Ai Badge */\n@property --score {\n  syntax: '<integer>';\n  initial-value: 0;\n  inherits: true;\n}\n@keyframes badgeSweep {\n  from { --score: 0; }\n  to   { --score: var(--target-score, 78); }\n}\n.ai-badge {\n  --score: 0;\n  position: absolute;\n  bottom: -22px;\n  right: 28px;\n  width: 52px; height: 52px;\n  border-radius: 999px;\n  background: conic-gradient(\n    from 180deg,\n    var(--color-sage) 0%,\n    #3D7A52 calc(var(--score) * 0.4%),\n    var(--color-forest) calc(var(--score) * 1%),\n    var(--color-forest-soft) 0\n  );\n  display: grid; place-items: center;\n  z-index: 4;\n  box-shadow: 0 4px 12px rgba(29,31,30,0.14);\n  animation: badgeSweep 1.2s cubic-bezier(0.34, 1.56, 0.64, 1) both;\n}\n.ai-badge::before {\n  content: '';\n  position: absolute; inset: 4px;\n  border-radius: 999px;\n  background: #FFFFFF;\n}\n.ai-badge-inner {\n  position: relative;\n  text-align: center;\n  line-height: 1;\n}\n.ai-badge-inner strong {\n  display: block;\n  font-family: 'Lora', Georgia, serif;\n  font-size: 16px;\n  font-weight: 700;\n  color: var(--ink);\n  counter-reset: scorenum var(--score);\n}\n.ai-badge-inner strong::after {\n  content: counter(scorenum);\n}\n.ai-badge-inner strong > span {\n  display: none;\n}\n.ai-badge-inner span {\n  display: block;\n  font-family: 'JetBrains Mono', monospace;\n  font-size: 8px;\n  font-weight: 600;\n  letter-spacing: 0.08em;\n  color: var(--forest);\n  text-transform: uppercase;\n  margin-top: 1px;\n}\n\n/* Fiche Info */\n.fiche-info {\n  padding: 14px 18px 6px;\n  background: #FFFFFF;\n}\n.fiche-title {\n  font-size: 18px;\n  font-weight: 700;\n  color: var(--ink);\n  letter-spacing: -0.015em;\n  text-align: left;\n}\n.fiche-title::before {\n  content: '';\n  display: inline-block;\n  width: 3px; height: 15px;\n  background: var(--forest);\n  margin-right: 7px;\n  vertical-align: -2px;\n  border-radius: 1.5px;\n}\n.fiche-loc-row {\n  display: flex; align-items: center; justify-content: space-between;\n  gap: 12px;\n  margin-top: 4px;\n}\n.fiche-price {\n  font-size: 16px;\n  font-weight: 700;\n  color: var(--ink);\n  letter-spacing: -0.01em;\n  white-space: nowrap;\n}\n.fiche-loc {\n  display: inline-flex; align-items: center; gap: 5px;\n  font-size: 12.5px;\n  font-weight: 500;\n  color: var(--stone);\n}\n.fiche-loc svg { color: var(--forest); fill: var(--forest); }\n\n/* Stepper (stages) */\n.stepper-wrapper {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  width: calc(100% - 32px);\n  margin: 12px 16px;\n  padding: 6px;\n  border-radius: 8px;\n  background: var(--bone);\n  border: 1px solid var(--sand-deep);\n}\n.step {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  flex: 1;\n  cursor: pointer;\n}\n.step::before {\n  content: \"\";\n  position: absolute;\n  top: 5px;\n  right: 50%;\n  width: 100%;\n  height: 1.5px;\n  background-color: var(--sand-deep);\n  z-index: 1;\n  transition: background-color 0.3s ease;\n}\n.step:first-child::before { display: none; }\n.step.completed::before,\n.step.active::before { background-color: var(--forest); }\n\n.step-icon {\n  position: relative;\n  width: 12px; height: 12px;\n  border-radius: 50%;\n  background-color: #FFFFFF