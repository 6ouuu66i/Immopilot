export default "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\n:root {\n  --forest: #1E5A3A;\n  --forest-soft: #CFE1D2;\n  --sand: #F4EFE5;\n  --sand-deep: #E3DED2;\n  --bone: #FBF9F4;\n  --ink: #1D1F1E;\n  --stone: #6B6F6D;\n  --stone-light: #8E8B83;\n  --moss: #7FA68E;\n}\n\n/* ── KANBAN MAIN ── */\n.kanban-page {\n  display: flex; flex-direction: column;\n  padding: 18px 22px 0;\n  min-width: 0;\n  flex: 1;\n  height: 100%;\n  overflow: hidden;\n  \n  background-color: #FBF9F4 !important; /* Premium warm paper sheet background */\n  background-image: \n    /* Soft red margin vertical line typical of high-quality notebooks */\n    linear-gradient(90deg, transparent 55px, rgba(200, 85, 61, 0.24) 55px, rgba(200, 85, 61, 0.24) 57px, transparent 57px),\n    /* Delicate forest-green grid lines to emphasize the sketched vibe */\n    linear-gradient(rgba(30, 90, 58, 0.08) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(30, 90, 58, 0.08) 1px, transparent 1px) !important;\n  background-size: 100% 100%, 20px 20px, 20px 20px !important;\n}\n.kanban-header {\n  display: flex; align-items: center; justify-content: space-between;\n  margin-bottom: 16px;\n  gap: 14px;\n}\n.kanban-title {\n  display: flex; align-items: baseline; gap: 10px;\n}\n.kanban-title h1 {\n  font-family: 'Lora', Georgia, serif;\n  font-size: 24px;\n  font-weight: 700;\n  letter-spacing: -0.015em;\n}\n.kanban-title h1::before {\n  content: '';\n  display: inline-block;\n  width: 4px; height: 18px;\n  background: var(--forest);\n  margin-right: 10px;\n  vertical-align: -2px;\n  border-radius: 99px;\n}\n.kanban-stats {\n  display: flex; align-items: center; gap: 8px;\n  font-size: 12px;\n  color: var(--stone);\n}\n.kanban-stats strong { color: var(--ink); font-weight: 600; }\n.kanban-stats .dot {\n  width: 4px; height: 4px; border-radius: 999px;\n  background: var(--sand-deep);\n  margin: 0 4px;\n}\n.kanban-actions {\n  display: flex; align-items: center; gap: 8px;\n}\n.kanban-btn {\n  height: 34px;\n  padding: 0 14px;\n  border-radius: 4px;\n  border: 1px solid var(--sand-deep);\n  background: #FFFFFF;\n  font: inherit; font-size: 12.5px; font-weight: 500;\n  color: var(--ink);\n  cursor: pointer;\n  display: inline-flex; align-items: center; gap: 6px;\n  transition: all 160ms;\n}\n.kanban-btn:hover { border-color: #CFC8B7; background: var(--bone); }\n.kanban-btn.primary {\n  background: var(--forest);\n  color: #FFFFFF;\n  border-color: var(--forest);\n}\n.kanban-btn.primary:hover { background: #174A2F; }\n\n\n.view-toggle {\n  display: inline-flex;\n  background: #FCFAF5;\n  border: 1px solid #F1ECDF;\n  border-radius: 4px;\n  padding: 2px;\n  gap: 2px;\n}\n.view-toggle button {\n  background: transparent;\n  border: none;\n  padding: 6px 12px;\n  font: inherit;\n  font-size: 12px;\n  font-weight: 500;\n  color: var(--stone);\n  cursor: pointer;\n  border-radius: 4px;\n  display: inline-flex; align-items: center; gap: 6px;\n  transition: all 160ms ease;\n}\n.view-toggle button.active {\n  background: #FFFFFF;\n  color: var(--ink);\n  box-shadow: 0 1px 2px rgba(29,31,30,0.08);\n  font-weight: 600;\n}\n.view-toggle button:hover:not(.active) { color: var(--ink); }\n\n\n.list-row[draggable=\"true\"] { cursor: grab; }\n.list-row[draggable=\"true\"]:active { cursor: grabbing; }\n.list-row.dragging { visibility: hidden; }\n.list-group.drag-over {\n  background: rgba(207,225,210,0.30);\n  border-radius: 4px;\n}\n.drag-ghost.list-row {\n  cursor: grabbing;\n  background: #FFFFFF;\n  animation: drag-wiggle 600ms ease-in-out infinite;\n}\n\n/* LIST VIEW */\n.list-view {\n  flex: 1;\n  overflow-y: auto;\n  display: flex; flex-direction: column;\n  gap: 14px;\n  padding: 4px 0 18px;\n}\n.list-group {\n  display: flex; flex-direction: column;\n  gap: 6px;\n}\n.list-group-head {\n  display: flex; align-items: center; gap: 8px;\n  font-family: 'JetBrains Mono', monospace;\n  font-size: 11px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n  color: var(--ink);\n  padding: 4px 6px 4px 0;\n}\n.list-group-head::before {\n  content: '';\n  width: 7px; height: 7px;\n  border-radius: 999px;\n  background: var(--col-color, var(--stone-light));\n  box-shadow: 0 0 0 3px rgba(0,0,0,0.04);\n}\n.list-group-count {\n  background: #FFFFFF;\n  border: 1px solid #F5F0E5;\n  border-radius: 999px;\n  padding: 2px 8px;\n  font-size: 10px;\n  color: var(--stone);\n  font-weight: 600;\n  font-family: 'Inter', sans-serif;\n  text-transform: none;\n  letter-spacing: 0;\n}\n.list-group-total {\n  margin-left: auto;\n  font-size: 11px;\n  color: var(--stone);\n  font-family: 'Inter', sans-serif;\n  text-transform: none;\n  letter-spacing: 0;\n  font-weight: 400;\n}\n.list-group-total strong { color: var(--ink); font-weight: 600; }\n.list-group[data-stage=\"nouveau\"] { --col-color: #8E8B83; }\n.list-group[data-stage=\"qualifie\"] { --col-color: #7FA68E; }\n.list-group[data-stage=\"contact\"] { --col-color: #4F7A95; }\n.list-group[data-stage=\"visite\"] { --col-color: #C8A53B; }\n.list-group[data-stage=\"proposition\"] { --col-color: #C8893B; }\n.list-group[data-stage=\"mandat\"] { --col-color: var(--forest); }\n.list-group[data-stage=\"vendu\"] { --col-color: var(--forest); }\n.list-group[data-stage=\"perdu\"] { --col-color: #C8553D; }\n\n.list-row {\n  display: grid;\n  grid-template-columns: 80px 1fr 100px 120px 140px 100px 60px 38px;\n  gap: 14px;\n  align-items: center;\n  padding: 8px 14px 8px 8px;\n  background: #FFFFFF;\n  border: 1px solid #F5F0E5;\n  border-radius: 4px;\n  cursor: pointer;\n  position: relative;\n  transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;\n}\n.list-row:hover {\n  border-color: #CFC8B7;\n  box-shadow: 0 4px 14px -6px rgba(29,31,30,0.10);\n  transform: translateY(-1px);\n}\n.list-row::before {\n  content: '';\n  position: absolute;\n  left: 0; top: 10px; bottom: 10px;\n  width: 3px;\n  background: var(--forest);\n  border-radius: 0 2px 2px 0;\n  opacity: 0;\n  transform: scaleY(0.4);\n  transition: opacity 200ms ease, transform 240ms cubic-bezier(0.34, 1.2, 0.64, 1);\n}\n.list-row:hover::before { opacity: 1; transform: scaleY(1); }\n.lr-thumb {\n  width: 80px; height: 56px;\n  border-radius: 4px;\n  overflow: hidden;\n  background: var(--sand-deep);\n}\n.lr-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }\n.lr-title {\n  font-size: 13px;\n  font-weight: 600;\n  color: var(--ink);\n  letter-spacing: -0.005em;\n  margin-bottom: 2px;\n}\n.lr-city {\n  font-size: 11px;\n  color: var(--stone);\n}\n.lr-price {\n  font-size: 14px;\n  font-weight: 700;\n  color: var(--ink);\n  letter-spacing: -0.01em;\n  text-align: right;\n}\n.lr-commission {\n  font-size: 13px;\n  font-weight: 600;\n  color: var(--forest);\n  text-align: right;\n  letter-spacing: -0.01em;\n}\n.lr-owner {\n  display: flex; align-items: center; gap: 7px;\n  min-width: 0;\n}\n.lr-avatar {\n  width: 22px; height: 22px;\n  border-radius: 999px;\n  background-size: cover; background-position: center;\n  box-shadow: 0 0 0 1.5px #FFFFFF, 0 0 0 2.5px var(--sand);\n  flex-shrink: 0;\n}\n.lr-owner-name {\n  font-size: 11.5px;\n  color: var(--stone);\n  font-weight: 500;\n  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;\n}\n.lr-score {\n  width: 34px; height: 34px;\n  border-radius: 999px;\n  background: #FFFFFF;\n  display: grid; place-items: center;\n  margin: 0 auto;\n  border: 1px solid var(--sand-deep);\n  padding: 1.5px;\n}\n.lr-actions {\n  display: flex; align-items: center; justify-content: center;\n}\n.lr-menu-btn {\n  background: transparent;\n  border: none;\n  width: 30px; height: 30px;\n  border-radius: 4px;\n  display: grid; place-items: center;\n  cursor: pointer;\n  color: var(--stone);\n  transition: all 140ms;\n}\n.lr-menu-btn:hover { background: #FCFAF5; color: var(--ink); }\n\n.list-empty {\n  padding: 12px;\n  text-align: center;\n  font-size: 11.5px;\n  color: var(--stone-light);\n  border: 1px dashed #F1ECDF;\n  border-radius: 4px;\n  background: #FCFAF5;\n}\n\n@keyframes row-in {\n  from { opacity: 0; transform: translateY(4px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n.list-view.initial-load .list-row {\n  animation: row-in 360ms cubic-bezier(0.32, 0.72, 0, 1) both;\n}\n\n\n.kanban-header {\n  display: flex; flex-direction: column;\n  gap: 14px;\n  margin-bottom: 16px;\n  align-items: stretch;\n}\n.kanban-header-top {\n  display: flex; align-items: center; justify-content: flex-start;\n  gap: 14px;\n  width: 100%;\n}\n.kanban-header-row {\n  display: flex; align-items: center; justify-content: space-between;\n  gap: 14px;\n  width: 100%;\n}\n.kanban-title { display: flex; align-items: baseline; gap: 10px; flex: 0 0 auto; }\n/* KPI Dashboard turned into realistic Post-it notes */\n.kpi-dashboard {\n  display: flex;\n  align-items: stretch;\n  gap: 16px;\n  flex: 1 1 auto;\n  min-width: 0;\n  background: transparent !important;\n  border: none !important;\n  box-shadow: none !important;\n  padding: 8px 4px !important;\n}\n.kanban-actions {\n  flex: 0 0 auto;\n  display: flex; align-items: center; gap: 8px;\n}\n.kpi-item {\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  flex: 1;\n  min-width: 140px;\n  min-height: 90px;\n  padding: 14px 14px 10px;\n  position: relative;\n  background: #FFFDF7 !important;\n  border: 1.5px solid #D8D2C4 !important;\n  border-radius: 2px !important;\n  cursor: pointer;\n  transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;\n}\n.kpi-item:last-child { flex: 1.3; }\n.kpi-divider { display: none !important; }\n\n/* Semi-transparent sticky masking tape effect */\n.kpi-item::before {\n  content: '';\n  position: absolute;\n  top: -8px;\n  left: 50%;\n  transform: translateX(-50%) rotate(-1deg);\n  width: 52px;\n  height: 14px;\n  background: rgba(226, 218, 196, 0.82); /* Semi-transparent masking tape */\n  border: 1px dashed rgba(107, 111, 109, 0.35);\n  box-shadow: 0 1.5px 3px rgba(0,0,0,0.04);\n  z-index: 5;\n  pointer-events: none;\n}\n\n/* 1st Post-it: Deals actifs (Jaune soft accent `#F1E8B8`) */\n.kpi-item:nth-child(1) {\n  border-top: 3.5px solid #F1E8B8 !important;\n  transform: rotate(-1.4deg);\n  box-shadow: 3px 3px 0 rgba(31, 36, 33, 0.12) !important;\n}\n.kpi-item:nth-child(1)::before {\n  background: rgba(241, 232, 184, 0.85) !important;\n  border-color: rgba(190, 180, 140, 0.45);\n}\n.kpi-item:nth-child(1):hover {\n  transform: rotate(-1.4deg) translateY(-3px) scale(1.02);\n  box-shadow: 5px 5px 0 rgba(31, 36, 33, 0.15) !important;\n}\n\n/* 2nd Post-it: Mandats signés (Vert soft accent `#DDEADB`) */\n.kpi-item:nth-child(3) {\n  border-top: 3.5px solid #DDEADB !important;\n  transform: rotate(1deg);\n  box-shadow: 3px 3px 0 rgba(31, 36, 33, 0.12) !important;\n}\n.kpi-item:nth-child(3)::before {\n  background: rgba(221, 234, 219, 0.85) !important;\n  border-color: rgba(170, 190, 170, 0.45);\n}\n.kpi-item:nth-child(3):hover {\n  transform: rotate(1deg) translateY(-3px) scale(1.02);\n  box-shadow: 5px 5px 0 rgba(31, 36, 33, 0.15) !important;\n}\n\n/* 3rd Post-it: Biens vendus (Beige soft accent `#EEE4D2`) */\n.kpi-item:nth-child(5) {\n  border-top: 3.5px solid #EEE4D2 !important;\n  transform: rotate(-0.8deg);\n  box-shadow: 3px 3px 0 rgba(31, 36, 33, 0.12) !important;\n}\n.kpi-item:nth-child(5)::before {\n  background: rgba(238, 228, 210, 0.85) !important;\n  border-color: rgba(190, 180, 160, 0.45);\n}\n.kpi-item:nth-child(5):hover {\n  transform: rotate(-0.8deg) translateY(-3px) scale(1.02);\n  box-shadow: 5px 5px 0 rgba(31, 36, 33, 0.15) !important;\n}\n\n/* 4th Post-it: Commission ouverte (Rose soft accent `#F0DADA`) */\n.kpi-item:nth-child(7) {\n  border-top: 3.5px solid #F0DADA !important;\n  transform: rotate(1.2deg);\n  box-shadow: 3px 3px 0 rgba(31, 36, 33, 0.12) !important;\n}\n.kpi-item:nth-child(7)::before {\n  background: rgba(240, 218, 218, 0.85) !important;\n  border-color: rgba(190, 160, 160, 0.45);\n}\n.kpi-item:nth-child(7):hover {\n  transform: rotate(1.2deg) translateY(-3px) scale(1.02);\n  box-shadow: 5px 5px 0 rgba(31, 36, 33, 0.15) !important;\n}\n\n.kpi-title {\n  font-size: 11px;\n  color: #67635B !important;\n  font-weight: 600;\n  margin-bottom: 6px;\n  font-family: 'JetBrains Mono', monospace;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n}\n.kpi-value {\n  font-size: 23px;\n  font-weight: 700;\n  color: #1F2421 !important;\n  line-height: 1;\n  letter-spacing: -0.015em;\n}\n.kpi-trend {\n  display: flex; align-items: center;\n  font-size: 10.5px;\n  font-weight: 500;\n  color: #948F85 !important;\n  margin-top: 5px;\n  gap: 4px;\n}\n.kpi-trend svg { width: 11px; height: 11px; color: #948F85 !important; }\n.kpi-value-inline {\n  display: flex; align-items: baseline; gap: 8px;\n}\n.kpi-value-inline .kpi-trend { margin-top: 0; }\n\n/* ── BOARD ── */\n.kanban-board {\n  display: grid;\n  grid-template-columns: repeat(8, 260px);\n  gap: 12px;\n  overflow: auto;\n  flex: 1;\n  min-height: 0;\n  padding-bottom: 18px;\n}\n.app.with-fiche .kanban-board {\n  grid-template-columns: repeat(8, 240px);\n}\n\n\n.kanban-board::-webkit-scrollbar-corner { background: transparent; }\n\n.kanban-board::-webkit-scrollbar {\n  width: 12px;\n  height: 12px;\n  background: transparent;\n}\n.kanban-board::-webkit-scrollbar-track {\n  background: rgba(29,31,30,0.04);\n  border-radius: 999px;\n  margin: 0 8px;\n}\n.kanban-board::-webkit-scrollbar-thumb {\n  background: #B8B0A0;\n  border-radius: 999px;\n  border: 2px solid #EAE5DA;\n  transition: background 160ms ease;\n}\n.kanban-board::-webkit-scrollbar-thumb:hover {\n  background: #6B6F6D;\n}\n.kanban-board::-webkit-scrollbar-thumb:active {\n  background: var(--forest);\n}\n.kanban-board {\n  scrollbar-width: thin;\n  scrollbar-color: #B8B0A0 rgba(29,31,30,0.04);\n  scroll-behavior: auto;\n}\n\n/* ── COLUMN ── */\n.column {\n  display: flex; flex-direction: column;\n  min-width: 0;\n  background: #FFFFFF;\n  border-radius: 4px;\n  border: 1.5px solid var(--stone);\n  transition: background 160ms ease, border-color 160ms ease;\n  align-self: start;\n}\n.column.drag-over {\n  background: var(--forest-soft);\n  border-color: var(--forest);\n}\n.column-head {\n  padding: 12px 14px 10px;\n  display: flex; flex-direction: column;\n  gap: 6px;\n}\n.column-head-row {\n  display: flex; align-items: center; justify-content: space-between;\n  gap: 8px;\n}\n.column-name {\n  font-family: 'JetBrains Mono', monospace;\n  font-size: 11px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n  color: var(--ink);\n  display: flex; align-items: center; gap: 7px;\n}\n.column-name::before {\n  content: '';\n  width: 7px; height: 7px;\n  border-radius: 999px;\n  background: var(--col-color, var(--stone-light));\n  box-shadow: 0 0 0 3px rgba(0,0,0,0.04);\n}\n.column-count {\n  background: #FFFFFF;\n  border: 1px solid var(--sand-deep);\n  border-radius: 999px;\n  padding: 2px 8px;\n  font-size: 10px;\n  color: var(--stone);\n  font-weight: 600;\n}\n.column-total {\n  font-size: 11px;\n  color: var(--stone);\n}\n.column-total strong { color: var(--ink); font-weight: 600; letter-spacing: -0.01em; }\n\n.column-body {\n  flex: 1;\n  padding: 0 8px 10px;\n  display: flex; flex-direction: column; gap: 10px;\n  min-height: 380px;\n}\n\n\n.column-empty {\n  margin: 10px 4px;\n  padding: 16px 10px;\n  border: 1px dashed var(--sand-deep);\n  border-radius: 4px;\n  text-align: center;\n  font-size: 11px;\n  color: var(--stone-light);\n  background: rgba(255,255,255,0.4);\n}\n\n.column-add {\n  margin: 0 8px 8px;\n  padding: 8px;\n  border-radius: 4px;\n  background: transparent;\n  border: 1px dashed var(--sand-deep);\n  font: inherit; font-size: 11.5px; font-weight: 500;\n  color: var(--stone);\n  cursor: pointer;\n  display: flex; align-items: center; justify-content: center; gap: 5px;\n  transition: all 160ms;\n}\n.column-add:hover {\n  border-color: 