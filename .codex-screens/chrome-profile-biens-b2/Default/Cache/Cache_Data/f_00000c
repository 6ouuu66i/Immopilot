        <rect x=\"46\" y=\"40\" width=\"4\" height=\"4\" rx=\"0.5\" stroke=\"#5c5e5c\" stroke-width=\"0.95\" />\n            <path d=\"M54 42.5 H 68\" stroke=\"#5c5e5c\" stroke-width=\"1\" stroke-linecap=\"round\" />\n\n            <rect x=\"46\" y=\"49\" width=\"4\" height=\"4\" rx=\"0.5\" stroke=\"#5c5e5c\" stroke-width=\"0.95\" />\n            <path d=\"M54 51.5 H 71\" stroke=\"#5c5e5c\" stroke-width=\"1\" stroke-linecap=\"round\" />\n\n            <rect x=\"46\" y=\"58\" width=\"4\" height=\"4\" rx=\"0.5\" stroke=\"#5c5e5c\" stroke-width=\"0.95\" />\n            <path d=\"M54 60.5 H 64\" stroke=\"#5c5e5c\" stroke-width=\"1\" stroke-linecap=\"round\" />\n\n            <!-- Potted Plant (faithful charcoal sketch style) -->\n            <!-- Pot -->\n            <path d=\"M88 67 L 91 80 C 91.2 80.8, 92 81.2, 92.8 81.2 L 100.2 81.2 C 101 81.2, 101.8 80.8, 102 80 L 105 67 Z\" stroke=\"#3a3d3c\" stroke-width=\"1.35\" stroke-linejoin=\"round\" fill=\"#FFFFFF\" />\n            <path d=\"M86.5 65 L 106.5 65 L 105 68 L 88 68 Z\" stroke=\"#3a3d3c\" stroke-width=\"1.35\" stroke-linejoin=\"round\" fill=\"#DFECE3\" />\n            \n            <!-- Plant foliage stems -->\n            <path d=\"M96.5 65 C 96.5 54, 95 48, 96 42\" stroke=\"#3a3d3c\" stroke-width=\"1.1\" stroke-linecap=\"round\" />\n            <path d=\"M96.2 65 C 96.2 56, 95.2 50, 95.8 44\" stroke=\"#3a3d3c\" stroke-width=\"0.75\" opacity=\"0.45\" />\n\n            <!-- Beautiful hand-drawn leaves with forest green color -->\n            <path d=\"M96 48 C 91 43, 89 45, 94.5 51 Z\" stroke=\"var(--forest)\" stroke-width=\"1.1\" stroke-linejoin=\"round\" />\n            <path d=\"M96 44 C 101.5 38, 103.5 41, 97.5 48 Z\" stroke=\"var(--forest)\" stroke-width=\"1.1\" stroke-linejoin=\"round\" />\n            <path d=\"M96.5 57 C 88.5 55, 87 59, 94 62 Z\" stroke=\"var(--forest)\" stroke-width=\"1.1\" stroke-linejoin=\"round\" />\n            <path d=\"M96.5 54 C 104 50, 105.5 53, 98.2 58.5 Z\" stroke=\"var(--forest)\" stroke-width=\"1.1\" stroke-linejoin=\"round\" />\n          </svg>\n          <div style=\"font-weight: 700; font-size: 11px; color: var(--ink); margin-top: 1px; letter-spacing: -0.01em;\">Aucun deal dans cette étape</div>\n          <div style=\"font-size: 9.5px; color: var(--stone); line-height: 1.35; max-width: 150px; margin: 0 auto;\">Glissez-déposez un deal ici ou créez-en un nouveau</div>\n        </div>`;\n    } else {\n      for (const d of stageDeals) body.appendChild(renderDeal(d));\n    }\n    board.appendChild(col);\n  }\n  updateStats();\n}\n\nfunction renderDeal(d) {\n  const art = document.createElement('article');\n  art.className = 'deal-card';\n  art.style.setProperty('--score', d.score);\n  art.draggable = true;\n  art.addEventListener('dragstart', e => {\n    draggedDealId = d.id;\n    e.dataTransfer.setData('text/plain', d.id);\n    e.dataTransfer.effectAllowed = 'move';\n    const dragBlank = document.createElement('img');\n    dragBlank.src = \"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=\";\n    e.dataTransfer.setDragImage(dragBlank, 0, 0);\n    const board = document.getElementById('board');\n    DragMgr.start(board, 'both', e, art);\n    requestAnimationFrame(() => art.classList.add('dragging'));\n  });\n  art.addEventListener('dragend', () => {\n    art.classList.remove('dragging');\n    DragMgr.end();\n  });\n  art.innerHTML = `\n    <div class=\"dc-img\">\n      <img src=\"${PHOTOS[d.photo]}\" alt=\"\">\n    </div>\n    <div class=\"dc-ai\">${getSketchScoreHtml(d.score)}</div>\n    <div class=\"dc-body\">\n      <div class=\"dc-title\">${d.title}</div>\n      <div class=\"dc-city\">\n        <svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2a8 8 0 0 0-8 8c0 5.5 8 12 8 12s8-6.5 8-12a8 8 0 0 0-8-8z\"/><circle cx=\"12\" cy=\"10\" r=\"2.5\" fill=\"#FFFFFF\"/></svg>\n        ${d.city}\n      </div>\n      <div class=\"dc-price\">${d.price}</div>\n      <div class=\"dc-divider\"></div>\n      <div class=\"dc-foot\">\n        <div class=\"dc-owner\">\n          <div class=\"dc-avatar\" style=\"background-image:url('${AVATARS[d.owner]}')\"></div>\n          <span class=\"dc-owner-name\">${d.ownerName.split(' ')[0]}</span>\n        </div>\n        <span class=\"dc-commission\">${d.commission}</span>\n      </div>\n    </div>\n  `;\n  art.addEventListener('click', e => {\n    if (!art.classList.contains('dragging')) {\n      openDealFiche(d.id);\n    }\n  });\n  return art;\n}\n\nfunction updateStats() {\n  const active = DEALS.filter(d => d.stage !== 'vendu' && d.stage !== 'perdu');\n  const mandat = DEALS.filter(d => d.stage === 'mandat');\n  const vendu = DEALS.filter(d => d.stage === 'vendu');\n  const totalCommission = active.reduce((s, d) => s + parseInt(d.commission.replace(/\\D/g, ''), 10), 0);\n  const el = (id) => document.getElementById(id);\n  if (el('kpi-active')) el('kpi-active').textContent = active.length;\n  if (el('kpi-mandat')) el('kpi-mandat').textContent = mandat.length;\n  if (el('kpi-vendu')) el('kpi-vendu').textContent = vendu.length;\n  if (el('kpi-commission')) el('kpi-commission').textContent = '€ ' + totalCommission.toLocaleString('fr-BE');\n  if (el('kpi-active-trend')) el('kpi-active-trend').textContent = Math.max(1, Math.round(active.length * 0.18));\n  if (el('kpi-mandat-trend')) el('kpi-mandat-trend').textContent = Math.max(1, Math.round(mandat.length * 0.5));\n  if (el('kpi-vendu-trend')) el('kpi-vendu-trend').textContent = Math.max(1, Math.round(vendu.length * 0.5));\n}\n\nvar activeDealId = null;\n\nfunction toggleFiche() {\n  const app = document.getElementById('app');\n  app.classList.toggle('with-fiche');\n  document.getElementById('toggle-label').textContent = app.classList.contains('with-fiche') ? 'Fermer mini fiche' : 'Ouvrir mini fiche';\n  if (app.classList.contains('with-fiche') && !activeDealId) {\n    openDealFiche(1);\n  }\n}\n\nwindow.openDealFiche = function(dealId) {\n  activeDealId = dealId;\n  const d = DEALS.find(x => x.id === dealId);\n  if (!d) return;\n\n  // Load and sync tasks with localStorage shared key\n  var allTasks = [];\n  var storedTasks = localStorage.getItem(\"immopilot_agenda_tasks_v1\");\n  if (storedTasks) {\n    try { allTasks = JSON.parse(storedTasks); } catch(e) {}\n  }\n  \n  var dealTasks = allTasks.filter(t => t.entityKey === \"deal-\" + d.id);\n  if (dealTasks.length === 0) {\n    // Populate smart default templates for first demo run\n    var defaultTasks = [\n      {\n        id: \"task-\" + d.id + \"-1\",\n        title: \"Appeler le vendeur pour fixer le prix final\",\n        type: \"deal\",\n        entityKey: \"deal-\" + d.id,\n        entityName: d.title + \" (\" + d.city + \")\",\n        priority: \"haute\",\n        day: 24,\n        time: \"10:00\",\n        completed: false\n      },\n      {\n        id: \"task-\" + d.id + \"-2\",\n        title: \"Envoyer le dossier de présentation PEB\",\n        type: \"deal\",\n        entityKey: \"deal-\" + d.id,\n        entityName: d.title + \" (\" + d.city + \")\",\n        priority: \"normal\",\n        day: 26,\n        time: \"14:30\",\n        completed: false\n      }\n    ];\n    allTasks = allTasks.concat(defaultTasks);\n    localStorage.setItem(\"immopilot_agenda_tasks_v1\", JSON.stringify(allTasks));\n    dealTasks = defaultTasks;\n  }\n\n  // Load and sync notes with localStorage shared key\n  var allNotes = [];\n  var storedNotes = localStorage.getItem(\"immopilot_deal_notes_v1\");\n  if (storedNotes) {\n    try { allNotes = JSON.parse(storedNotes); } catch(e) {}\n  }\n  var dealNotes = allNotes.filter(n => n.dealId === d.id);\n  if (dealNotes.length === 0) {\n    var defaultNotes = [\n      {\n        id: \"note-\" + d.id + \"-1\",\n        dealId: d.id,\n        author: \"Lucas Martin\",\n        avatar: \"LM\",\n        date: \"23/05/2026\",\n        text: \"Propriétaire motivé. Prêt pour une baisse de prix de 5% si offre rapide.\"\n      }\n    ];\n    allNotes = allNotes.concat(defaultNotes);\n    localStorage.setItem(\"immopilot_deal_notes_v1\", JSON.stringify(allNotes));\n    dealNotes = defaultNotes;\n  }\n\n  // Set physical specs for corresponding properties\n  var specs = \"150 m² · 3 ch. · PEB B\";\n  if (d.city === \"Wavre\") specs = \"180 m² · 3 ch. · PEB B\";\n  else if (d.city === \"Bruxelles\") specs = \"85 m² · 2 ch. · PEB C\";\n  else if (d.city === \"Uccle\") specs = \"320 m² · 4 ch. · PEB A+\";\n  else if (d.city === \"Ixelles\") specs = \"145 m² · 3 ch. · PEB D\";\n  else if (d.city === \"Lasne\") specs = \"210 m² · 4 ch. · PEB A\";\n  else if (d.city === \"Anderlecht\") specs = \"130 m² · 2 ch. · PEB B\";\n  else if (d.city === \"Saint-Gilles\") specs = \"280 m² · 5 ch. · PEB C\";\n  else if (d.city === \"Etterbeek\") specs = \"45 m² · 1 ch. · PEB E\";\n  else if (d.city === \"Schaerbeek\") specs = \"115 m² · 2 ch. · PEB C\";\n  else if (d.city === \"Woluwe-Saint-Pierre\") specs = \"190 m² · 3 ch. · PEB B\";\n  else if (d.city === \"Forest\") specs = \"95 m² · 2 ch. · PEB B\";\n  else if (d.city === \"Molenbeek\") specs = \"120 m² · 3 ch. · PEB G\";\n\n  // Contacts information\n  var sellerInitials = d.ownerName ? d.ownerName.split(\" \").map(w => w[0]).join(\"\") : \"JD\";\n  var sellerPhone = \"+32 475 12 \" + (10 + d.id) + \" \" + (34 + d.id);\n  var sellerEmail = d.ownerName ? d.ownerName.toLowerCase().replace(\" \", \".\") + \"@email.be\" : \"vendeur@email.be\";\n\n  // Stepper stepper tracker\n  var currentStageIdx = STAGES.findIndex(s => s.id === d.stage);\n  if (currentStageIdx === -1) currentStageIdx = 0;\n\n  var stepperHtml = \"\";\n  STAGES.forEach((stg, sIdx) => {\n    var cls = \"\";\n    var iconHtml = \"\";\n    if (sIdx < currentStageIdx) {\n      cls = \"completed\";\n      iconHtml = '<svg viewBox=\"0 0 24 24\" fill=\"none\" style=\"width:7px; height:7px; stroke:#FFFFFF; stroke-width:3.2;\"><polyline points=\"20 6 9 17 4 12\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>';\n    } else if (sIdx === currentStageIdx) {\n      cls = \"active\";\n    }\n    stepperHtml += `\n      <div class=\"step ${cls}\" onclick=\"setFicheStage(${sIdx})\">\n        <div class=\"step-icon\">${iconHtml}</div>\n        <div class=\"step-label\">${stg.name}</div>\n      </div>\n    `;\n  });\n\n  // Tasks loop list\n  var tasksHtml = \"\";\n  if (dealTasks.length === 0) {\n    tasksHtml = '<div class=\"task-empty\">Aucune tâche liée</div>';\n  } else {\n    dealTasks.forEach(t => {\n      var checkedCls = t.completed ? \"checked\" : \"\";\n      var doneCls = t.completed ? \"done\" : \"\";\n      var prioCls = \"moy\";\n      var prioLabel = \"Moy.\";\n      if (t.priority === \"haute\") { prioCls = \"haute\"; prioLabel = \"Haute\"; }\n      else if (t.priority === \"faible\") { prioCls = \"basse\"; prioLabel = \"Faible\"; }\n      \n      tasksHtml += `\n        <div class=\"task-row ${doneCls}\">\n          <div class=\"task-check ${checkedCls}\" onclick=\"toggleFicheTask('${t.id}')\"></div>\n          <div class=\"task-name\">${t.title}</div>\n          <div class=\"task-meta\">\n            <span class=\"task-date\">${t.day}/05</span>\n            <span class=\"prio-chip ${prioCls}\">${prioLabel}</span>\n          </div>\n        </div>\n      `;\n    });\n  }\n\n  // Notes loop list\n  var notesHtml = \"\";\n  dealNotes.forEach(n => {\n    notesHtml += `\n      <div class=\"note-item\">\n        <div class=\"note-avatar\">${n.avatar}</div>\n        <div style=\"flex:1; min-width:0;\">\n          <div class=\"note-header\">\n            <span class=\"note-author\">${n.author}</span>\n            <span class=\"note-date\">${n.date}</span>\n          </div>\n          <div class=\"note-text\">${n.text}</div>\n        </div>\n      </div>\n    `;\n  });\n\n  // Commission dynamic status\n  var commStatus = (d.stage === 'vendu') ? 'Reçue' : ((d.stage === 'perdu') ? 'Annulée' : 'Ouverte');\n\n  // Ins