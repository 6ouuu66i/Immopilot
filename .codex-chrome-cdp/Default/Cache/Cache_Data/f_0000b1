px 2px 8px rgba(0, 0, 0, 0.03);\n}\n.fiche.da-prop3 .map-container-mock {\n  border: 1px solid #EFE6DD;\n  border-radius: 12px;\n}\n.fiche.da-prop3 .note-input {\n  border: 1.2px solid #EFE6DD;\n  border-radius: 20px;\n}\n.fiche.da-prop3 .note-save {\n  border-radius: 50%;\n  box-shadow: 0px 3px 8px rgba(30, 90, 58, 0.18);\n}\n</style>\n\n<!-- ========================================== -->\n<!-- SCRIPTS TO HANDLE DESK TESTING BEHAVIORS   -->\n<!-- ========================================== -->\n<script>\n(function() {\n  \n  // Theme Switching Manager\n  window.switchTheme = function(proposalId) {\n    var sheet = document.getElementById(\"mock-grande-fiche\");\n    var indicator = document.getElementById(\"active-proposal-indicator\");\n    \n    // Reset active buttons inside switcher panel\n    var buttons = document.querySelectorAll(\".switcher-btn\");\n    buttons.forEach(function(btn) {\n      btn.classList.remove(\"active\");\n    });\n    \n    // Set target active button highlit\n    var activeBtn = document.getElementById(\"btn-\" + proposalId);\n    if (activeBtn) activeBtn.classList.add(\"active\");\n    \n    // Mutate class on structural block\n    if (sheet) {\n      sheet.className = \"fiche \" + proposalId;\n    }\n    \n    // Update active badge name\n    var readableName = \"Crayon d'Architecte (01)\";\n    if (proposalId === \"da-prop2\") readableName = \"Carnet Griffonné (02)\";\n    if (proposalId === \"da-prop3\") readableName = \"Aquarelle & Surligneur (03)\";\n    \n    if (indicator) {\n      indicator.innerHTML = \"Piste active : \" + readableName;\n    }\n    \n    // Custom satisfy confirmation toast\n    var toast = document.getElementById(\"decision-toast\");\n    var toastTitle = document.getElementById(\"chosen-da-title\");\n    \n    if (toast && toastTitle) {\n      toastTitle.innerHTML = readableName;\n      toast.style.display = \"flex\";\n      \n      // Persist choice in LocalStorage\n      localStorage.setItem(\"immo_selected_da_piste\", proposalId);\n      \n      // Auto fadeout indicator\n      setTimeout(function() {\n        // Double checked if active route didn't change in between\n        if (localStorage.getItem(\"immo_selected_da_piste\") === proposalId) {\n          toast.style.borderColor = \"#1E5A3A\";\n        }\n      }, 5000);\n    }\n  };\n  \n  // Initialize from LocalStorage of previously clicked proposal\n  var savedDa = localStorage.getItem(\"immo_selected_da_piste\");\n  if (savedDa && (savedDa === \"da-prop1\" || savedDa === \"da-prop2\" || savedDa === \"da-prop3\")) {\n    setTimeout(function() {\n      window.switchTheme(savedDa);\n    }, 50);\n  }\n\n  // --- HIGHLIGHT COLLAPSIBLE MC BLOCKS ---\n  window.toggleLocalBlock = function(headerElement) {\n    var parentBlock = headerElement.closest(\".mc\");\n    if (parentBlock) {\n      parentBlock.classList.toggle(\"collapsed\");\n    }\n  };\n\n  // --- CAROUSEL SLIDER ENGINE ---\n  var mockPhotos = [\n    \"https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=1200&q=85\",\n    \"https://images.unsplash.com/photo-1600566753086-00f18fe6ede1?w=1200&q=85\",\n    \"https://images.unsplash.com/photo-1600573472550-8090b5e0745e?w=1200&q=85\",\n    \"https://images.unsplash.com/photo-1505691938895-1758d7feb511?w=1200&q=85\",\n    \"https://images.unsplash.com/photo-1568605114967-8130f3a36994?w=1200&q=85\"\n  ];\n  var activePhotoIndex = 0;\n\n  window.selectMockPhoto = function(index) {\n    activePhotoIndex = index;\n    updateMockCarousel();\n  };\n\n  window.changeMockPhoto = function(delta) {\n    activePhotoIndex += delta;\n    if (activePhotoIndex >= mockPhotos.length) activePhotoIndex = 0;\n    if (activePhotoIndex < 0) activePhotoIndex = mockPhotos.length - 1;\n    updateMockCarousel();\n  };\n\n  function updateMockCarousel() {\n    var img = document.getElementById(\"gf-main-img\");\n    var counter = document.getElementById(\"gf-gallery-counter\");\n    if (img) {\n      img.src = mockPhotos[activePhotoIndex];\n    }\n    if (counter) {\n      counter.innerHTML = (activePhotoIndex + 1) + \" / \" + mockPhotos.length;\n    }\n    \n    // Highlight thumbnail boundary\n    var thumbs = document.querySelectorAll(\".hero-thumb\");\n    thumbs.forEach(function(th, i) {\n      if (i === activePhotoIndex) {\n        th.classList.add(\"active\");\n      } else {\n        th.classList.remove(\"active\");\n      }\n    });\n  }\n\n  // --- PERSISTENT EVALUATION NOTES INTERACTION ---\n  var mockNotes = [\n    { text: \"L'isolation thermique de la toiture a été refaite à neuf en 2019 (vérifié avec facture de l'entreprise).\", date: \"23/05/2026 14:15\" },\n    { text: \"La pompe à chaleur a fait l'objet d'un examen d'entretien en février de cette année. Excellent entretien général.\", date: \"23/05/2026 15:40\" }\n  ];\n\n  window.renderMockNotes = function() {\n    var container = document.getElementById(\"gf-notes-log\");\n    if (!container) return;\n    \n    if (mockNotes.length === 0) {\n      container.innerHTML = '<div style=\"text-align:center; color:#8E8B83; font-size:11px; padding:12px; font-family:\\'JetBrains Mono\\',monospace;\">Aucun rapport technique enregistré.</div>';\n      return;\n    }\n    \n    var html = \"\";\n    mockNotes.forEach(function(note, idx) {\n      html += '<div class=\"logged-note-box\">';\n      html += '  <span class=\"note-time-stamp\">' + note.date + '</span>';\n      html += '  <div>' + note.text + '</div>';\n      html += '  <button class=\"delete-mock-note\" onclick=\"deleteMockNote(' + idx + ')\">&times;</button>';\n      html += '</div>';\n    });\n    container.innerHTML = html;\n  };\n\n  window.addMockNote = function() {\n    var input = document.getElementById(\"tests-note-input\");\n    if (!input || !input.value.trim()) return;\n    \n    var text = input.value.trim();\n    var now = new Date();\n    var dateString = now.toLocaleDateString('fr-BE') + \" \" + now.toLocaleTimeString('fr-BE', {hour: '2-digit', minute:'2-digit'});\n    \n    mockNotes.push({ text: text, date: dateString });\n    input.value = \"\";\n    window.renderMockNotes();\n  };\n\n  window.deleteMockNote = function(index) {\n    mockNotes.splice(index, 1);\n    window.renderMockNotes();\n  };\n\n  // --- FAVORITE ANIMATED STATE LOGIC ---\n  var mockFavorite = false;\n  window.toggleMockFavorite = function() {\n    mockFavorite = !mockFavorite;\n    var svg = document.getElementById(\"fav-svg\");\n    var txt = document.getElementById(\"fav-text\");\n    if (svg && txt) {\n      if (mockFavorite) {\n        svg.setAttribute(\"fill\", \"currentColor\");\n        txt.innerHTML = \"Favori ✔\";\n        txt.style.color = \"#1E5A3A\";\n      } else {\n        svg.setAttribute(\"fill\", \"none\");\n        txt.innerHTML = \"Favori\";\n        txt.style.color = \"\";\n      }\n    }\n  };\n\n  // Initial rendering of components\n  window.renderMockNotes();\n\n  // Load interactive Google Map for local address\n  if (window.renderInteractiveMap) {\n    window.renderInteractiveMap('tests-map-container', 'Lasne', 'Chemin du Try 14, 1380 Lasne');\n  }\n\n})();\n</script>\n"
