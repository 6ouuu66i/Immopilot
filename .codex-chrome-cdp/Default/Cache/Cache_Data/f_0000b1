x 0px #1D1F1E;\n}\n\n\n/* ────────────────────────────────────────────────────────── */\n/* OPTION 2 : CARNET GRIFFONNÉ (02)                          */\n/* ────────────────────────────────────────────────────────── */\n.fiche.da-prop2 {\n  background-color: #FFFFFF;\n  border: 2px solid #1D1F1E;\n  border-radius: 255px 15px 225px 15px/15px 225px 15px 255px; /* Skew wavy bounding border */\n  box-shadow: 3px 6px 0px rgba(29, 31, 30, 0.12);\n}\n.fiche.da-prop2 .mc {\n  border: 2px solid #1D1F1E;\n  border-radius: 180px 15px 210px 12px/12px 210px 15px 180px;\n  background-color: #FCFAF6;\n  box-shadow: 3px 3px 0px rgba(142, 139, 131, 0.25);\n}\n.fiche.da-prop2 .mc-label {\n  font-family: 'Caveat', cursive, sans-serif;\n  font-size: 15px;\n  font-weight: 700;\n  text-transform: capitalize;\n  letter-spacing: 0.01em;\n  color: #7A5128;\n  background: #FDF4E3; /* Masking tape representation */\n  border: 1.2px dashed rgba(161, 98, 7, 0.45);\n  box-shadow: 2px 3px 6px rgba(120, 53, 15, 0.06);\n  display: inline-block;\n  padding: 3px 12px;\n  border-radius: 3px;\n  transform: rotate(-1.5deg);\n  width: fit-content;\n  position: relative;\n}\n.fiche.da-prop2 .mc-label::before {\n  content: '';\n  position: absolute;\n  left: -4px; top: 0; bottom: 0; width: 4px;\n  background-size: 2px 4px;\n  background-image: linear-gradient(45deg, transparent 50%, #FAF3E0 50%), linear-gradient(-45deg, transparent 50%, #FAF3E0 50%);\n}\n.fiche.da-prop2 .mc-label::after {\n  content: '';\n  position: absolute;\n  right: -4px; top: 0; bottom: 0; width: 4px;\n  background-size: 2px 4px;\n  background-image: linear-gradient(45deg, #FAF3E0 50%, transparent 50%), linear-gradient(-45deg, #FAF3E0 50%, transparent 50%);\n}\n.fiche.da-prop2 .hero {\n  border: 2px solid #1D1F1E;\n  border-radius: 220px 20px 180px 20px/20px 160px 20px 220px;\n}\n.fiche.da-prop2 .btn-primary {\n  background: #1E5A3A;\n  border: 2px solid #1D1F1E;\n  border-radius: 255px 15px 225px 15px/15px 225px 15px 255px;\n  box-shadow: 3px 3px 0px #1D1F1E;\n}\n.fiche.da-prop2 .btn-secondary {\n  background: #FFFFFF;\n  border: 2px solid #1D1F1E;\n  border-radius: 255px 15px 225px 15px/15px 225px 15px 255px;\n  box-shadow: 2px 2px 0px #1D1F1E;\n}\n.fiche.da-prop2 .btn:hover {\n  transform: translate(-1px, -1px);\n  box-shadow: 4px 4px 0px #1D1F1E;\n}\n.fiche.da-prop2 .description-text {\n  font-family: 'Architects Daughter', cursive;\n  font-size: 12.5px;\n  color: #2D2F2E;\n  line-height: 1.6;\n}\n.fiche.da-prop2 .vendor-initials-badge {\n  background: #FFFFFF;\n  border: 1.8px solid #1D1F1E;\n  border-radius: 50% 48% 52% 48%;\n  color: #1D1F1E;\n}\n.fiche.da-prop2 .score-radial-wrap {\n  border: 2px solid #1D1F1E;\n  border-radius: 51% 49% 52% 48%;\n  background: conic-gradient(from 15deg, #1E5A3A 0%, #7FA68E 45%, #DFD3C3 85%, #EFE6DD 100%);\n}\n.fiche.da-prop2 .score-outer-circle {\n  border-radius: 50% 48% 52% 48%;\n  border: 1.5px solid #1D1F1E;\n}\n.fiche.da-prop2 .ai-badge-tag {\n  border: 1.5px solid #1D1F1E;\n  border-radius: 4px 8px 4px 6px;\n  font-family: 'Caveat', cursive;\n  font-weight: 700;\n  font-size: 13.5px;\n}\n.fiche.da-prop2 .source-link {\n  border: 2px solid #1D1F1E;\n  border-radius: 4px 8px;\n  transform: rotate(0.5deg);\n}\n.fiche.da-prop2 .map-container-mock {\n  border: 2px solid #1D1F1E;\n  border-radius: 12px 4px 12px 4px;\n}\n.fiche.da-prop2 .note-input {\n  border: 1.8px solid #1D1F1E;\n  border-radius: 8px 4px;\n  font-family: 'Architects Daughter', cursive;\n}\n.fiche.da-prop2 .note-save {\n  border-radius: 4px 8px;\n  border: 1.8px solid #1D1F1E;\n  box-shadow: 2.5px 2.5px 0px #1D1F1E;\n}\n\n\n/* ────────────────────────────────────────────────────────── */\n/* OPTION 3 : AQUARELLE & SURLIGNEUR (03)                    */\n/* ────────────────────────────────────────────────────────── */\n.fiche.da-prop3 {\n  background-color: #FAF8F5;\n  border: 1px solid #EFE6DD;\n  box-shadow: \n    0px 10px 30px rgba(30, 90, 58, 0.04), \n    0px 1px 3px rgba(0, 0, 0, 0.0