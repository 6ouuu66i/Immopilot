 11px; font-weight: 700; color: var(--stone); flex-shrink: 0; }\n.contact-name { font-size: 13px; font-weight: 600; color: var(--ink); }\n.contact-email { font-size: 11.5px; color: var(--stone); margin-top: 1px; }\n\n.tel-cell { font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--ink); }\n\n.pill { display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 999px; font-size: 11px; font-weight: 600; }\n.pill.discussion { background: #DCE9F1; color: #2E5C7A; }\n.pill.contacte { background: #D6E8D9; color: #2E5C3F; }\n.pill.pas { background: #EBE6DA; color: #6B6F6D; }\n.pill.converti { background: var(--forest); color: #FFFFFF; }\n.pill.perdu { background: #F2D6D0; color: #8C3D2E; }\n\n.num-cell { font-size: 13px; font-weight: 500; color: var(--ink); }\n\n.activity-cell { font-size: 12px; }\n.activity-cell .day { color: var(--ink); font-weight: 500; }\n.activity-cell .desc { color: var(--stone); margin-top: 1px; font-size: 11.5px; }\n\n.next-action { display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px; border-radius: 4px; background: var(--bone); border: 1px solid #F1ECDF; font-size: 11.5px; color: var(--ink); font-weight: 500; }\n.next-action svg { color: var(--forest); }\n.next-action.none { color: var(--stone-light); background: transparent; border-style: dashed; }\n\n.pagination { display: flex; align-items: center; justify-content: center; gap: 6px; padding: 14px; border-top: 1px solid #F1ECDF; }\n.pagination button { min-width: 32px; height: 32px; padding: 0 10px; border: 1px solid var(--sand-deep); background: #FFFFFF; border-radius: 4px; font: inherit; font-size: 12.5px; font-weight: 500; color: var(--ink); cursor: pointer; transition: all 140ms; }\n.pagination button:hover:not(:disabled) { border-color: var(--forest); color: var(--forest); }\n.pagination button.active { background: var(--forest); color: #FFFFFF; border-color: var(--forest); }\n.pagination button:disabled { opacity: 0.4; cursor: not-allowe