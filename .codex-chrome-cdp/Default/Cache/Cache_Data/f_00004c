      </div>\n      <div class=\"page-title\">\n        <span class=\"page-title-icon\" aria-hidden=\"true\">\n          <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 21h18\"/><path d=\"M5 21V7l8-4 6 4v14\"/><path d=\"M9 9h1\"/><path d=\"M14 9h1\"/><path d=\"M9 13h1\"/><path d=\"M14 13h1\"/><path d=\"M10 21v-4h4v4\"/></svg>\n        </span>\n        <div>\n          <h1>Biens</h1>\n          <p class=\"page-subtitle\">Base de prospection, signaux et opportunités immobilières.</p>\n        </div>\n      </div>\n      <div class=\"page-header-row\">\n        <div class=\"kpi-dashboard\">\n          <div class=\"kpi-item\">\n            <div class=\"kpi-title\">Biens disponibles</div>\n            <div class=\"kpi-value\" id=\"kpi-available\">0</div>\n            <div class=\"kpi-trend\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:11px;height:11px;\"><line x1=\"12\" y1=\"19\" x2=\"12\" y2=\"5\"/><polyline points=\"5 12 12 5 19 12\"/></svg>\n              <span>12</span> nouveaux ce jour\n            </div>\n          </div>\n          <div class=\"kpi-divider\"></div>\n          <div class=\"kpi-item\">\n            <div class=\"kpi-title\">FSBO</div>\n            <div class=\"kpi-value\" id=\"kpi-fsbo\">0</div>\n            <div class=\"kpi-trend\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:11px;height:11px;\"><line x1=\"12\" y1=\"19\" x2=\"12\" y2=\"5\"/><polyline points=\"5 12 12 5 19 12\"/></svg>\n              <span>5</span> cette semaine\n            </div>\n          </div>\n          <div class=\"kpi-divider\"></div>\n          <div class=\"kpi-item\">\n            <div class=\"kpi-title\">Score IA moyen</div>\n            <div class=\"kpi-value\" id=\"kpi-score\">0</div>\n            <div class=\"kpi-trend\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:11px;height:11px;\"><line x1=\"12\" y1=\"19\" x2=\"12\" y2=\"5\"/><polyline points=\"5 12 12 5 19 12\"/></svg>\n              3% ce mois\n            </div>\n          </div>\n          <div class=\"kpi-divider\"></div>\n          <div class=\"kpi-item\">\n            <div class=\"kpi-title\">Mes favoris</div>\n            <div class=\"kpi-value\" id=\"kpi-fav\">0</div>\n            <div class=\"kpi-trend\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"width:11px;height:11px;\"><line x1=\"12\" y1=\"19\" x2=\"12\" y2=\"5\"/><polyline points=\"5 12 12 5 19 12\"/></svg>\n              <span>2</span> cette semaine\n            </div>\n          </div>\n        </div>\n        <div class=\"page-actions\">\n          <button class=\"page-btn\" onclick=\"toggleFiche()\">\n            <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><line x1=\"9\" y1=\"3\" x2=\"9\" y2=\"21\"/></svg>\n            <span id=\"toggle-label\">Ouvrir mini fiche</span>\n          </button>\n          <button class=\"page-btn primary\">\n            <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"><line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"/><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"/></svg>\n            Ajouter un bien\n          </button>\n        </div>\n      </div>\n    </header>\n\n    <!-- Toolbar : search + sort -->\n    <div class=\"toolbar\" style=\"display: flex; gap: 8px; align-items: center;\">\n      <input type=\"text\" class=\"search-input\" id=\"search\" placeholder=\"Rechercher un bien, ville, source…\" style=\"flex: 1;\">\n      \n      <!-- Premium View Toggle Button Group -->\n      <div id=\"view-toggle-container\" class=\"view-toggle-container\" style=\"display: flex; border: 1.5px solid var(--stone); border-radius: 2px !important; overflow: hidden; height: 32px; background: white; box-shadow: 1.5px 1.5px 0px var(--forest-soft); margin-right: 4px; flex-shrink: 0;\">\n        <button id=\"view-mode-grid\" class=\"view-btn\" title=\"Vue Grille\" onclick=\"setViewMode('grid')\" style=\"border: none; background: var(--forest); color: white; border-right: 1.5px solid var(--stone); width: 34px; height: 100%; display: grid; place-items: center; cursor: pointer; transition: all 120ms; outline: none; padding: 0;\">\n          <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\"/></svg>\n        </button>\n        <button id=\"view-mode-list\" class=\"view-btn\" title=\"Vue Liste\" onclick=\"setViewMode('list')\" style=\"border: none; background: white; color: var(--stone); width: 34px; height: 100%; display: grid; place-items: center; cursor: pointer; transition: all 120ms; outline: none; padding: 0;\">\n          <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"><line x1=\"8\" y1=\"6\" x2=\"21\" y2=\"6\"/><line x1=\"8\" y1=\"12\" x2=\"21\" y2=\"12\"/><line x1=\"8\" y1=\"18\" x2=\"21\" y2=\"18\"/><line x1=\"3\" y1=\"6\" x2=\"3.01\" y2=\"6\"/><line x1=\"3\" y1=\"12\" x2=\"3.01\" y2=\"12\"/><line x1=\"3\" y1=\"18\" x2=\"3.01\" y2=\"18\"/></svg>\n        </button>\n      </div>\n\n      <select class=\"sort-select\" id=\"sort\" style=\"margin-left: 0; height: 32px; border-radius: 2px !important;\">\n        <option value=\"recent\">Plus récents</option>\n        <option value=\"oldest\">Plus anciens</option>\n        <option value=\"price-desc\">Prix décroissant</option>\n        <option value=\"price-asc\">Prix croissant</option>\n        <option value=\"score-desc\">Score IA décroissant</option>\n        <option value=\"score-asc\">Score IA croissant</option>\n      </select>\n    </div>\n\n    <!-- Real Interactive Filters Row -->\n    <div class=\"filters-strip\" style=\"display: flex; flex-wrap: wrap; gap: 12px; align-items: center;\">\n      <div style=\"font-weight: 700; font-size: 11px; text-transform: uppercase; color: var(--forest); display: flex; align-items: center; gap: 4px;\">\n        <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><polygon points=\"22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3\"/></svg>\n        Filtres actifs:\n      </div>\n      \n      <!-- Commune Filter -->\n      <select id=\"filter-city\" class=\"sort-select\" style=\"height: 30px; padding: 0 24px 0 8px; font-size: 11px; font-weight: 600; background-position: right 8px center; border-radius: 120px 20px 100px 20px/20px 100px 20px 120px !important; width: auto; margin-right: 0;\">\n        <option value=\"\">Communes (Toutes)</option>\n        <option value=\"Lasne\">Lasne</option>\n        <option value=\"Ixelles\">Ixelles</option>\n        <option value=\"Uccle\">Uccle</option>\n        <option value=\"Waterloo\">Waterloo</option>\n        <option value=\"Bruxelles\">Bruxelles</option>\n        <option value=\"Etterbeek\">Etterbeek</option>\n        <option value=\"Schaerbeek\">Schaerbeek</option>\n        <option value=\"Saint-Gilles\">Saint-Gilles</option>\n        <option value=\"Forest\">Forest</option>\n        <option value=\"Anderlecht\">Anderlecht</option>\n        <option value=\"Woluwe-Saint-Pierre\">Woluwe-St-Pierre</option>\n        <option value=\"Auderghem\">Auderghem</option>\n      </select>\n      \n      <!-- Source Filter -->\n      <select id=\"filter-source\" class=\"sort-select\" style=\"height: 30px; padding: 0 24px 0 8px; font-size: 11px; font-weight: 600; background-position: right 8px center; border-radius: 120px 20px 100px 20px/20px 100px 20px 120px !important; width: auto; margin-right: 0;\">\n        <option value=\"\">Sources (Toutes)</option>\n        <option value=\"Zimmo\">Zimmo</option>\n        <option value=\"Immoweb\">Immoweb</option>\n        <option value=\"Immovlan\">Immovlan</option>\n        <option value=\"2ememain\">2ememain</option>\n        <option value=\"Biddit\">Biddit</option>\n      </select>\n\n      <!-- Label/Tag Filter -->\n      <select id=\"filter-tag\" class=\"sort-select\" style=\"height: 30px; padding: 0 24px 0 8px; font-size: 11px; font-weight: 600; background-position: right 8px center; border-radius: 120px 20px 100px 20px/20px 100px 20px 120px !important; width: auto; margin-right: 0;\">\n        <option value=\"\">Signaux IA (Tous)</option>\n        <option value=\"FSBO\">Particulier (FSBO)</option>\n        <option value=\"Baisse de prix\">Baisse de prix</option>\n        <option value=\"Republié\">Republié</option>\n        <option value=\"Coup de cœur\">Coup de cœur</option>\n        <option value=\"Nouveau\">Nouveau</option>\n      </select>\n\n      <!-- Favorites Filter as an Aesthetic Button -->\n      <button id=\"filter-fav-btn\" style=\"height: 30px; font-size: 11px; font-weight: 700; border-radius: 120px 20px 100px 20px/20px 100px 20px 120px !important; border: 1.5px solid var(--stone); background: white; cursor: pointer; display: flex; align-items: center; gap: 4px; padding: 0 12px; transition: all 150ms ease; color: var(--stone); outline: none;\">\n        <svg width=\"11\" height=\"11\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"/></svg>\n        Favoris uniquement\n      </button>\n\n      <!-- Reset Filters Link -->\n      <button id=\"filter-reset\" style=\"background: none; border: none; font-size: 11px; color: var(--stone); text-decoration: underline; cursor: pointer; font-weight: 600; outline: none; margin-left: auto;\">\n        Réinitialiser\n      </button>\n    </div>\n\n    <div class=\"catalogue-wrap\">\n      <div class=\"catalogue-meta\">\n        <span><strong id=\"result-count\">0</strong> biens affichés</span>\n        <div class=\"catalogue-page-controls\">\n          <span class=\"pagination-info\" id=\"pagination-summary\">Page 1</span>\n          <div class=\"pagination\" id=\"pagination\"></div>\n        </div>\n      </div>\n      <div class=\"catalogue-grid\" id=\"grid\"></div>\n    </div>\n  </main>\n\n  <aside class=\"fiche-panel\" id=\"fiche-panel\">\n    <div class=\"fiche-panel-mock\">\n      Cliquez sur un bien pour afficher sa fiche détaillée à droite.\n    </div>\n  </aside>\n\n  <!-- Lightbox block (item 7-8-11) -->\n  <div class=\"lightbox\" id=\"lightbox\" onclick=\"closeLightbox()\">\n    <button class=\"lightbox-close\" onclick=\"event.stopPropagation(); closeLightbox()\">&times;</button>\n    <button class=\"lightbox-nav prev\" onclick=\"event.stopPropagation(); navigateLightbox(-1)\">&lsaquo;</button>\n    <button class=\"lightbox-nav next\" onclick=\"event.stopPropagation(); navigateLightbox(1)\">&rsaquo;</button>\n    <div class=\"lightbox-img-wrap\" onclick=\"event.stopPropagation()\">\n      <img src=\"\" class=\"lightbox-img\" id=\"lightbox-img\" alt=\"\">\n      <div class=\"lightbox-counter\" id=\"lightbox-counter\">1 / 1</div>\n    </div>\n    <div class=\"lb-thumbs\" id=\"lightbox-thumbs\" onclick=\"event.stopPropagation()\"></div>\n  </div>\n\n  <!-- Grande Fiche Bien Overlay Modal -->\n  <div class=\"backdrop\" id=\"grande-fiche-modal\" onclick=\"event.target === this && window.closeGrandeFiche()\">\n    <div class=\"fiche\" onclick=\"event.stopPropagation()\" id=\"grande-fiche-content-wrapper\">\n      <!-- Generated dynamically in window.openGrandeFiche -->\n    </div>\n  </div>\n</div>\n\n<script>\nvar PHOTO_SETS = [\n  ['https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=600&q=80','https://images.unsplash.com/photo-1600566753086-00f18fe6ede1?w=600&q=80','https://images.unsplash.com/photo-1600573472550-8090b5e0745e?w=600&q=80'],\n  ['https://images.unsplash.com/photo-1568605114967-8130f3a36994?w=600&q=80','https://images.unsplash.com/photo-1502672023488-70e25813eb80?w=600&q=80','https://images.unsplash.com/photo-1505691938895-1758d7feb511?w=600&q=80'],\n  ['https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=600&q=80','https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?w=600&q=80'],\n  ['https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?w=600&q=80','https://images.unsplash.com/photo-1600573472556-e636c2acda88?w=600&q=80'],\n];\n\nvar TAGS = ['FSBO','Baisse de prix','Republié','Coup de cœur','Nouveau'];\nvar CITIES = ['Lasne','Ixelles','Uccle','Waterloo','Bruxelles','Etterbeek','Schaerbeek','Saint-Gilles','Forest','Anderlecht','Woluwe-Saint-Pierre','Auderghem'];\nvar SOURCES = ['Zimmo','Immoweb','Immovlan','2ememain','Biddit'];\nvar TITLES = ['Villa basse énergie','Appartement lumineux','Maison 3 façades','Penthouse vue parc','Triplex art-déco','Maison familiale','Loft industriel','Duplex avec terrasse','Studio rénové','Maison de maître','Appartement neuf','Villa contemporaine','Maison à rénover'];\n\nfunction makeProp(i) {\n  const photos = PHOTO_SETS[i % PHOTO_SETS.length];\n  const tag = TAGS[i % TAGS.length];\n  const score = 50 + Math.floor((Math.random() * 100 + i * 7) % 49);\n  const peb = ['A','B','C','D'][i % 4];\n  const reserved = i % 9 === 0 && i > 0;\n  const days = i;\n  return {\n    id: i + 1,\n    title: TITLES[i % TITLES.length],\n    city: CITIES[i % CITIES.length],\n    price: (250000 + (i * 7919) % 1500000),\n    photos, tag,\n    score, peb,\n    surface: 60 + (i * 13) % 250,\n    bedrooms: 1 + (i % 5),\n    bathrooms: 1 + (i % 3),\n    source: SOURCES[i % SOURCES.length],\n    reserved,\n    fsbo: tag === 'FSBO',\n    publishedDays: days,\n    favorite: i % 7 === 0,\n  };\n}\n\nvar PROPS = [];\nfunction loadPropsFromStore() {\n  const store = window.ImmoPilotStore;\n  if (!store) return;\n  PROPS = store.getProperties().map(p => {\n    const marks = store.getMarks(p.id);\n    return {\n      ...p,\n      favorite: marks.favorite,\n      ignored: marks.ignored\n    };\n  });\n}\n// Load on file execute\nloadPropsFromStore();\n\nvar PAGE = 1;\nvar PER_PAGE = 24;\nvar SEARCH = '';\nvar SORT = 'recent';\nvar VIEW_MODE = localStorage.getItem('immo_view_mode') || 'grid';\n\nwindow.setViewMode = function(mode) {\n  VIEW_MODE = mode;\n  localStorage.setItem('immo_view_mode', VIEW_MODE);\n  render();\n};\n\nvar FILTER_CITY = '';\nvar FILTER_SOURCE = '';\nvar FILTER_TAG = '';\nvar FILTER_FAV = false;\n\nfunction filteredProps() {\n  let res = PROPS.filter(p => {\n    if (p.ignored) return false;\n    if (SEARCH && !(p.title + ' ' + p.city + ' ' + p.source).toLowerCase().includes(SEARCH.toLowerCase())) return false;\n    if (FILTER_CITY && p.city !== FILTER_CITY) return false;\n    if (FILTER_SOURCE && p.source !== FILTER_SOURCE) return false;\n    if (FILTER_TAG && p.tag !== FILTER_TAG) return false;\n    if (FILTER_FAV && !p.favorite) return false;\n    return true;\n  });\n  switch (SORT) {\n    case 'oldest': res.sort((a,b) => b.publishedDays - a.publishedDays); break;\n    case 'price-asc': res.sort((a,b) => a.price - b.price); break;\n    case 'price-desc': res.sort((a,b) => b.price - a.price); break;\n    case 'score-asc': res.sort((a,b) => a.score - b.score); break;\n    case 'score-desc': res.sort((a,b) => b.score - a.score); break;\n    default: res.sort((a,b) => a.publishedDays - b.publishedDays);\n  }\n  return res;\n}\n\nfunction fmtPrice(n) { return new Intl.NumberFormat('fr-BE').format(n) + ' €'; }\n\n// Double Gribouillis Style 1 Helper\nfunction getSketchScoreHtml(score) {\n  let scoreClass = 'score-excellent';\n  if (score < 60) {\n    scoreClass = 'score-critical';\n  } else if (score < 80) {\n    scoreClass = 'score-moderate';\n  }\n  \n  const cappedScore = Math.min(100, Math.max(0, score));\n  const offset = Math.round(180 - (180 * (cappedScore / 100)));\n  \n  return `\n    <svg viewBox=\"0 0 100 100\" class=\"sketch-double-score ${scoreClass}\">\n      <path d=\"M 50,11 C 71,9 87,25 89,49 C 91,73 75,89 50,87 C 25,85 9,69 11,49 C 13,29 29,13 50,11 Z\" class=\"sketch-bg-fill\" />\n      <path d=\"M 50,11 C 71,9 87,25 89,49 C 91,73 75,89 50,87 C 25,85 9,69 11,49 C 13,29 29,13 50,11 Z\" class=\"sketch-circle-back-1\" />\n      <path d=\"M 51,9 C 73,12 89,29 86,52 C 83,75 66,90 43,88 C 21,86 7,67 10,41 C 13,15 29,5 51,9 Z\" class=\"sketch-circle-back-2\" />\n      <path class=\"sketch-progress-ribbon\" d=\"M 22,70 C 13,50 17,29 37,18 C 57,7 78,13 86,33 C 94,53 85,74 65,83\" stroke-dasharray=\"180\" stroke-dashoffset=\"${offset}\" />\n      <text x=\"50\" y=\"52\" class=\"sketch-text-score\" style=\"font-size: 32px;\">${score}</text>\n    </svg>\n  `;\n}\n\nfunction renderCard(p) {\n  const photosAttr = p.photos.join('|');\n  const reservedCls = p.reserved ? ' reserved' : '';\n  const activeCls = (SELECTED_PROP_ID === p.id) ? ' active-selection' : '';\n  const tagText = p.reserved ? 'Réservé' : p.tag;\n  const tagClass = p.reserved ? 'reserved' : (p.tag === 'FSBO' ? 'fsbo' : p.tag.includes('Baisse') ? 'baisse' : p.tag === 'Republié' ? 'republic' : p.tag === 'Coup de cœur' ? 'coup' : 'nouveau');\n  const secondaryTag = p.reserved && p.tag.includes('Baisse') ? '<span class=\"photo-tag secondary\">Prix</span>' : '';\n  return `\n  <article class=\"card${reservedCls}${activeCls}\" id=\"card-prop-${p.id}\" onclick=\"openFiche(${p.id})\">\n    <div class=\"card-photo\" data-photos=\"${photosAttr}\">\n      <img src=\"${p.photos[0]}\" alt=\"\" loading=\"lazy\">\n      <span class=\"photo-tag ${tagClass}\">${tagText}</span>\n      ${secondaryTag}\n      <button class=\"photo-nav prev\" aria-label=\"Précédente\" onclick=\"event.stopPropagation()\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"><polyline points=\"15 18 9 12 15 6\"/></svg></button>\n      <button class=\"photo-nav next\" aria-label=\"Suivante\" onclick=\"event.stopPropagation()\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"><polyline points=\"9 18 15 12 9 6\"/></svg></button>\n      <div class=\"photo-dots\">${p.photos.map((_, i) => '<span'+(i===0?' class=\"active\"':'')+'></span>').join('')}</div>\n    </div>\n    <div class=\"score-c\">${getSketchScoreHtml(p.score)}</div>\n    <div class=\"card-body\">\n      <div class=\"row-price\">\n        <span class=\"card-price\">${fmtPrice(p.price)}</span>\n        <span class=\"pill-disponible\">${p.reserved ? 'Réservé' : 'Disponible'}</span>\n      </div>\n      <div class=\"card-title\">${p.title}</div>\n      <div class=\"card-locality\">\n        <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/></svg>\n        ${p.city}\n      </div>\n      <div class=\"card-specs\">\n        <span class=\"spec\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"1\"/></svg>${p.surface} m²</span>\n        <span class=\"spec\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M2 8v12M22 12v8M2 12h20M5 12V8h14v4\"/></svg>${p.bedrooms}</span>\n        <span class=\"spec\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M9 6V4a2 2 0 0 1 4 0v2M3 11h18M5 11v7a3 3 0 0 0 3 3h8a3 3 0 0 0 3-3v-7\"/></svg>${p.bathrooms}</span>\n        <span class=\"spec-peb\"><span class=\"peb ${p.peb.toLowerCase()}\">${p.peb}</span></span>\n      </div>\n      <div class=\"card-foot\">\n        <span class=\"source-meta\">\n          <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"2\" y1=\"12\" x2=\"22\" y2=\"12\"/><path d=\"M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z\"/></svg>\n          ${p.source}\n        </span>\n        <button class=\"fav-btn ${p.favorite ? 'active' : ''}\" aria-label=\"Favori\" onclick=\"event.stopPropagation(); window.togglePropFavorite(${p.id})\">\n          <svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"${p.favorite ? 'currentColor' : 'none'}\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"/></svg>\n        </button>\n      </div>\n    </div>\n  </article>`;\n}\n\nfunction render() {\n  loadPropsFromStore();\n  const all = filteredProps();\n  const total = all.length;\n  const totalPages = Math.max(1, Math.ceil(total / PER_PAGE));\n  if (PAGE > totalPages) PAGE = totalPages;\n  const start = (PAGE - 1) * PER_PAGE;\n  const items = all.slice(start, start + PER_PAGE);\n\n  const grid = document.getElementById('grid');\n  if (VIEW_MODE === 'list') {\n    grid.classList.add('list-mode');\n  } else {\n    grid.classList.remove('list-mode');\n  }\n\n  // Update view toggle active style state\n  const btnGrid = document.getElementById('view-mode-grid');\n  const btnList = document.getElementById('view-mode-list');\n  if (btnGrid && btnList) {\n    btnGrid.classList.toggle('is-active', VIEW_MODE !== 'list');\n    btnList.classList.toggle('is-active', VIEW_MODE === 'list');\n    if (VIEW_MODE === 'list') {\n      btnGrid.style.background = '';\n      btnGrid.style.color = '';\n      btnList.style.background = '';\n      btnList.style.color = '';\n    } else {\n      btnGrid.style.background = '';\n      btnGrid.style.color = '';\n      btnList.style.background = '';\n      btnList.style.color = '';\n    }\n  }\n\n  if (items.length === 0) {\n    grid.innerHTML = `\n      <div class=\"empty-state\" style=\"grid-column: 1/-1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 48px 20px; text-align: center; border: 1px dashed var(--sand-deep); background: rgba(255,255,255,0.45); border-radius: 8px; margin: 10px 0;\">\n        <svg width=\"110\" height=\"85\" viewBox=\"0 0 120 90\" fill=\"none\" class=\"brand-doodle-svg\" style=\"opacity: 0.85; display: block; overflow: visible; margin: 0 auto 12px auto;\">\n          <!-- Ground wavy line -->\n          <path d=\"M10 80 C 40 81, 80 81.5, 110 82\" stroke=\"#5c5e5c\" stroke-width=\"0.95\" stroke-linecap=\"round\" />\n          \n          <!-- Hand-drawn Cottage -->\n          <path d=\"M35 50 L 52 32 L 69 50\" stroke=\"#4a4c4b\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" />\n          <path d=\"M36 49 L 52 33 L 68 49\" stroke=\"#4a4c4b\" stroke-width=\"0.8\" opacity=\"0.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" />\n          <path d=\"M38 50 V76 H66 V50\" stroke=\"#4a4c4b\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" fill=\"#FFFFFF\" />\n          <!-- Chimney -->\n          <path d=\"M61 38 V44\" stroke=\"#4a4c4b\" stroke-width=\"1.2\" />\n          \n          <!-- Cute sketched heart over chimney representing the home search -->\n          <path d=\"M60 29 C 58.5 25, 62.5 22, 64 25 C 65.5 22, 69.5 25, 68 29 C 66.5 32, 64 35, 64 35 C 64 35, 61.5 32, 60 29 Z\" stroke=\"var(--forest)\" stroke-width=\"1\" opacity=\"0.85\" stroke-linejoin=\"round\" />\n\n          <!-- Magnifying glass hand sketched overlay -->\n          <g transform=\"translate(68, 48)\">\n            <!-- Glass circle -->\n            <circle cx=\"12\" cy=\"12\" r=\"10\" stroke=\"#3a3d3c\" stroke-width=\"1.4\" fill=\"#FFFFFF\" />\n            <circle cx=\"12\" cy=\"12\" r=\"8\" stroke=\"#3a3d3c\" stroke-width=\"0.7\" opacity=\"0.5\" />\n            <!-- Reflection line -->\n            <path d=\"M 7,8 A 6,6 0 0,1 15,6\" stroke=\"#3a3d3c\" stroke-width=\"0.8\" stroke-linecap=\"round\" opacity=\"0.6\" />\n            <!-- Handle with overlapping sketchy details -->\n            <path d=\"M 19,19 L 29,29\" stroke=\"#3a3d3c\" stroke-width=\"2\" stroke-linecap=\"round\" />\n            <path d=\"M 19.5,19.5 L 28.5,28.5\" stroke=\"#717573\" stroke-width=\"0.8\" opacity=\"0.7\" />\n          </g>\n\n          <!-- Windows on Cottage -->\n          <rect x=\"44\" y=\"56\" width=\"7\" height=\"7\" rx=\"0.5\" stroke=\"#5c5e5c\" stroke-width=\"1\" />\n          <line x1=\"47.5\" y1=\"56\" x2=\"47.5\" y2=\"63\" stroke=\"#5c5e5c\" stroke-width=\"0.6\" />\n          <line x1=\"44\" y1=\"59.5\" x2=\"51\" y2=\"59.5\" stroke=\"#5c5e5c\" stroke-width=\"0.6\" />\n        </svg>\n        <h3 style=\"font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 14px; color: var(--ink); margin: 0 0 4px 0;\">Aucun bien ne correspond</h3>\n        <p style=\"font-size: 11px; color: var(--stone); margin: 0; max-width: 300px; line-height: 1.45;\">Aucun bien ne correspond à votre recherche. Essayez d'autres critères ou réinitialisez les filtres.</p>\n      </div>`;\n  } else {\n    grid.innerHTML = items.map(renderCard).join('');\n  }\n  document.getElementById('result-count').textContent = total;\n  document.getElementById('pagination-summary').textContent = `Page ${PAGE} / ${totalPages}`;\n\n  // Pagination buttons\n  const pag = document.getElementById('pagination');\n  const pages = [];\n  pages.push(`<button ${PAGE === 1 ? 'disabled' : ''} onclick=\"goTo(${PAGE-1})\">‹</button>`);\n  for (let i = 1; i <= totalPages; i++) {\n    if (i === 1 || i === totalPages || Math.abs(i - PAGE) <= 1) {\n      pages.push(`<button class=\"${i === PAGE ? 'active' : ''}\" onclick=\"goTo(${i})\">${i}</button>`);\n    } else if (Math.abs(i - PAGE) === 2) {\n      pages.push('<span class=\"pagination-info\">…</span>');\n    }\n  }\n  pages.push(`<button ${PAGE === totalPages ? 'disabled' : ''} onclick=\"goTo(${PAGE+1})\">›</button>`);\n  pag.innerHTML = pages.join('');\n\n  updateKpis();\n  setupCarousels();\n}\n\nfunction setupCarousels() {\n  document.querySelectorAll('.card-photo').forEach(container => {\n    const photos = (container.dataset.photos || '').split('|').filter(Boolean);\n    if (photos.length < 2) return;\n    const img  = container.querySelector('img');\n    const prev = container.querySelector('.photo-nav.prev');\n    const next = container.querySelector('.photo-nav.next');\n    const dotsWrap = container.querySelector('.photo-dots');\n    let cIdx = 0;\n    \n    function updateC() {\n      img.style.opacity = '0';\n      setTimeout(() => {\n        img.src = photos[cIdx];\n        img.style.opacity = '1';\n      }, 90);\n      if (dotsWrap) {\n        Array.from(dotsWrap.children).forEach((d, i) => d.classList.toggle('active', i === cIdx));\n      }\n    }\n    \n    prev?.addEventListener('click', e => {\n      e.stopPropagation();\n      cIdx = (cIdx - 1 + photos.length) % photos.length;\n      updateC();\n    });\n    next?.addEventListener('click', e => {\n      e.stopPropagation();\n      cIdx = (cIdx + 1) % photos.length;\n      updateC();\n    });\n  });\n}\n\nfunction goTo(p) { PAGE = p; render(); window.scrollTo({top:0,behavior:'smooth'}); }\n\nfunction updateKpis() {\n  loadPropsFromStore();\n  const avail = PROPS.filter(p => !p.reserved).length;\n  const fsbo = PROPS.filter(p => p.fsbo).length;\n  const score = Math.round(PROPS.reduce((s,p) => s + p.score, 0) / PROPS.length);\n  const fav = PROPS.filter(p => p.favorite).length;\n  document.getElementById('kpi-available').textContent = avail;\n  document.getElementById('kpi-fsbo').textContent = fsbo;\n  document.getElementById('kpi-score').textContent = score;\n  document.getElementById('kpi-fav').textContent = fav;\n}\n\nvar SELECTED_PROP_ID = null;\nvar CURRENT_FICHE_PHOTO_INDEX = 0;\n\n// Local average prices per m² for each city\nvar CITY_AVGS = {\n  'Lasne': 4200,\n  'Ixelles': 3900,\n  'Uccle': 3800,\n  'Waterloo': 3400,\n  'Bruxelles': 3100,\n  'Etterbeek': 3400,\n  'Schaerbeek': 2800,\n  'Saint-Gilles': 3300,\n  'Forest': 2900,\n  'Anderlecht': 2400,\n  'Woluwe-Saint-Pierre': 3800,\n  'Auderghem': 3300\n};\n\n// Collapsible collapsible micro-cards toggle handler\nwindow.toggleSection = function(el) {\n  const mc = el.closest('.mc');\n  if (mc) {\n    mc.classList.toggle('collapsed');\n  }\n};\n\nwindow.toggleScoreSection = function() {\n  const mc = document.getElementById('mc-score-card');\n  if (mc) {\n    mc.classList.toggle('collapsed-score');\n  }\n};\n\n// Update photo in the mini-fiche gallery\nwindow.selectFichePhoto = function(idx) {\n  const p = PROPS.find(item => item.id === SELECTED_PROP_ID);\n  if (!p) return;\n  \n  CURRENT_FICHE_PHOTO_INDEX = idx;\n  const mainImg = document.getElementById('fiche-main-img');\n  if (mainImg) {\n    mainImg.style.opacity = '0';\n    setTimeout(() => {\n      mainImg.src = p.photos[idx];\n      mainImg.style.opacity = '1';\n    }, 120);\n  }\n  \n  const counter = document.getElementById('fiche-gallery-counter');\n  if (counter) {\n    counter.textContent = `${idx + 1} / ${p.photos.length}`;\n  }\n  \n  document.querySelectorAll('.fiche-panel .thumb').forEach((thumb, i) => {\n    thumb.classList.toggle('active', i === idx);\n  });\n};\n\nwindow.changeFichePhoto = function(dir) {\n  const p = PROPS.find(item => item.id === SELECTED_PROP_ID);\n  if (!p) return;\n  \n  const nextIdx = (CURRENT_FICHE_PHOTO_INDEX + dir + p.photos.length) % p.photos.length;\n  window.selectFichePhoto(nextIdx);\n};\n\n// Lightbox logic\nwindow.openLightbox = function(index) {\n  const p = PROPS.find(item => item.id === SELECTED_PROP_ID);\n  if (!p) return;\n  \n  CURRENT_FICHE_PHOTO_INDEX = index;\n  const lb = document.getElementById('lightbox');\n  lb.classList.add('open');\n  \n  window.updateLightboxView(p);\n};\n\nwindow.closeLightbox = function() {\n  document.getElementById('lightbox').classList.remove('open');\n};\n\nwindow.navigateLightbox = function(dir) {\n  const p = PROPS.find(item => item.id === SELECTED_PROP_ID);\n  if (!p) return;\n  \n  CURRENT_FICHE_PHOTO_INDEX = (CURRENT_FICHE_PHOTO_INDEX + dir + p.photos.length) % p.photos.length;\n  window.updateLightboxView(p);\n};\n\nwindow.updateLightboxView = function(p) {\n  const img = document.getElementById('lightbox-img');\n  img.style.opacity = '0';\n  setTimeout(() => {\n    img.src = p.photos[CURRENT_FICHE_PHOTO_INDEX];\n    img.style.opacity = '1';\n  }, 100);\n  \n  document.getElementById('lightbox-counter').textContent = `${CURRENT_FICHE_PHOTO_INDEX + 1} / ${p.photos.length}`;\n  \n  const thumbsWrap = document.getElementById('lightbox-thumbs');\n  thumbsWrap.innerHTML = p.photos.map((url, i) => `\n    <div class=\"lb-thumb ${i === CURRENT_FICHE_PHOTO_INDEX ? 'active' : ''}\" onclick=\"window.selectLightboxThumb(${i})\">\n      <img src=\"${url}\" alt=\"\">\n    </div>\n  `).join('');\n};\n\nwindow.selectLightboxThumb = function(index) {\n  const p = PROPS.find(item => item.id === SELECTED_PROP_ID);\n  if (!p) return;\n  CURRENT_FICHE_PHOTO_INDEX = index;\n  window.updateLightboxView(p);\n};\n\n// Checkbox interactive triggers inside mini fiche\nwindow.toggleFicheCheck = function(el) {\n  el.classList.toggle('checked');\n  const checked = el.classList.contains('checked');\n  el.innerHTML = checked ? `\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"4\">\n      <polyline points=\"20 6 9 17 4 12\"/>\n    </svg>\n  ` : '<span>-</span>';\n  \n  const indicator = el.closest('.compliance-item').querySelector('.document-indicator');\n  if (indicator) {\n    indicator.textContent = checked ? 'En ordre' : 'Manquant';\n    indicator.className = `document-indicator ${checked ? 'ok' : 'pending'}`;\n  }\n};\n\n// Save notes input\nwindow.saveFicheNote = function() {\n  const input = document.getElementById('fiche-note-input');\n  if (!input) return;\n  const val = input.value.trim();\n  if (val) {\n    const store = window.ImmoPilotStore;\n    if (store && SELECTED_PROP_ID) {\n      store.registerNoteToProperty(SELECTED_PROP_ID, val);\n      alert(`Note enregistrée sur le bien : \"${val}\"`);\n    } else {\n      alert(`Note sauvegardée avec succès : \"${val}\"`);\n    }\n    input.value = '';\n    closeFiche();\n    render();\n  } else {\n    alert(\"Veuillez saisir une note avant d'enregistrer.\");\n  }\n};\n\nwindow.createPropDeal = function(id) {\n  const store = window.ImmoPilotStore;\n  if (!store) return;\n  const currentAgent = store.getCurrentAgent();\n  const p = store.getProperty(id);\n  if (!p) return;\n\n  if (p.reserved && p.ownerId !== currentAgent.id) {\n    const ownerName = store.getAgents().find(a => a.id === p.ownerId)?.name || 'Un autre conseiller';\n    if (confirm(`Ce bien est déjà réservé par ${ownerName}. Souhaitez-vous lui envoyer une demande de transfert pour négocier ce deal ?`)) {\n      window.initiateTransfer(id);\n    }\n    return;\n  }\n\n  try {\n    store.createDeal(id, 'c1', 'Nouveau'); // jean-marc default contact\n    alert(`Félicitations ! Le deal rattaché à \"${p.title}\" a été créé avec succès dans votre Pipeline.`);\n    window.location.hash = '#pipeline';\n  } catch (e) {\n    alert(e.message);\n  }\n};\n\nwindow.initiateTransfer = function(propertyId) {\n  const store = window.ImmoPilotStore;\n  if (!store) return;\n  const prop = store.getProperty(propertyId);\n  if (!prop) return;\n\n  let deal = store.getDeals().find(d => d.propertyId === propertyId);\n  let dealId = deal ? deal.id : 'deal-' + Date.now();\n\n  try {\n    store.createTransferRequest(propertyId, dealId, store.getCurrentAgent().id);\n    alert(`Demande de transfert initiée avec succès pour le bien \"${prop.title}\". Le responsable va être notifié.`);\n    closeFiche();\n    render();\n  } catch (e) {\n    alert(e.message);\n  }\n};\n\nwindow.togglePropFavorite = function(id) {\n  const store = window.ImmoPilotStore;\n  if (store) store.togglePropertyFavorite(id);\n  loadPropsFromStore();\n  const p = PROPS.find(item => item.id === id);\n  if (!p) return;\n  p.favorite = !p.favorite;\n  \n  // Find card button to update its class and SVG fill if visible\n  const cardBtn = document.querySelector(`#card-prop-${id} .fav-btn`);\n  if (cardBtn) {\n    cardBtn.classList.toggle('active', p.favorite);\n    const svg = cardBtn.querySelector('svg');\n    if (svg) {\n      svg.setAttribute('fill', p.favorite ? 'currentColor' : 'none');\n    }\n  }\n\n  // Also update the button inside the mini fiche if it's currently selected\n  const ficheFavBtn = document.getElementById('btn-fiche-fav');\n  if (ficheFavBtn && SELECTED_PROP_ID === id) {\n    ficheFavBtn.classList.toggle('active', p.favorite);\n    ficheFavBtn.innerHTML = p.favorite \n      ? `<svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"2\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"/></svg> Favoris` \n      : `<svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"/></svg> Favoris`;\n  }\n  \n  if (FILTER_FAV) {\n    render();\n  } else {\n    updateKpis();\n  }\n};\n\nwindow.ignoreProp = function(id) {\n  if (confirm(\"Voulez-vous ignorer cette annonce ? Elle sera masquée de vos résultats de recherche.\")) {\n    const p = PROPS.find(item => item.id === id);\n    if (p) p.ignored = true;\n    closeFiche();\n    render();\n  }\n};\n\nfunction openFiche(id) {\n  if (!id) {\n    const all = filteredProps();\n    if (all.length > 0) {\n      id = all[0].id;\n    } else {\n      return;\n    }\n  }\n\n  SELECTED_PROP_ID = id;\n  CURRENT_FICHE_PHOTO_INDEX = 0;\n  const p = PROPS.find(item => item.id === id);\n  if (!p) return;\n\n  // Add active selection highlights on cards\n  document.querySelectorAll('.card').forEach(c => c.classList.remove('active-selection'));\n  const activeCard = document.getElementById('card-prop-' + id);\n  if (activeCard) {\n    activeCard.classList.add('active-selection');\n  }\n  \n  const app = document.getElementById('app');\n  app.classList.add('with-fiche');\n  document.getElementById('toggle-label').textContent = 'Fermer mini fiche';\n\n  const panel = document.getElementById('fiche-panel');\n  if (!panel) return;\n  panel.className = 'fiche-panel standard-da';\n\n  // Compute market comparative stats\n  const cityAvg = CITY_AVGS[p.city] || 3200;\n  const propPpm = Math.round(p.price / p.surface);\n  const deltaPercent = Math.round(((propPpm - cityAvg) / cityAvg) * 100);\n  \n  let barPercent = 50 + (deltaPercent * 2.5); // 0% delta -> 50% slider track position\n  barPercent = Math.max(5, Math.min(95, barPercent));\n\n  // Derivation of specific characteristics details requested by the user\n  const propTitle = p.title || '';\n  let propType = \"Maison\";\n  if (propTitle.includes(\"Villa\")) propType = \"Villa\";\n  else if (propTitle.includes(\"Appartement\")) propType = \"Appartement\";\n  else if (propTitle.includes(\"Penthouse\")) propType = \"Penthouse\";\n  else if (propTitle.includes(\"Triplex\")) propType = \"Triplex\";\n  else if (propTitle.includes(\"Loft\")) propType = \"Loft\";\n  else if (propTitle.includes(\"Duplex\")) propType = \"Duplex\";\n  else if (propTitle.includes(\"Studio\")) propType = \"Studio\";\n\n  const hasTerrain = (propType === \"Villa\" || propType === \"Maison\" || propTitle.toLowerCase().includes(\"maison\") || propTitle.toLowerCase().includes(\"villa\"));\n  const terrainVal = hasTerrain ? (450 + (p.id * 83) % 1100) : null;\n  const propTerrain = terrainVal ? terrainVal.toLocaleString('fr-BE') + \" m²\" : \"Non applicable\";\n\n  const propGarages = (p.id % 3 === 0) ? \"0\" : (p.id % 3 === 1) ? \"1\" : \"2\";\n  const propYear = 1970 + (p.id * 11) % 55;\n  const pebKwh = 45 + (p.id * 19) % 250;\n  const propPebLabel = `${p.peb} (${pebKwh} kWh/m².an)`;\n  const propHeating = ['Pompe à chaleur', 'Gaz (condensation)', 'Mazout (basse temp.)', 'Électrique (accumulateur)'][p.id % 4];\n  const propAvailability = p.id % 2 === 0 ? \"À l'acte\" : \"Libre immédiatement\";\n\n  // Build price history rows\n  let priceHistoryHtml = '';\n  if (p.tag === 'Baisse de prix' || p.tag === 'Baisse' || p.tag.includes('Baisse')) {\n    const oldPrice = Math.round(p.price * 1.05 / 1000) * 1000;\n    priceHistoryHtml = `\n      <div class=\"ph-row\">\n        <span class=\"ph-dot\" style=\"background:#A04A2E;\"></span>\n        <span class=\"ph-date\">Aujourd'hui</span>\n        <span class=\"ph-prices\"><strong>${fmtPrice(p.price)}</strong></span>\n        <span class=\"ph-tag baisse\">-${Math.round((oldPrice - p.price)/oldPrice*100)}% baisse</span>\n      </div>\n      <div class=\"ph-row\">\n        <span class=\"ph-dot publish\" style=\"background:#8E8B83;\"></span>\n        <span class=\"ph-date\">Il y a 30 j</span>\n        <span class=\"ph-prices\"><span class=\"old\">${fmtPrice(oldPrice)}</span></span>\n        <span class=\"ph-tag publish\">Mise en vente</span>\n      </div>\n    `;\n  } else {\n    priceHistoryHtml = `\n      <div class=\"ph-row\">\n        <span class=\"ph-dot\" style=\"background:#1E5A3A;\"></span>\n        <span class=\"ph-date\">Aujourd'hui</span>\n        <span class=\"ph-prices\"><strong>${fmtPrice(p.price)}</strong></span>\n        <span class=\"ph-tag\" style=\"background:#CFE1D2; color:#1E5A3A; font-weight:700;\">Stable</span>\n      </div>\n      <div class=\"ph-row\">\n        <span class=\"ph-dot publish\" style=\"background:#8E8B83;\"></span>\n        <span class=\"ph-date\">Il y a ${p.publishedDays + 4} j</span>\n        <span class=\"ph-prices\"><strong>${fmtPrice(p.price)}</strong></span>\n        <span class=\"ph-tag publish\">Mise en ligne</span>\n      </div>\n    `;\n  }\n\n  // Choose vendor agent profile\n  let vendorName = \"Jean-François Immo\";\n  let vendorType = \"Agence Partenaire\";\n  let vendorPhone = \"+32 2 345 67 89\";\n  let vendorEmail = \"contact@partnerimmo.be\";\n  let vendorInitials = \"JF\";\n\n  if (p.source === 'Propriétaire' || p.fsbo) {\n    vendorName = \"Mme Sophie Dumont\";\n    vendorType = \"Particulier (FSBO)\";\n    vendorPhone = \"+32 475 88 99 11\";\n    vendorEmail = \"s.dumont@privatelease.be\";\n    vendorInitials = \"SD\";\n  } else if (p.source === 'Zimmo') {\n    vendorName = \"Cabinet Waterloo & Partners\";\n    vendorType = \"Courtier Immobiliers\";\n    vendorPhone = \"+32 2 640 12 34\";\n    vendorEmail = \"waterloo@partners.be\";\n    vendorInitials = \"WP\";\n  } else if (p.source === 'Biddit') {\n    vendorName = \"Étude Notariale de Groote\";\n    vendorType = \"Vente Publique Notaire\";\n    vendorPhone = \"+32 2 511 22 33\";\n    vendorEmail = \"info@notairedegroote.be\";\n    vendorInitials = \"NG\";\n  }\n\n  // Interactive checklists\n  const checklist = [\n    { name: \"Certificat PEB officiel conforme\", state: p.peb !== 'D' ? \"ok\" : \"pending\", statusLabel: p.peb !== 'D' ? \"En ordre\" : \"En cours\" },\n    { name: \"Attestation électrique réglementaire\", state: p.score > 75 ? \"ok\" : \"pending\", statusLabel: p.score > 75 ? \"Analysée\" : \"À négocier\" },\n    { name: \"Relevé cadastral & urbanisme\", state: \"ok\", statusLabel: \"Reçu\" }\n  ];\n\n  panel.innerHTML = `\n    <!-- 1. HEADER MODULE -->\n    <div class=\"fiche-head\">\n      <div class=\"fiche-head-top\">\n        <h2 class=\"fiche-title\">${p.title}</h2>\n        <button class=\"fiche-close\" onclick=\"closeFiche()\" aria-label=\"Fermer la fiche\">\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"/>\n            <line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"/>\n          </svg>\n        </button>\n      </div>\n      <div class=\"fiche-loc-row\">\n        <span class=\"fiche-loc\">${p.city} • Publié il y a ${p.publishedDays} j</span>\n        <div class=\"price-block\">\n          <span class=\"fiche-price\">${fmtPrice(p.price)}</span>\n          <div class=\"price-marker\">\n            <span class=\"${deltaPercent < 0 ? 'delta-down' : 'delta-up'}\">${deltaPercent >= 0 ? '+' : ''}${deltaPercent}%</span>\n            vs moyenne locale\n          </div>\n        </div>\n      </div>\n      <span class=\"fiche-status ${p.reserved ? 'old' : 'fresh'}\">${p.reserved ? 'Réservé' : 'Disponible'}</span>\n    </div>\n\n    <!-- 2. GALLERY MODULE -->\n    <div class=\"gallery-wrapper\">\n      <div class=\"gallery-main\" onclick=\"window.openLightbox(CURRENT_FICHE_PHOTO_INDEX)\">\n        <img src=\"${p.photos[0]}\" id=\"fiche-main-img\" alt=\"${p.title}\">\n        <span class=\"gallery-counter\" id=\"fiche-gallery-counter\">1 / ${p.photos.length}</span>\n        <button class=\"gallery-nav prev\" onclick=\"event.stopPropagation(); window.changeFichePhoto(-1)\">\n          <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><polyline points=\"15 18 9 12 15 6\"></polyline></svg>\n        </button>\n        <button class=\"gallery-nav next\" onclick=\"event.stopPropagation(); window.changeFichePhoto(1)\">\n          <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><polyline points=\"9 18 15 12 9 6\"></polyline></svg>\n        </button>\n      </div>\n      <div class=\"gallery-thumbs\">\n        ${p.photos.map((url, i) => `\n          <div class=\"thumb ${i === 0 ? 'active' : ''}\" onclick=\"window.selectFichePhoto(${i})\">\n            <img src=\"${url}\" alt=\"\">\n          </div>\n        `).join('')}\n      </div>\n    </div>\n\n    <!-- BODY -->\n    <div class=\"fiche-body\">\n      <!-- 3. SCORE ANALYTIQUE MODULE -->\n      <div class=\"mc\">\n        <div class=\"mc-label\">Double Gribouillis Score IA &amp; Confiance</div>\n        <div class=\"mc-score-row\">\n          <div class=\"score-donut\" style=\"--target-score: ${p.score}; width: 80px; height: 80px;\">\n            <div class=\"score-donut-val\">\n              <strong><span>${p.score}</span></strong>\n            </div>\n          </div>\n          <div class=\"score-summary\">\n            <span class=\"score-summary-label\">\n              <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path></svg>\n              Rapport d'analyse IA\n            </span>\n            <p style=\"margin:0; font-size:11px; color:var(--stone); line-height:1.4;\">\n              Cette propriété à <strong>${p.city}</strong> présente une valorisation très cohérente de <strong>${fmtPrice(propPpm)}/m²</strong> contre une moyenne de <strong>${fmtPrice(cityAvg)}/m²</strong>.\n            </p>\n          </div>\n        </div>\n        <div class=\"score-badges\">\n          <span class=\"badge-ia\">PEB : ${p.peb}</span>\n          <span class=\"badge-ia\">Rapport Qualité/Prix optimal</span>\n          <span class=\"badge-ia\">Analyse certifiée</span>\n        </div>\n        <div class=\"score-alerts\">\n          <div class=\"alert-chip\">\n            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"></line><line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"></line></svg>\n            Audit PEB valide • Précision de la valorisation de marché de zone à 98%\n          </div>\n        </div>\n      </div>\n\n      <!-- 4. CARACTÉRISTIQUES -->\n      <div class=\"mc\">\n        <div class=\"mc-label\">CARACTÉRISTIQUES</div>\n        <div class=\"mc-content\">\n          <div class=\"char-list\">\n            <div class=\"char-row\">\n              <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"></path><polyline points=\"9 22 9 12 15 12 15 22\"></polyline></svg>\n              <span class=\"k\">Type</span><span class=\"v\">${propType}</span>\n            </div>\n            <div class=\"char-row\">\n              <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"1\"></rect></svg>\n              <span class=\"k\">Surface habitable</span><span class=\"v\">${p.surface} m²</span>\n            </div>\n            <div class=\"char-row\">\n              <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle></svg>\n              <span class=\"k\">Terrain</span><span class=\"v\">${propTerrain}</span>\n            </div>\n            <div class=\"char-row\">\n              <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M2 8v12M22 12v8M2 12h20M5 12V8h14v4\"></path></svg>\n              <span class=\"k\">Chambres</span><span class=\"v\">${p.bedrooms}</span>\n            </div>\n            <div class=\"char-row\">\n              <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M9 6V4a2 2 0 0 1 4 0v2M3 11h18M5 11v7a3 3 0 0 0 3 3h8a3 3 0 0 0 3-3v-7\"></path></svg>\n              <span class=\"k\">Salles de bain</span><span class=\"v\">${p.bathrooms}</span>\n            </div>\n            <div class=\"char-row\">\n              <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\" ry=\"2\"></rect><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"></path></svg>\n              <span class=\"k\">Garages</span><span class=\"v\">${propGarages}</span>\n            </div>\n            <div class=\"char-row\">\n              <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"></rect><line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"></line><line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"></line><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"></line></svg>\n              <span class=\"k\">Année de construction</span><span class=\"v\">${propYear}</span>\n            </div>\n            <div class=\"char-row\">\n              <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z\"></path></svg>\n              <span class=\"k\">PEB</span><span class=\"v\"><span class=\"peb-mini ${p.peb.toLowerCase()}\">${p.peb}</span> <span class=\"peb-detail\">${propPebLabel}</span></span>\n            </div>\n            <div class=\"char-row\">\n              <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"4\"></circle></svg>\n              <span class=\"k\">Chauffage</span><span class=\"v\">${propHeating}</span>\n            </div>\n            <div class=\"char-row\">\n              <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"></path></svg>\n              <span class=\"k\">Disponibilité</span><span class=\"v\">${propAvailability}</span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- 5. LOCAL MARKET COMPARISON -->\n      <div class=\"mc\">\n        <div class=\"mc-label\">SITUATION PAR RAPPORT AU MARCHÉ LOCAL</div>\n        <div class=\"market-mc-grid\">\n          <div class=\"market-cell\">\n            <span class=\"market-k\">Prix moyen de la commune</span>\n            <span class=\"market-v\">${fmtPrice(cityAvg)} / m²</span>\n          </div>\n          <div class=\"market-cell\">\n            <span class=\"market-k\">Prix au m² de ce bien</span>\n            <div class=\"market-v-row\">\n              <span class=\"market-v\">${fmtPrice(propPpm)}</span>\n              <span class=\"market-delta ${deltaPercent < 0 ? 'down' : 'up'}\">${deltaPercent >= 0 ? '+' : ''}${deltaPercent}%</span>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"market-bar\">\n          <div class=\"market-bar-head\">\n            <span class=\"left\">Baromètre des prix communaux</span>\n            <span class=\"delta ${deltaPercent < 0 ? 'below' : ''}\">${deltaPercent < 0 ? 'Sous le marché' : 'Premium de zone'}</span>\n          </div>\n          <div class=\"market-bar-track\">\n            <div class=\"market-bar-marker\" style=\"left: ${barPercent}%;\"></div>\n          </div>\n          <div class=\"market-bar-scale\">\n            <span>Marché décoté</span>\n            <span>Équilibre</span>\n            <span>Marché surévalué</span>\n          </div>\n        </div>\n\n        <div class=\"map-address\">\n          <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path><circle cx=\"12\" cy=\"10\" r=\"3\"></circle></svg>\n          Géoréférencement : ${p.city} centre zone d'évaluation locale\n        </div>\n\n        <div class=\"map-wrap\" id=\"fiche-map-wrap\" style=\"height: 150px; position: relative;\">\n          <div style=\"display:flex; align-items:center; justify-content:center; height:100%; background:#FAF7F2; font-family:monospace; font-size:11px; color:#5C5A53;\">\n            Initialisation de la carte...\n          </div>\n        </div>\n      </div>\n\n      <!-- 6. HISTORIQUE DE PRIX MODULE -->\n      <div class=\"mc\">\n        <div class=\"mc-label\">HISTORIQUE DES VARIATIONS DE PRIX</div>\n        <div class=\"price-history\">\n          <div class=\"price-history-sub\">ÉVOLUTION DE L'OFFRE PUBLICITAIRE</div>\n          ${priceHistoryHtml}\n        </div>\n      </div>\n\n      <!-- 7. SOURCE RETRACTABLE -->\n      <div class=\"mc retractable\">\n        <div class=\"mc-label\" onclick=\"window.toggleSection(this)\" style=\"cursor:pointer; display:flex; justify-content:space-between; align-items:center;\">\n          <span>Source</span>\n        </div>\n        <div class=\"mc-content\" style=\"display:none; margin-top:8px;\">\n          <div class=\"source-card\">\n            <span class=\"source-link\">\n              <span class=\"source-dot\" style=\"background: ${p.source === 'Immoweb' ? '#E66B1C' : p.source === 'Immovlan' ? '#7C3AED' : p.source === 'Biddit' ? '#CE3333' : '#1E5A3A'};\"></span>\n              ${p.source}\n            </span>\n            <div class=\"source-rows\">\n              <div class=\"source-row-line\">\n                <span class=\"source-k\">Référence :</span>\n                <span class=\"source-v\">${p.source.substring(0,3).toUpperCase()}-${Math.floor(10000000 + Math.random() * 90000000)}</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- 8. VENDEUR / MANDATAIRE -->\n      <div class=\"mc\">\n        <div class=\"mc-label\">CONSEILLER RESPONSABLE DU MANDAT</div>\n        <div class=\"vendor-card\">\n          <div class=\"vendor-info\">\n            <div class=\"vendor-name\">${vendorName}</div>\n            <div class=\"vendor-type\">${vendorType}</div>\n            <div class=\"vendor-contact\">\n              <span>${vendorPhone} • ${vendorEmail}</span>\n            </div>\n          </div>\n          <div class=\"vendor-avatar\">${vendorInitials}</div>\n        </div>\n      </div>\n\n      <!-- 9. BUTTONS ACCORDING TO USER SPECIFICATION -->\n      <div class=\"fiche-actions\">\n        <button class=\"btn btn-primary\" onclick=\"window.createPropDeal(${p.id})\">Créer un deal</button>\n        <button class=\"btn btn-secondary ${p.favorite ? 'active' : ''}\" id=\"btn-fiche-fav\" onclick=\"window.togglePropFavorite(${p.id})\">\n          <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"${p.favorite ? 'currentColor' : 'none'}\" stroke=\"currentColor\" stroke-width=\"2\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"/></svg>\n          Favoris\n        </button>\n        <button class=\"btn btn-secondary\" onclick=\"window.ignoreProp(${p.id})\">Ignorer</button>\n        <button class=\"btn btn-secondary\" onclick=\"window.openGrandeFiche(${p.id})\">Voir plus</button>\n      </div>\n\n      <!-- 10. INTERNAL PRIVATE NOTE -->\n      <div class=\"note-row\">\n        <input type=\"text\" class=\"note-input\" id=\"fiche-note-input\" placeholder=\"Ajouter une note de visite interne…\" value=\"${p.note || ''}\">\n        <button class=\"note-save\" onclick=\"window.saveFicheNote()\">\n          <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z\"></path></svg>\n        </button>\n      </div>\n    </div>\n  `;\n\n  if (window.renderInteractiveMap) {\n    window.renderInteractiveMap('fiche-map-wrap', p.city, p.title || '');\n  }\n}\n\nfunction closeFiche() {\n  document.getElementById('app').classList.remove('with-fiche');\n  document.getElementById('toggle-label').textContent = 'Ouvrir mini fiche';\n  SELECTED_PROP_ID = null;\n  document.querySelectorAll('.card').forEach(c => c.classList.remove('active-selection'));\n}\n\nfunction toggleFiche() {\n  const app = document.getElementById('app');\n  app.classList.toggle('with-fiche');\n  const isOpened = app.classList.contains('with-fiche');\n  document.getElementById('toggle-label').textContent = isOpened ? 'Fermer mini fiche' : 'Ouvrir mini fiche';\n  \n  if (isOpened && SELECTED_PROP_ID === null) {\n    openFiche();\n  }\n}\n\ndocument.getElementById('search').addEventListener('input', e => { SEARCH = e.target.value; PAGE = 1; render(); });\ndocument.getElementById('sort').addEventListener('change', e => { SORT = e.target.value; PAGE = 1; render(); });\n\n// Advanced local filters listeners\nvar filterCityEl = document.getElementById('filter-city');\nvar filterSourceEl = document.getElementById('filter-source');\nvar filterTagEl = document.getElementById('filter-tag');\nvar filterFavBtnEl = document.getElementById('filter-fav-btn');\nvar filterResetEl = document.getElementById('filter-reset');\n\nif (filterCityEl) {\n  filterCityEl.addEventListener('change', e => {\n    FILTER_CITY = e.target.value;\n    PAGE = 1;\n    render();\n  });\n}\nif (filterSourceEl) {\n  filterSourceEl.addEventListener('change', e => {\n    FILTER_SOURCE = e.target.value;\n    PAGE = 1;\n    render();\n  });\n}\nif (filterTagEl) {\n  filterTagEl.addEventListener('change', e => {\n    FILTER_TAG = e.target.value;\n    PAGE = 1;\n    render();\n  });\n}\nif (filterFavBtnEl) {\n  filterFavBtnEl.addEventListener('click', () => {\n    FILTER_FAV = !FILTER_FAV;\n    filterFavBtnEl.classList.toggle('active', FILTER_FAV);\n    \n    // Aesthetic hand-sketch active styles\n    filterFavBtnEl.style.background = FILTER_FAV ? 'var(--forest-soft)' : 'white';\n    filterFavBtnEl.style.color = FILTER_FAV ? 'var(--forest)' : 'var(--stone)';\n    filterFavBtnEl.style.borderColor = FILTER_FAV ? 'var(--forest)' : 'var(--stone)';\n    \n    const svgEl = filterFavBtnEl.querySelector('svg');\n    if (svgEl) {\n      svgEl.setAttribute('fill', FILTER_FAV ? 'currentColor' : 'none');\n    }\n    PAGE = 1;\n    render();\n  });\n}\nif (filterResetEl) {\n  filterResetEl.addEventListener('click', () => {\n    FILTER_CITY = '';\n    FILTER_SOURCE = '';\n    FILTER_TAG = '';\n    FILTER_FAV = false;\n    SEARCH = '';\n    \n    if (filterCityEl) filterCityEl.value = '';\n    if (filterSourceEl) filterSourceEl.value = '';\n    if (filterTagEl) filterTagEl.value = '';\n    document.getElementById('search').value = '';\n    \n    if (filterFavBtnEl) {\n      filterFavBtnEl.classList.remove('active');\n      filterFavBtnEl.style.background = 'white';\n      filterFavBtnEl.style.color = 'var(--stone)';\n      filterFavBtnEl.style.borderColor = 'var(--stone)';\n      const svgEl = filterFavBtnEl.querySelector('svg');\n      if (svgEl) {\n        svgEl.setAttribute('fill', 'none');\n      }\n    }\n    \n    PAGE = 1;\n    render();\n  });\n}\n\nvar ACTIVE_GF_PHOTO_INDEX = 0;\nvar ACTIVE_GF_ID = null;\n\n// Initialize persistent note records\nPROPS.forEach(p => {\n  const savedNotes = localStorage.getItem(`immo_notes_prop_${p.id}`);\n  p.notes = savedNotes ? JSON.parse(savedNotes) : [];\n  \n  const savedDocs = localStorage.getItem(`immo_docs_prop_${p.id}`);\n  p.checkedDocs = savedDocs ? JSON.parse(savedDocs) : [true, p.score > 75, true, false, false];\n});\n\nwindow.openGrandeFiche = function(id) {\n  ACTIVE_GF_ID = id;\n  ACTIVE_GF_PHOTO_INDEX = 0;\n  \n  const p = PROPS.find(item => item.id === id);\n  if (!p) {\n    alert(\"Impossible de charger la fiche détaillée.\");\n    return;\n  }\n  \n  // Format variables\n  const fmtPriceLoc = (val) => new Intl.NumberFormat('fr-BE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(val);\n  const propPpm = Math.round(p.price / p.surface);\n  const cityAvg = p.city === 'Bruxelles' ? 3650 : p.city === 'Ixelles' ? 4400 : p.city === 'Uccle' ? 4200 : p.city === 'Waterloo' ? 3100 : p.city === 'Antwerpen' ? 2950 : 2550;\n  const deltaPercent = Math.round(((propPpm - cityAvg) / cityAvg) * 100);\n  \n  // Calculate specific property metadata derived from ID or static generators\n  const propType = p.surface > 130 ? 'Maison Bel-Étage' : 'Appartement Moderne';\n  const propYear = 1960 + (p.id * 7) % 62;\n  const propHeating = p.id % 2 === 0 ? 'Gaz condensation (Junkers)' : 'Pompe à chaleur air-eau / Sol';\n  const propGarages = p.id % 3 === 0 ? '2 emplacements fermés' : p.id % 2 === 0 ? '1 box fermé' : 'Stationnement extérieur';\n  \n  // Choose vendor agent profile\n  let vendorName = \"Jean-François Immo\";\n  let vendorType = \"Agence Partenaire\";\n  let vendorPhone = \"+32 2 345 67 89\";\n  let vendorEmail = \"contact@partnerimmo.be\";\n  let vendorInitials = \"JF\";\n  if (p.source === 'Propriétaire' || p.fsbo) {\n    vendorName = \"Mme Sophie Dumont\";\n    vendorType = \"Particulier (FSBO)\";\n    vendorPhone = \"+32 475 88 99 11\";\n    vendorEmail = \"s.dumont@privatelease.be\";\n    vendorInitials = \"SD\";\n  } else if (p.source === 'Zimmo') {\n    vendorName = \"Cabinet Waterloo & Partners\";\n    vendorType = \"Courtier Immobiliers\";\n    vendorPhone = \"+32 2 640 12 34\";\n    vendorEmail = \"waterloo@partners.be\";\n    vendorInitials = \"WP\";\n  } else if (p.source === 'Biddit') {\n    vendorName = \"Étude Notariale de Groote\";\n    vendorType = \"Vente Publique Notaire\";\n    vendorPhone = \"+32 2 511 22 33\";\n    vendorEmail = \"info@notairedegroote.be\";\n    vendorInitials = \"NG\";\n  }\n\n  // Draw the dynamic content\n  const modalWrapper = document.getElementById('grande-fiche-content-wrapper');\n  \n  // Document checklists (state is held in p.checkedDocs)\n  const dtDocs = [\n    { name: \"Certificat de conformité PEB\", desc: \"Diagnostic obligatoire requis de performance énergétique pour la signature.\" },\n    { name: \"Attestation électrique réglementaire\", desc: `Rapport officiel de test de l'installation (score IA : ${p.score}/100).` },\n    { name: \"Rapport de pollution du sol (BDES)\", desc: \"Relevé officiel obligatoire délivré par le cadastre régional des sols.\" },\n    { name: \"Plan d'urbanisme & cadastral certifié\", desc: \"Dossier d'urbanisme de la commune validant la constructibilité.\" },\n    { name: \"Dossier de copropriété & décompte charges\", desc: \"Procès-verbaux des assemblées générales et carnet de maintenance.\" }\n  ];\n\n  // Notes log builder html helper\n  const getNotesHtml = () => {\n    if (!p.notes || p.notes.length === 0) {\n      return `<div style=\"text-align:center; color:#8E8B83; font-size:11px; padding:12px; font-family:'JetBrains Mono',monospace;\">Aucun rapport technique enregistré.</div>`;\n    }\n    return p.notes.map((n, idx) => `\n      <div style=\"background:#FFFFFF; border:1px solid #EDE8DD; border-radius:4px; padding:8px 10px; font-size:12px; line-height:1.4; position:relative; margin-bottom:6px;\">\n        <span style=\"font-family:'JetBrains Mono',monospace; font-size:9px; color:#8E8B83; display:block; margin-bottom:2px;\">${n.date}</span>\n        <div>${n.text}</div>\n        <button class=\"delete-note\" onclick=\"window.deleteGrandeFicheNote(${idx})\" style=\"position:absolute; top:6px; right:6px; background:none; border:none; color:#8E8B83; cursor:pointer; font-size:13px; font-weight:700;\">&times;</button>\n      </div>\n    `).join('');\n  };\n\n  modalWrapper.innerHTML = `\n  <section class=\"fiche\">\n    <button class=\"fiche-close-top\" on