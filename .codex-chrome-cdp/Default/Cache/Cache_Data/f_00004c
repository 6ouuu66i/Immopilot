=\"round\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"></rect><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"></rect><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"></rect><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"></rect></svg>\n            +${p.photos.length}\n          </button>\n        </div>\n      </div>\n      <aside class=\"hero-side\">\n        <div style=\"display:flex;align-items:baseline;justify-content:space-between;gap:14px;width:100%;\">\n          <div class=\"hero-side-title\">${p.title}</div>\n          <div style=\"font-size:26px;font-weight:700;color:#1D1F1E;letter-spacing:-0.01em;\">${fmtPriceLoc(p.price)}</div>\n        </div>\n        <div class=\"hero-side-signals\">\n          <span class=\"signal-chip fresh\">Publié il y a ${p.publishedDays} j</span>\n          <span class=\"signal-chip fsbo\">${p.tag || p.source}</span>\n          <span class=\"signal-chip baisse\">${deltaPercent}% vs locale</span>\n        </div>\n        <div class=\"hero-side-loc\">\n          <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M12 2a8 8 0 0 0-8 8c0 5.5 8 12 8 12s8-6.5 8-12a8 8 0 0 0-8-8z\"></path><circle cx=\"12\" cy=\"10\" r=\"2.5\" fill=\"#FFFFFF\" stroke=\"none\"></circle></svg>\n          ${p.city} · Brabant wallon\n        </div>\n        <div class=\"mc retractable\" style=\"width:100%;margin-top:6px;\">\n          <div class=\"mc-label\" style=\"font-family:'JetBrains Mono',monospace;font-size:10px;text-transform:uppercase;letter-spacing:0.08em;color:#8E8B83;font-weight:500;cursor:pointer;user-select:none;\">Caractéristiques</div>\n          <div class=\"mc-content\">\n            <div style=\"display:flex;flex-direction:column;font-size:12.5px;\">\n              <div style=\"display:grid;grid-template-columns:18px 1fr auto;gap:10px;align-items:center;padding:6px 0;\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><path d=\"M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"></path></svg><span style=\"color:#6B6F6D\">Type</span><span style=\"color:#1D1F1E;font-weight:600;text-align:right\">${propType}</span></div>\n              <div style=\"display:grid;grid-template-columns:18px 1fr auto;gap:10px;align-items:center;padding:6px 0;\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"1\"></rect></svg><span style=\"color:#6B6F6D\">Surface habitable</span><span style=\"color:#1D1F1E;font-weight:600;text-align:right\">${p.surface} m²</span></div>\n              <div style=\"display:grid;grid-template-columns:18px 1fr auto;gap:10px;align-items:center;padding:6px 0;\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><path d=\"M2 20h20M4 20V8l8-5 8 5v12\"></path></svg><span style=\"color:#6B6F6D\">Terrain</span><span style=\"color:#1D1F1E;font-weight:600;text-align:right\">${(p.surface * 5).toLocaleString('fr-BE')} m²</span></div>\n              <div style=\"display:grid;grid-template-columns:18px 1fr auto;gap:10px;align-items:center;padding:6px 0;\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><path d=\"M3 11V5h18v6M3 18v3M21 18v3M3 14h18M5 14v4M19 14v4\"></path></svg><span style=\"color:#6B6F6D\">Chambres</span><span style=\"color:#1D1F1E;font-weight:600;text-align:right\">${p.bedrooms}</span></div>\n              <div style=\"display:grid;grid-template-columns:18px 1fr auto;gap:10px;align-items:center;padding:6px 0;\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><path d=\"M9 6V4a2 2 0 0 1 4 0v2M3 11h18M5 11v7a3 3 0 0 0 3 3h8a3 3 0 0 0 3-3v-7\"></path></svg><span style=\"color:#6B6F6D\">Salles de bain</span><span style=\"color:#1D1F1E;font-weight:600;text-align:right\">${p.bathrooms}</span></div>\n              <div style=\"display:grid;grid-template-columns:18px 1fr auto;gap:10px;align-items:center;padding:6px 0;\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><rect x=\"2\" y=\"9\" width=\"20\" height=\"11\" rx=\"1\"></rect><circle cx=\"7\" cy=\"14\" r=\"1\"></circle><circle cx=\"17\" cy=\"14\" r=\"1\"></circle></svg><span style=\"color:#6B6F6D\">Garages</span><span style=\"color:#1D1F1E;font-weight:600;text-align:right\">${p.id % 2 === 0 ? '1 box fermé' : 'Stationnement extérieur'}</span></div>\n              <div style=\"display:grid;grid-template-columns:18px 1fr auto;gap:10px;align-items:center;padding:6px 0;\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\"></rect><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"></line></svg><span style=\"color:#6B6F6D\">Année de construction</span><span style=\"color:#1D1F1E;font-weight:600;text-align:right\">${propYear}</span></div>\n              <div style=\"display:grid;grid-template-columns:18px 1fr auto;gap:10px;align-items:center;padding:6px 0;\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 6v6l4 2\"></path></svg><span style=\"color:#6B6F6D\">PEB</span><span style=\"text-align:right\"><span style=\"display:inline-flex;align-items:center;justify-content:center;min-width:22px;padding:2px 6px;border-radius:4px;font-size:10px;font-weight:700;color:#FFFFFF;background:${p.peb === 'A' ? '#1E5A3A' : p.peb === 'B' ? '#3D7A52' : p.peb === 'C' ? '#C8893B' : '#A04A2E'};margin-right:6px;\">${p.peb}</span><span style=\"color:#8E8B83;font-weight:500;font-size:11.5px;\">(56 kWh/m².an)</span></span></div>\n              <div style=\"displ